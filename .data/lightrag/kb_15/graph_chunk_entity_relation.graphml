<graph edgedefault="undirected"><node id="Rủi ro chấp nhận được">
  <data key="d0">Rủi ro chấp nhận được</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rủi ro chấp nhận được là mức rủi ro từ 1% đến 10% giá trị rủi ro tối đa.</data>
  <data key="d3">chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
