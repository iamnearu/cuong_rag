</node>
<node id="Rủi ro có thể chấp nhận được">
  <data key="d0">Rủi ro có thể chấp nhận được</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rủi ro có thể chấp nhận được là mức rủi ro từ 10% đến 30% giá trị rủi ro tối đa.</data>
  <data key="d3">chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Rủi ro không thể chấp nhận được">
  <data key="d0">Rủi ro không thể chấp nhận được</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rủi ro không thể chấp nhận được là mức rủi ro trên 30% giá trị rủi ro tối đa.</data>
  <data key="d3">chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Mức Độ Nghiêm Trọng Rủi Ro">
  <data key="d0">Mức Độ Nghiêm Trọng Rủi Ro</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Mức Độ Nghiêm Trọng Rủi Ro là thang đo từ 1 đến 10, biểu thị mức độ nghiêm trọng của rủi ro trong bảng.</data>
  <data key="d3">chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Chỉ Số Xuất Hiện">
  <data key="d0">Chỉ Số Xuất Hiện</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chỉ Số Xuất Hiện là thang đo từ 1 đến 10, biểu thị tần suất xảy ra rủi ro trong bảng.</data>
  <data key="d3">chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="100 mức giá trị rủi ro khác nhau">
  <data key="d0">100 mức giá trị rủi ro khác nhau</data>
  <data key="d1">financial_metric</data>
  <data key="d2">100 mức giá trị rủi ro khác nhau là giá trị tối đa trong bảng, tương ứng với Mức Độ Nghiêm Trọng Rủi Ro 10 và Chỉ Số Xuất Hiện 10.</data>
  <data key="d3">chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="SpeedMaint CMMS">
  <data key="d0">SpeedMaint CMMS</data>
  <data key="d1">product</data>
  <data key="d2">SpeedMaint CMMS là phần mềm bảo trì giúp số hóa quy trình bảo trì, theo dõi sự cố và thời gian dừng máy, quản lý kiểm tra, phân tích báo cáo và quản lý vật tư.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Ban quản lý">
  <data key="d0">Ban quản lý</data>
  <data key="d1">organization</data>
  <data key="d2">Ban quản lý là nhóm chịu trách nhiệm đưa ra quyết định dựa trên dữ liệu và điều hướng nguồn lực để tối ưu hóa hệ thống thiết bị.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Phần mềm bảo trì">
  <data key="d0">Phần mềm bảo trì</data>
  <data key="d1">technology</data>
  <data key="d2">Phần mềm bảo trì là công nghệ được sử dụng để thu thập, quản lý và phân tích dữ liệu liên quan đến tài sản và hoạt động bảo trì.&lt;SEP&gt;Phần mềm bảo trì là một công cụ được sử dụng để tự động hóa việc xác định sự cố xảy ra lỗi và tính toán xác suất theo thời gian chính xác.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b&lt;SEP&gt;chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Thiết bị">
  <data key="d0">Thiết bị</data>
  <data key="d1">product</data>
  <data key="d2">Thiết bị là tài sản cần được bảo trì, có nguy cơ hỏng hóc và được phân loại theo mức độ rủi ro.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Tính hiệu quả về chi phí">
  <data key="d0">Tính hiệu quả về chi phí</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tính hiệu quả về chi phí là chỉ số được xem xét khi thực hiện các biện pháp bảo trì để giảm thiểu chi phí không cần thiết.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758168</data>
  <data key="d6"></data>
</node>
<node id="Dữ liệu">
  <data key="d0">Dữ liệu</data>
  <data key="d1">technology</data>
  <data key="d2">Dữ liệu là thông tin thu thập được từ các quy trình bảo trì và tài sản, được sử dụng để tính toán rủi ro và đưa ra quyết định.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758169</data>
  <data key="d6"></data>
</node>
<node id="Bảo trì dựa trên tình trạng">
  <data key="d0">Bảo trì dựa trên tình trạng</data>
  <data key="d1">technology</data>
  <data key="d2">Bảo trì dựa trên tình trạng là phương pháp hiệu quả để giảm chỉ số tần suất hỏng hóc của thiết bị.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758169</data>
  <data key="d6"></data>
</node>
<node id="Bảo trì phòng ngừa">
  <data key="d0">Bảo trì phòng ngừa</data>
  <data key="d1">technology</data>
  <data key="d2">Bảo trì phòng ngừa là phương pháp phổ biến để giảm tần suất hỏng hóc thông qua việc tăng tần suất quy trình bảo trì.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758169</data>
  <data key="d6"></data>
</node>
<node id="Chỉ số mức độ nghiêm trọng">
  <data key="d0">Chỉ số mức độ nghiêm trọng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chỉ số mức độ nghiêm trọng là một chỉ số được xác định dựa trên mức độ ảnh hưởng của thiết bị đến mục tiêu của hệ thống.&lt;SEP&gt;Chỉ số mức độ nghiêm trọng là thước đo rủi ro liên quan đến ảnh hưởng của lỗi đến mục tiêu sản xuất.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b&lt;SEP&gt;chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758169</data>
  <data key="d6"></data>
</node>
<node id="Chỉ số tần suất hỏng hóc">
  <data key="d0">Chỉ số tần suất hỏng hóc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chỉ số tần suất hỏng hóc là thước đo rủi ro dựa trên tần suất xảy ra sự cố của thiết bị.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758169</data>
  <data key="d6"></data>
</node>
<node id="Quy trình kỹ thuật">
  <data key="d0">Quy trình kỹ thuật</data>
  <data key="d1">technology</data>
  <data key="d2">Quy trình kỹ thuật là phương pháp được áp dụng để giảm thiểu nguyên nhân gây hỏng hóc của thiết bị.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758170</data>
  <data key="d6"></data>
</node>
<node id="Người dùng">
  <data key="d0">Người dùng</data>
  <data key="d1">person</data>
  <data key="d2">Người dùng là các cá nhân sử dụng phần mềm bảo trì để theo dõi và phân tích rủi ro hỏng hóc.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758170</data>
  <data key="d6"></data>
</node>
<node id="Rủi ro hỏng hóc">
  <data key="d0">Rủi ro hỏng hóc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rủi ro hỏng hóc là tích số giữa chỉ số mức độ xảy ra và chỉ số mức độ nghiêm trọng, được đánh giá ở mức chấp nhận được, có thể chấp nhận được hoặc không chấp nhận được.&lt;SEP&gt;Rủi ro hỏng hóc là chỉ số tổng hợp từ chỉ số mức độ nghiêm trọng và tần suất hỏng hóc, ảnh hưởng đến quyết định bảo trì.</data>
  <data key="d3">chunk-e263a8266442d27657db1d4fdc65bd4b&lt;SEP&gt;chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758170</data>
  <data key="d6"></data>
</node>
<node id="Frequent">
  <data key="d0">Frequent</data>
  <data key="d1">other</data>
  <data key="d2">Frequent là một phân loại mức độ xảy ra lỗi, có điểm số từ 9 đến 10, với xác suất cao xảy ra trong khoảng thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758170</data>
  <data key="d6"></data>
</node>
<node id="Likely">
  <data key="d0">Likely</data>
  <data key="d1">other</data>
  <data key="d2">Likely là một phân loại mức độ xảy ra lỗi, có điểm số từ 7 đến 8, với xác suất trung bình xảy ra trong khoảng thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758171</data>
  <data key="d6"></data>
</node>
<node id="Occasional">
  <data key="d0">Occasional</data>
  <data key="d1">other</data>
  <data key="d2">Occasional là một phân loại mức độ xảy ra lỗi, có điểm số từ 5 đến 6, với xác suất thỉnh thoảng xảy ra trong khoảng thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758171</data>
  <data key="d6"></data>
</node>
<node id="Unlikely">
  <data key="d0">Unlikely</data>
  <data key="d1">other</data>
  <data key="d2">Unlikely là một phân loại mức độ xảy ra lỗi, có điểm số từ 3 đến 4, với xác suất không có khả năng xảy ra trong thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758171</data>
  <data key="d6"></data>
</node>
<node id="Highly unlikely">
  <data key="d0">Highly unlikely</data>
  <data key="d1">other</data>
  <data key="d2">Highly unlikely là một phân loại mức độ xảy ra lỗi, có điểm số từ 1 đến 2, với xác suất xảy ra gần như bằng không trong khoảng thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758171</data>
  <data key="d6"></data>
</node>
<node id="Catastrophic">
  <data key="d0">Catastrophic</data>
  <data key="d1">other</data>
  <data key="d2">Catastrophic là một phân loại mức độ nghiêm trọng của lỗi, có điểm số từ 9 đến 10, gây dừng hệ thống khi xảy ra.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758171</data>
  <data key="d6"></data>
</node>
<node id="Critical">
  <data key="d0">Critical</data>
  <data key="d1">other</data>
  <data key="d2">Critical là một phân loại mức độ nghiêm trọng của lỗi, có điểm số từ 7 đến 8, làm giảm hiệu suất hệ thống và có thể dẫn đến hậu quả bất lợi.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758172</data>
  <data key="d6"></data>
</node>
<node id="Marginal (5-6)">
  <data key="d0">Marginal (5-6)</data>
  <data key="d1">other</data>
  <data key="d2">Marginal (5-6) là một phân loại mức độ nghiêm trọng của lỗi, có điểm số từ 5 đến 6, cần thiết để hoạt động tốt và có thể ảnh hưởng đến hiệu suất hệ thống.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758172</data>
  <data key="d6"></data>
</node>
<node id="Marginal (3-4)">
  <data key="d0">Marginal (3-4)</data>
  <data key="d1">other</data>
  <data key="d2">Marginal (3-4) là một phân loại mức độ nghiêm trọng của lỗi, có điểm số từ 3 đến 4, tùy chọn cho hiệu suất tốt, lỗi kéo dài có thể gây ra lỗi hệ thống.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758172</data>
  <data key="d6"></data>
</node>
<node id="Minor">
  <data key="d0">Minor</data>
  <data key="d1">other</data>
  <data key="d2">Minor là một phân loại mức độ nghiêm trọng của lỗi, có điểm số từ 1 đến 2, không ảnh hưởng trực tiếp đến hiệu suất hệ thống.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758173</data>
  <data key="d6"></data>
</node>
<node id="Chỉ số mức độ xảy ra">
  <data key="d0">Chỉ số mức độ xảy ra</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chỉ số mức độ xảy ra là một chỉ số được gán dựa trên xác suất xảy ra lỗi trong khoảng thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758173</data>
  <data key="d6"></data>
</node>
<node id="1% đến 10% giá trị rủi ro tối đa">
  <data key="d0">1% đến 10% giá trị rủi ro tối đa</data>
  <data key="d1">financial_metric</data>
  <data key="d2">1% đến 10% giá trị rủi ro tối đa là mức rủi ro được coi là chấp nhận được.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506&lt;SEP&gt;chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778758173</data>
  <data key="d6"></data>
</node>
<node id="10% đến 30% giá trị rủi ro tối đa">
  <data key="d0">10% đến 30% giá trị rủi ro tối đa</data>
  <data key="d1">financial_metric</data>
  <data key="d2">10% đến 30% giá trị rủi ro tối đa là mức rủi ro có thể chấp nhận được.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506&lt;SEP&gt;chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
  <data key="d4">unknown_source</data>
