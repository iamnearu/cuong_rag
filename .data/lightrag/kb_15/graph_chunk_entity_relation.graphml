<node id="Trên 30% giá trị rủi ro tối đa">
  <data key="d0">Trên 30% giá trị rủi ro tối đa</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Trên 30% giá trị rủi ro tối đa là mức rủi ro không thể chấp nhận được.</data>
  <data key="d3">chunk-6b2ecf4cbd557237a856faefe5e09506&lt;SEP&gt;chunk-830bd8d1cb943cc7c07e9b72b5c6927e</data>
