<graph edgedefault="undirected"><node id="Bảo trì dựa trên rủi ro">
  <data key="d0">Bảo trì dựa trên rủi ro</data>
  <data key="d1">technology</data>
  <data key="d2">Bảo trì dựa trên rủi ro là phương pháp bảo trì sử dụng các nguyên tắc đánh giá rủi ro để tối ưu hóa nhiệm vụ bảo trì và phân bổ nguồn lực cho các tài sản có rủi ro cao nhất.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Phần mềm bảo trì">
  <data key="d0">Phần mềm bảo trì</data>
  <data key="d1">product</data>
  <data key="d2">Phần mềm bảo trì là công cụ hỗ trợ tính toán chỉ số xuất hiện sự cố, giúp giảm tính chủ quan trong đánh giá rủi ro hỏng hóc của thiết bị.&lt;SEP&gt;Phần mềm bảo trì là công cụ được sử dụng để tự động hóa việc xác định sự cố và tính toán xác suất theo thời gian.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659&lt;SEP&gt;chunk-c7e7d2ad50715920a43ff58624fa49e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Xe đầu kéo cỡ lớn">
  <data key="d0">Xe đầu kéo cỡ lớn</data>
  <data key="d1">product</data>
  <data key="d2">Xe đầu kéo cỡ lớn là tài sản có rủi ro cao nếu hỏng hóc, thường được sử dụng để minh họa cho phương pháp bảo trì dựa trên rủi ro.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Tài sản">
  <data key="d0">Tài sản</data>
  <data key="d1">product</data>
  <data key="d2">Tài sản là các thiết bị hoặc máy móc trong nhà máy, được phân loại theo mức độ quan trọng và rủi ro hỏng hóc để xây dựng kế hoạch bảo trì.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Chỉ số sự cố xảy ra">
  <data key="d0">Chỉ số sự cố xảy ra</data>
  <data key="d1">concept</data>
  <data key="d2">Chỉ số sự cố xảy ra là chỉ số xác suất hỏng hóc của thiết bị, được tính toán dựa trên lịch sử thiết bị và phân loại theo thang điểm 1-10.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Catastrophic">
  <data key="d0">Catastrophic</data>
  <data key="d1">concept</data>
  <data key="d2">Catastrophic là mức phân loại trong chỉ số mức độ nghiêm trọng, biểu thị sự thất bại khiến hệ thống dừng lại.&lt;SEP&gt;Catastrophic là mức độ ảnh hưởng nghiêm trọng của lỗi hệ thống, gây dừng hệ thống hoàn toàn.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659&lt;SEP&gt;chunk-c7e7d2ad50715920a43ff58624fa49e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Critical">
  <data key="d0">Critical</data>
  <data key="d1">concept</data>
  <data key="d2">Critical là mức phân loại trong chỉ số mức độ nghiêm trọng, biểu thị sự cố làm giảm hiệu suất và có thể dẫn đến hậu quả bất lợi.&lt;SEP&gt;Critical là mức độ ảnh hưởng của lỗi hệ thống, làm giảm hiệu suất hoạt động của thiết bị.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659&lt;SEP&gt;chunk-c7e7d2ad50715920a43ff58624fa49e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Marginal">
  <data key="d0">Marginal</data>
  <data key="d1">concept</data>
  <data key="d2">Marginal là mức phân loại trong chỉ số mức độ nghiêm trọng, biểu thị lỗi có thể ảnh hưởng đến hiệu suất hệ thống.&lt;SEP&gt;Marginal là mức độ ảnh hưởng của lỗi hệ thống, có tác động tùy thời gian và không gây gián đoạn nghiêm trọng.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659&lt;SEP&gt;chunk-c7e7d2ad50715920a43ff58624fa49e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752907</data>
  <data key="d6"></data>
</node>
<node id="Minor">
  <data key="d0">Minor</data>
  <data key="d1">concept</data>
  <data key="d2">Minor là mức phân loại trong chỉ số mức độ nghiêm trọng, biểu thị lỗi không ảnh hưởng đến hiệu suất hệ thống.&lt;SEP&gt;Minor là mức độ ảnh hưởng nhỏ của lỗi hệ thống, không ảnh hưởng đến hiệu suất hoạt động.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659&lt;SEP&gt;chunk-c7e7d2ad50715920a43ff58624fa49e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752908</data>
  <data key="d6"></data>
</node>
<node id="Frequent">
  <data key="d0">Frequent</data>
  <data key="d1">concept</data>
  <data key="d2">Frequent là phân loại xác suất sự cố xảy ra cao trong khoảng thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752910</data>
  <data key="d6"></data>
</node>
<node id="Likely">
  <data key="d0">Likely</data>
  <data key="d1">concept</data>
  <data key="d2">Likely là phân loại xác suất sự cố xảy ra ở mức trung bình trong thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752910</data>
  <data key="d6"></data>
</node>
<node id="Occasional">
  <data key="d0">Occasional</data>
  <data key="d1">concept</data>
  <data key="d2">Occasional là phân loại xác suất sự cố xảy ra thỉnh thoảng trong thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752910</data>
  <data key="d6"></data>
</node>
<node id="Unlikely">
  <data key="d0">Unlikely</data>
  <data key="d1">concept</data>
  <data key="d2">Unlikely là phân loại xác suất sự cố xảy ra thấp trong thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752910</data>
  <data key="d6"></data>
</node>
<node id="Highly unlikely">
  <data key="d0">Highly unlikely</data>
  <data key="d1">concept</data>
  <data key="d2">Highly unlikely là phân loại xác suất sự cố xảy ra gần như bằng không trong thời gian hoạt động của thiết bị.</data>
  <data key="d3">chunk-eef634fbb5143b6bff6a32162c6b6659</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752911</data>
  <data key="d6"></data>
</node>
<node id="Bảng Quan Hệ Rủi Ro">
  <data key="d0">Bảng Quan Hệ Rủi Ro</data>
  <data key="d1">product</data>
  <data key="d2">Bảng Quan Hệ Rủi Ro là bảng thể hiện mối quan hệ giữa mức độ nghiêm trọng rủi ro (1-10) và chỉ số xuất hiện (1-10), với giá trị trong ô là tích của hai chỉ số này.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752911</data>
  <data key="d6"></data>
</node>
<node id="Mức Độ Nghiêm Trọng Rủi Ro">
  <data key="d0">Mức Độ Nghiêm Trọng Rủi Ro</data>
  <data key="d1">other</data>
  <data key="d2">Mức Độ Nghiêm Trọng Rủi Ro là chỉ số đánh giá mức độ ảnh hưởng của rủi ro, được chia thành 10 cấp độ từ 1 đến 10.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752911</data>
  <data key="d6"></data>
</node>
<node id="Chỉ Số Xuất Hiện">
  <data key="d0">Chỉ Số Xuất Hiện</data>
  <data key="d1">other</data>
  <data key="d2">Chỉ Số Xuất Hiện là chỉ số đo lường tần suất xảy ra sự cố, được chia thành 10 cấp độ từ 1 đến 10.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752911</data>
  <data key="d6"></data>
</node>
<node id="Ma Trận Rủi Ro">
  <data key="d0">Ma Trận Rủi Ro</data>
  <data key="d1">product</data>
  <data key="d2">Ma Trận Rủi Ro là bảng tính toán rủi ro bằng cách nhân Mức Độ Nghiêm Trọng Rủi Ro với Chỉ Số Xuất Hiện, giá trị cao nhất đạt 100 (10x10).</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752911</data>
  <data key="d6"></data>
</node>
<node id="Thiết Bị Rủi Ro Thấp">
  <data key="d0">Thiết Bị Rủi Ro Thấp</data>
  <data key="d1">other</data>
  <data key="d2">Thiết Bị Rủi Ro Thấp là các thiết bị có mức rủi ro thấp, được đề xuất tối ưu hóa chi phí bảo trì và thực hiện bảo trì điều chỉnh.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752912</data>
  <data key="d6"></data>
</node>
<node id="Thiết Bị Rủi Ro Cao">
  <data key="d0">Thiết Bị Rủi Ro Cao</data>
  <data key="d1">other</data>
  <data key="d2">Thiết Bị Rủi Ro Cao là các thiết bị có mức rủi ro cao, yêu cầu giảm chỉ số mức độ nghiêm trọng và tần suất hỏng hóc thông qua các phương pháp như bảo trì dựa trên tình trạng hoặc tăng tần suất bảo trì phòng ngừa.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752914</data>
  <data key="d6"></data>
</node>
<node id="Bảo Trì Dựa Trên Tình Trạng">
  <data key="d0">Bảo Trì Dựa Trên Tình Trạng</data>
  <data key="d1">technology</data>
  <data key="d2">Bảo Trì Dựa Trên Tình Trạng là phương pháp hiệu quả để giảm tần suất hỏng hóc cho thiết bị rủi ro cao.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752914</data>
  <data key="d6"></data>
</node>
<node id="Bảo Trì Phòng Ngừa">
  <data key="d0">Bảo Trì Phòng Ngừa</data>
  <data key="d1">technology</data>
  <data key="d2">Bảo Trì Phòng Ngừa là quy trình được áp dụng để giảm tần suất hỏng hóc bằng cách tăng tần suất bảo trì định kỳ.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752914</data>
  <data key="d6"></data>
</node>
<node id="Phần Mềm Bảo Trì">
  <data key="d0">Phần Mềm Bảo Trì</data>
  <data key="d1">product</data>
  <data key="d2">Phần Mềm Bảo Trì là công cụ đóng vai trò quan trọng trong việc theo dõi và trình bày kết quả rủi ro tự động, theo thời gian thực.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752914</data>
  <data key="d6"></data>
</node>
<node id="Thiết Bị Rủi Ro Vừa Phải">
  <data key="d0">Thiết Bị Rủi Ro Vừa Phải</data>
  <data key="d1">other</data>
  <data key="d2">Thiết Bị Rủi Ro Vừa Phải là các thiết bị có mức rủi ro trung bình, được khuyến nghị duy trì thói quen bảo trì hiện tại và đơn giản hóa quy trình quản lý.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752915</data>
  <data key="d6"></data>
</node>
<node id="Tối Ưu Hóa Chi Phí Bảo Trì">
  <data key="d0">Tối Ưu Hóa Chi Phí Bảo Trì</data>
  <data key="d1">other</data>
  <data key="d2">Tối Ưu Hóa Chi Phí Bảo Trì là chiến lược quản lý rủi ro nhằm giảm chi phí cho thiết bị có mức rủi ro thấp.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752915</data>
  <data key="d6"></data>
</node>
<node id="Bảo Trì Điều Chỉnh">
  <data key="d0">Bảo Trì Điều Chỉnh</data>
  <data key="d1">technology</data>
  <data key="d2">Bảo Trì Điều Chỉnh là phương pháp bảo trì được xem xét áp dụng cho thiết bị rủi ro thấp để tối ưu hóa hiệu quả.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752915</data>
  <data key="d6"></data>
</node>
<node id="Bộ Máy Quan Liêu">
  <data key="d0">Bộ Máy Quan Liêu</data>
  <data key="d1">other</data>
  <data key="d2">Bộ Máy Quan Liêu là hệ thống quy trình hành chính phức tạp, cần được giảm bớt để đơn giản hóa quản lý bảo trì cho thiết bị rủi ro vừa phải.</data>
  <data key="d3">chunk-727694d563c801baa37848f9f002ae31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752915</data>
  <data key="d6"></data>
</node>
<node id="SpeedMaint CMMS">
  <data key="d0">SpeedMaint CMMS</data>
  <data key="d1">product</data>
  <data key="d2">SpeedMaint CMMS là phần mềm quản lý bảo trì giúp số hóa quy trình bảo trì, theo dõi sự cố, phân tích báo cáo và quản lý vật tư, hỗ trợ doanh nghiệp triển khai chiến lược bảo trì có tính đến yếu tố rủi ro một cách hiệu quả.</data>
  <data key="d3">chunk-742968c1348875f455f41b248eaea0dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752915</data>
  <data key="d6"></data>
</node>
<node id="Ban Quản Lý">
  <data key="d0">Ban Quản Lý</data>
  <data key="d1">organization</data>
  <data key="d2">Ban Quản Lý là nhóm chịu trách nhiệm đưa ra các quyết định dựa trên dữ liệu về bảo trì và rủi ro thiết bị.</data>
  <data key="d3">chunk-742968c1348875f455f41b248eaea0dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752916</data>
  <data key="d6"></data>
</node>
<node id="Ban Lãnh Đạo Cấp Cao">
  <data key="d0">Ban Lãnh Đạo Cấp Cao</data>
  <data key="d1">organization</data>
  <data key="d2">Ban Lãnh Đạo Cấp Cao là nhóm được chuyển đổi ngôn ngữ kỹ thuật về độ tin cậy thiết bị thành thông tin dễ hiểu để hỗ trợ ra quyết định.</data>
  <data key="d3">chunk-742968c1348875f455f41b248eaea0dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752916</data>
  <data key="d6"></data>
</node>
<node id="Doanh Nghiệp">
  <data key="d0">Doanh Nghiệp</data>
  <data key="d1">organization</data>
  <data key="d2">Doanh Nghiệp là tổ chức triển khai chiến lược bảo trì có tính đến yếu tố rủi ro thông qua phần mềm như SpeedMaint CMMS.</data>
  <data key="d3">chunk-742968c1348875f455f41b248eaea0dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1778752916</data>
  <data key="d6"></data>
</node>
<node id="Các Nhà Quản Lý">
  <data key="d0">Các Nhà Quản Lý</data>
  <data key="d1">person</data>
