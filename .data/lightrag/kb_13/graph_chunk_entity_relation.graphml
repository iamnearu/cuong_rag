</node>
<node id="SDM nut hai">
  <data key="d0">SDM nut hai</data>
  <data key="d1">other</data>
  <data key="d2">SDM nut hai là sơ đồ mạng hai mối liên hệ FF và SS được sử dụng để tính toán thời gian bắt đầu và kết thúc sớm/trễ của công việc.</data>
  <data key="d3">chunk-7f0dec4672a908afd3ec21ee07bb407b</data>
  <data key="d4">unknown_source</data>
