  <data key="d0">Du tru thời gian toàn phần</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Du tru thời gian toàn phần là khoảng thời gian dự phòng tính bằng công thức Zl = Tj - Ti - tij.</data>
  <data key="d3">chunk-fd7552ebff5e023dce24f2886dd9c6af</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976370</data>
