  <data key="d0">Quy trình thanh toán khối lượng</data>
  <data key="d1">event</data>
  <data key="d2">Quy trình thanh toán khối lượng là chuỗi hoạt động từ đệ trình hồ sơ đến phê duyệt và thực hiện thanh toán cho nhà thầu phụ.</data>
  <data key="d3">chunk-c164371a2505dc88c4539f83f89ae713</data>
