</node>
<node id="Trinh do cong nghe">
  <data key="d0">Trinh do cong nghe</data>
  <data key="d1">technology</data>
  <data key="d2">Trinh do cong nghe là mức độ hiện đại của công nghệ hiện có và tiềm năng phát triển trong khu vực triển khai dự án.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
