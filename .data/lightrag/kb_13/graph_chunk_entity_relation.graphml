<node id="2.000 container/tháng">
  <data key="d0">2.000 container/tháng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">2.000 container/tháng là khối lượng vận chuyển tại các kho hàng A và D.</data>
  <data key="d3">chunk-c62241106864f95b29428820ca88043a</data>
