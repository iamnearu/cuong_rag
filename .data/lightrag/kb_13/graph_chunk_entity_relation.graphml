  <data key="d1">event</data>
  <data key="d2">Kết Quả Phân Chia Công Việc là danh mục công việc thi công được lập sau khi phân tích các quá trình thành phần.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
