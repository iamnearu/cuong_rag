<node id="Tổng Tiến Độ">
  <data key="d0">Tổng Tiến Độ</data>
  <data key="d1">event</data>
  <data key="d2">Tổng tiến độ là kế hoạch thời gian thi công công trình, thể hiện qua biểu đồ ngang hoặc mạng.</data>
