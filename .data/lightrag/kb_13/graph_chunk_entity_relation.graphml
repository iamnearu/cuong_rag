  <data key="d0">Thiết Kế Thi Công</data>
  <data key="d1">event</data>
  <data key="d2">Thiết kế thi công là giai đoạn thiết kế công trình theo một giai đoạn hoặc hai giai đoạn của thiết kế công trình hai giai đoạn.</data>
  <data key="d3">chunk-d451d2038a98e4929b77d5130519747e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976545</data>
