  <data key="d0">Tổ Chức Dịch Vụ Ngân Hàng, Tài Chính</data>
  <data key="d1">organization</data>
  <data key="d2">Tổ Chức Dịch Vụ Ngân Hàng, Tài Chính là đơn vị hỗ trợ tài chính cho các dự án xây dựng.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
