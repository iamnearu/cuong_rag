  <data key="d0">Đóng gói (3)</data>
  <data key="d1">organization</data>
  <data key="d2">Đóng gói (3) là bộ phận sản xuất, nhận 100 tấn từ Hòan thiện (1), 30 tấn từ In ấn (2), và 100 tấn đến Kiểm tra (6).</data>
  <data key="d3">chunk-d057797ec16ef2fc62ed848e229f9d3f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972616</data>
  <data key="d6"></data>
</node>
