<edge source="Năng Suất Tổng Hợp" target="Nghiên Cứu Thời Gian Lao Động">
  <data key="d7">1.0</data>
  <data key="d8">Nghiên cứu thời gian lao động và tự do hợp lý cải thiện năng suất tổng hợp thông qua tối ưu hóa thời gian làm việc.</data>
  <data key="d9">hiệu quả,thời gian</data>
  <data key="d10">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d11">unknown_source</data>
