<node id="Thoi Gian Thuc Hien">
  <data key="d0">Thoi Gian Thuc Hien</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thoi Gian Thuc Hien là thời gian thực tế cần để hoàn thành một công việc, được ghi trên sơ đồ mạng.</data>
  <data key="d3">chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976528</data>
  <data key="d6"></data>
</node>
<node id="Tai Nguyen Tuong Ung">
  <data key="d0">Tai Nguyen Tuong Ung</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tai Nguyen Tuong Ung là tài nguyên được phân bổ cho từng công việc, được ghi trên sơ đồ mạng.</data>
  <data key="d3">chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976528</data>
