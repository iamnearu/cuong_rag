  <data key="d0">Khao sat ky thuat</data>
  <data key="d1">event</data>
  <data key="d2">Khao sat ky thuat là hoạt động đánh giá điều kiện tự nhiên, kỹ thuật tại khu vực triển khai dự án.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976596</data>
