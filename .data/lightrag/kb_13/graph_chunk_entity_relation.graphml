<node id="Vòng 2">
  <data key="d0">Vòng 2</data>
  <data key="d1">other</data>
  <data key="d2">Vòng 2 là giai đoạn kiểm tra lại các mối quan hệ và loại bỏ các ràng buộc không cần thiết trong SDM.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976489</data>
  <data key="d6"></data>
</node>
<node id="Vòng 3">
  <data key="d0">Vòng 3</data>
  <data key="d1">other</data>
  <data key="d2">Vòng 3 là giai đoạn thay đổi phân chia công việc và mức độ chuyên môn hóa để điều chỉnh SDM.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976490</data>
  <data key="d6"></data>
</node>
<node id="Vòng 4">
  <data key="d0">Vòng 4</data>
  <data key="d1">other</data>
  <data key="d2">Vòng 4 là giai đoạn thay đổi công nghệ thi công nhằm rút ngắn hoặc kéo dài thời gian thi công để đạt mục tiêu.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976490</data>
  <data key="d6"></data>
</node>
<node id="Bước 6">
  <data key="d0">Bước 6</data>
  <data key="d1">other</data>
  <data key="d2">Bước 6 là bước chỉnh sửa sơ đồ mạng ban đầu để đơn giản hóa và loại bỏ các mối liên hệ thừa.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
