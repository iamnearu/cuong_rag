</node>
<node id="Công Thức (2.2)">
  <data key="d0">Công Thức (2.2)</data>
  <data key="d1">other</data>
  <data key="d2">Công thức (2.2) là phương pháp xác định nhu cầu máy móc theo năng suất thực tế.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
