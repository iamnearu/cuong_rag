<node id="Phương pháp bình phương tối thiểu">
  <data key="d0">Phương pháp bình phương tối thiểu</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp bình phương tối thiểu là kỹ thuật được áp dụng để kẻ một đường thẳng đi qua các số liệu sẵn có, tối thiểu hóa tổng bình phương các khoảng cách từ số liệu đến đường thẳng.</data>
  <data key="d3">chunk-3fb7a67aecd6f3725a90baaa088e0e57</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972662</data>
  <data key="d6"></data>
</node>
<node id="Chương II">
  <data key="d0">Chương II</data>
  <data key="d1">other</data>
  <data key="d2">Chương II là phần trong tài liệu trình bày về công suất, các phương pháp hỗ trợ lựa chọn công suất và phân tích liên quan.</data>
  <data key="d3">chunk-bfb09dc2f0322ea84f0381a3d2cccb49</data>
