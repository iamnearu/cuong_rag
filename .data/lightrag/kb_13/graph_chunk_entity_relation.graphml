<node id="Dây chuyền">
  <data key="d0">Dây chuyền</data>
  <data key="d1">other</data>
  <data key="d2">Dây chuyền là khái niệm chỉ chuỗi các công đoạn thi công liên tiếp trong xây dựng.</data>
  <data key="d3">chunk-fd0de5bb8f44563a085369a84159aa72</data>
