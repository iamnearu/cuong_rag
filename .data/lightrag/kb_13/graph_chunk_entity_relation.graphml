  <data key="d0">Các Quá Trình Thành Phần</data>
  <data key="d1">event</data>
  <data key="d2">Các Quá Trình Thành Phần là những giai đoạn sản xuất độc lập được phân chia từ quá trình xây dựng công trình.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
