  <data key="d0">Hộp 5.2</data>
  <data key="d1">artifact</data>
  <data key="d2">Hộp 5.2 là ví dụ minh họa về lãng phí tại dây chuyền lắp ráp khung gầm xe tải của Toyota.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972647</data>
