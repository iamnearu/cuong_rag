  <data key="d2">Ngân hàng BIDV là tổ chức tài chính điều chỉnh cấu trúc nợ vay dài hạn của doanh nghiệp.&lt;SEP&gt;Ngân hàng BIDV là tổ chức tài chính được đề cập trong văn bản, liên quan đến việc điều chỉnh cấu trúc nợ vay dài hạn.</data>
  <data key="d3">chunk-703a8d5b13b6d58a88b3275a52df3c78&lt;SEP&gt;chunk-4668643ebb1a885502274e3326a2b862</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777970567</data>
  <data key="d6"></data>
</node>
<node id="Chủ tịch Hội đồng quản trị">
  <data key="d0">Chủ tịch Hội đồng quản trị</data>
  <data key="d1">person</data>
  <data key="d2">Chủ tịch Hội đồng quản trị là cá nhân chịu trách nhiệm đảm bảo báo cáo tài chính đáp ứng các yêu cầu pháp lý và nội bộ.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952785</data>
  <data key="d6"></data>
</node>
<node id="Bộ Tài chính Việt Nam">
  <data key="d0">Bộ Tài chính Việt Nam</data>
  <data key="d1">organization</data>
  <data key="d2">Bộ Tài chính Việt Nam là cơ quan quản lý nhà nước về tài chính, giám sát việc lập và trình bày báo cáo tài chính.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952785</data>
  <data key="d6"></data>
</node>
<node id="Luật số 24/860">
  <data key="d0">Luật số 24/860</data>
  <data key="d1">regulation</data>
  <data key="d2">Luật số 24/860 là văn bản pháp luật Việt Nam quy định các nguyên tắc phân loại và trình bày báo cáo tài chính.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952785</data>
  <data key="d6"></data>
</node>
<node id="Tài sản">
  <data key="d0">Tài sản</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tài sản là các khoản giá trị mà doanh nghiệp sở hữu, được ghi nhận trong báo cáo tài chính.&lt;SEP&gt;Tài sản là đối tượng được ghi nhận giá trị khi doanh nghiệp vốn hóa chi phí vay.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f&lt;SEP&gt;chunk-87770fe8bdb2cd0294b53c1d6eb782ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952785</data>
  <data key="d6"></data>
</node>
<node id="Phải thu khách hàng">
  <data key="d0">Phải thu khách hàng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Phải thu khách hàng là khoản tiền do khách hàng nợ doanh nghiệp, thuộc danh mục tài sản ngắn hạn.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952786</data>
  <data key="d6"></data>
</node>
<node id="Phải thu vay">
  <data key="d0">Phải thu vay</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Phải thu vay là khoản tiền phải thu từ các bên cho vay, được phân loại theo kỳ hạn và đối tượng.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952786</data>
  <data key="d6"></data>
</node>
<node id="Phải thu khác">
  <data key="d0">Phải thu khác</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Phải thu khác là các khoản phải thu không liên quan đến hoạt động thương mại hoặc tài chính.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952786</data>
  <data key="d6"></data>
</node>
<node id="Phải thu dài hạn">
  <data key="d0">Phải thu dài hạn</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Phải thu dài hạn là khoản phải thu có thời gian thu hồi trên 12 tháng hoặc một chu kỳ kinh doanh.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952786</data>
  <data key="d6"></data>
</node>
<node id="Nguyên tắc ghi nhận các khoản phải thu trong doanh nghiệp">
  <data key="d0">Nguyên tắc ghi nhận các khoản phải thu trong doanh nghiệp</data>
  <data key="d1">other</data>
  <data key="d2">Nguyên tắc này quy định cách ghi nhận các khoản phải thu trong doanh nghiệp theo quy định pháp luật Việt Nam.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952786</data>
  <data key="d6"></data>
</node>
<node id="Phân loại các khoản phải thu">
  <data key="d0">Phân loại các khoản phải thu</data>
  <data key="d1">other</data>
  <data key="d2">Phân loại các khoản phải thu là quá trình sắp xếp các khoản phải thu theo kỳ hạn, đối tượng và rủi ro, được quy định trong Luật số 24/860.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952787</data>
  <data key="d6"></data>
</node>
<node id="Chu kỳ kinh doanh">
  <data key="d0">Chu kỳ kinh doanh</data>
  <data key="d1">other</data>
  <data key="d2">Chu kỳ kinh doanh là khoảng thời gian hoạt động sản xuất kinh doanh của doanh nghiệp, được sử dụng để xác định các khoản phải thu dài hạn.&lt;SEP&gt;Chu kỳ kinh doanh là giai đoạn hoạt động sản xuất kinh doanh được quy định trong thời gian thanh toán các khoản chi phí.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f&lt;SEP&gt;chunk-00fe331f136c5a09db18cac7106d146e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952787</data>
  <data key="d6"></data>
</node>
<node id="Kỳ hạn gốc">
  <data key="d0">Kỳ hạn gốc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Kỳ hạn gốc là thời gian ban đầu để thu hồi các khoản phải thu, được sử dụng trong phân loại tài sản.</data>
  <data key="d3">chunk-65535c1f5d20b540348de0f9b056465f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952787</data>
  <data key="d6"></data>
</node>
<node id="Giá trị giải ngân">
  <data key="d0">Giá trị giải ngân</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Giá trị giải ngân thể hiện số tiền đã được chi trả, giảm từ 45,925 tỷ VND (30/06/2025) xuống 35,370 tỷ VND (30/09/2024).&lt;SEP&gt;Giá trị giải ngân là giá trị vốn đã được giải ngân, giảm từ 45.925 tỷ xuống 35.370 tỷ.</data>
  <data key="d3">chunk-59409cbba6bae8aaca8d90d40c24b561&lt;SEP&gt;chunk-d8202aee0978880ad475854146c90711</data>
  <data key="d4">unknown_source</data>
