<node id="Sản xuất dư thừa">
  <data key="d0">Sản xuất dư thừa</data>
  <data key="d1">other</data>
  <data key="d2">Sản xuất dư thừa là loại lãng phí trong JIT, xảy ra khi sản xuất nhiều hơn hoặc sớm hơn nhu cầu.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
  <data key="d4">unknown_source</data>
