  <data key="d0">Đầu tư đổi mới công nghệ</data>
  <data key="d1">technology</data>
  <data key="d2">Đầu tư đổi mới công nghệ là nhu cầu trong sản xuất, nhưng thường không được bộ phận tài chính hỗ trợ kịp thời.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972636</data>
  <data key="d6"></data>
</node>
<node id="Khủng hoảng tài chính Châu Á 1997">
  <data key="d0">Khủng hoảng tài chính Châu Á 1997</data>
  <data key="d1">event</data>
  <data key="d2">Khủng hoảng tài chính Châu Á 1997 là sự kiện kinh tế ảnh hưởng đến yêu cầu thay đổi trong quản trị sản xuất.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972636</data>
  <data key="d6"></data>
</node>
<node id="Toàn cầu hóa">
  <data key="d0">Toàn cầu hóa</data>
  <data key="d1">other</data>
  <data key="d2">Toàn cầu hóa là xu hướng kinh tế, thúc đẩy sự thay đổi trong quản trị sản xuất và tác nghiệp.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972637</data>
  <data key="d6"></data>
</node>
<node id="Khoa học - công nghệ hiện đại">
  <data key="d0">Khoa học - công nghệ hiện đại</data>
  <data key="d1">technology</data>
  <data key="d2">Khoa học - công nghệ hiện đại là yếu tố then chốt trong xu hướng phát triển của quản trị sản xuất.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972637</data>
  <data key="d6"></data>
</node>
<node id="Kaizen">
  <data key="d0">Kaizen</data>
  <data key="d1">technology</data>
  <data key="d2">Kaizen là mô hình cải tiến liên tục, một phần của xu hướng quản trị sản xuất hiện đại.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972637</data>
  <data key="d6"></data>
</node>
<node id="CRM">
  <data key="d0">CRM</data>
  <data key="d1">technology</data>
  <data key="d2">CRM là công nghệ quản lý quan hệ khách hàng, được tích hợp vào quản trị sản xuất.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972637</data>
  <data key="d6"></data>
</node>
<node id="Kanban">
  <data key="d0">Kanban</data>
  <data key="d1">technology</data>
  <data key="d2">Kanban là hệ thống quản lý sản xuất linh hoạt, thuộc xu hướng phát triển hiện đại.&lt;SEP&gt;Kanban là một hệ thống quản lý sản xuất sử dụng thẻ để điều phối việc chuyển nguyên vật liệu và sản xuất, bắt nguồn từ Nhật Bản.&lt;SEP&gt;Kanban là từ tiếng Nhật có nghĩa là 'ký hiệu' hay 'dấu hiệu', được sử dụng trong hệ thống JIT để quản lý sản xuất thông qua các thẻ.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439&lt;SEP&gt;chunk-10b49ad58cc0927525c42710aff72228&lt;SEP&gt;chunk-f48549c1d4e1ae32836efba5728b067e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972638</data>
  <data key="d6"></data>
</node>
<node id="MRP">
  <data key="d0">MRP</data>
  <data key="d1">technology</data>
  <data key="d2">MRP là hệ thống hoạch định nguồn lực sản xuất, được nghiên cứu và áp dụng trong quản trị.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972638</data>
  <data key="d6"></data>
</node>
