<node id="DIEU KIEN AP DUNG PHUONG PHAP TO CHUC SAN XUAT DAY CHUYEN TrONG XAY DUNG">
  <data key="d0">DIEU KIEN AP DUNG PHUONG PHAP TO CHUC SAN XUAT DAY CHUYEN TrONG XAY DUNG</data>
  <data key="d1">event</data>
  <data key="d2">DIEU KIEN AP DUNG PHUONG PHAP TO CHUC SAN XUAT DAY CHUYEN TrONG XAY DUNG là tiêu chí cần đáp ứng để áp dụng hiệu quả phương pháp dây chuyền trong xây dựng.</data>
  <data key="d3">chunk-f5c66bff14c0e74e04d408bc34b38129</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976459</data>
  <data key="d6"></data>
</node>
<node id="Buoc 1">
  <data key="d0">Buoc 1</data>
  <data key="d1">other</data>
  <data key="d2">Buoc 1 là bước đầu tiên trong quy trình thiết kế các dây chuyền chuyên môn hóa theo lý thuyết đã trình bày ở mục 3.10.</data>
  <data key="d3">chunk-f5c66bff14c0e74e04d408bc34b38129</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976459</data>
  <data key="d6"></data>
</node>
<node id="Buoc 2">
  <data key="d0">Buoc 2</data>
  <data key="d1">other</data>
  <data key="d2">Buoc 2 là bước tiếp theo trong quy trình thiết kế, liên quan đến xác định các khoảng ghep sat giữa các dây chuyền đơn.</data>
  <data key="d3">chunk-f5c66bff14c0e74e04d408bc34b38129</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976460</data>
  <data key="d6"></data>
</node>
<node id="Phương pháp Tổ chức Dây chuyền">
  <data key="d0">Phương pháp Tổ chức Dây chuyền</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp tổ chức dây chuyền là một phương pháp sản xuất trong xây dựng, yêu cầu sự chuẩn bị kỹ lưỡng và điều kiện cụ thể để đạt hiệu quả cao.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976460</data>
  <data key="d6"></data>
</node>
<node id="Sơ đồ Mạng">
  <data key="d0">Sơ đồ Mạng</data>
  <data key="d1">technology</data>
  <data key="d2">Sơ đồ mạng là phương pháp biểu diễn tiến độ thi công, bao gồm các kỹ thuật như CPM, MPM, PERT, được phát triển vào cuối thế kỷ 19 và hoàn thiện năm 1958.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976460</data>
  <data key="d6"></data>
</node>
<node id="Sơ đồ Gantt">
  <data key="d0">Sơ đồ Gantt</data>
  <data key="d1">technology</data>
  <data key="d2">Sơ đồ Gantt là phương pháp truyền thống lập tiến độ thi công, có ưu điểm đơn giản nhưng tồn tại nhiều hạn chế.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976460</data>
  <data key="d6"></data>
</node>
<node id="Nguyên tắc Cơ bản Tổ chức Dây chuyền">
  <data key="d0">Nguyên tắc Cơ bản Tổ chức Dây chuyền</data>
  <data key="d1">technology</data>
  <data key="d2">Nguyên tắc cơ bản tổ chức dây chuyền là nền tảng để thực hiện phương pháp này hiệu quả trong xây dựng.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976460</data>
  <data key="d6"></data>
</node>
<node id="Kỹ thuật">
  <data key="d0">Kỹ thuật</data>
  <data key="d1">technology</data>
  <data key="d2">Kỹ thuật là yếu tố cần thiết để đảm bảo tổ chức dây chuyền hoạt động nhịp nhàng.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976461</data>
  <data key="d6"></data>
</node>
<node id="Thiết bị">
  <data key="d0">Thiết bị</data>
  <data key="d1">product</data>
  <data key="d2">Thiết bị là công cụ vật chất cần thiết cho việc thực hiện phương pháp tổ chức dây chuyền.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976461</data>
  <data key="d6"></data>
</node>
<node id="Phương tiện Vận tải">
  <data key="d0">Phương tiện Vận tải</data>
  <data key="d1">product</data>
  <data key="d2">Phương tiện vận tải là yếu tố hỗ trợ trong tổ chức dây chuyền xây dựng.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976461</data>
  <data key="d6"></data>
</node>
<node id="Kế hoạch Dài hạn">
  <data key="d0">Kế hoạch Dài hạn</data>
  <data key="d1">technology</data>
  <data key="d2">Kế hoạch dài hạn là điều kiện quan trọng để duy trì hiệu quả của tổ chức dây chuyền trong thời gian dài.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976461</data>
  <data key="d6"></data>
</node>
<node id="Công nghiệp hóa Sản xuất Xây dựng">
  <data key="d0">Công nghiệp hóa Sản xuất Xây dựng</data>
  <data key="d1">technology</data>
  <data key="d2">Công nghiệp hóa sản xuất xây dựng tạo điều kiện cho tổ chức dây chuyền hoạt động nhịp nhàng.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976461</data>
  <data key="d6"></data>
</node>
<node id="Lý thuyết Đồ thị">
  <data key="d0">Lý thuyết Đồ thị</data>
  <data key="d1">technology</data>
  <data key="d2">Lý thuyết đồ thị là cơ sở toán học của sơ đồ mạng, được ứng dụng để hoàn thiện phương pháp này.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976462</data>
  <data key="d6"></data>
</node>
<node id="Cuối Thế kỷ 19">
  <data key="d0">Cuối Thế kỷ 19</data>
  <data key="d1">date</data>
  <data key="d2">Cuối thế kỷ 19 là thời điểm sơ đồ mạng được phát triển lần đầu tiên.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976462</data>
  <data key="d6"></data>
</node>
<node id="1958">
  <data key="d0">1958</data>
  <data key="d1">date</data>
  <data key="d2">Năm 1958 là thời điểm sơ đồ mạng được hoàn thiện và áp dụng tại Mỹ.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976462</data>
  <data key="d6"></data>
</node>
<node id="Đơn vị">
  <data key="d0">Đơn vị</data>
  <data key="d1">organization</data>
  <data key="d2">Đơn vị là các tổ chức hoặc cá nhân tham gia vào quá trình tổ chức dây chuyền sản xuất xây dựng.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976462</data>
  <data key="d6"></data>
</node>
<node id="Công nhân">
  <data key="d0">Công nhân</data>
  <data key="d1">person</data>
  <data key="d2">Công nhân là những người lao động trực tiếp tham gia vào các công việc theo phương pháp tổ chức dây chuyền.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976462</data>
  <data key="d6"></data>
</node>
<node id="Bộ máy Điều độ">
  <data key="d0">Bộ máy Điều độ</data>
  <data key="d1">organization</data>
  <data key="d2">Bộ máy Điều độ là hệ thống quản lý cần thiết để đảm bảo sự phối hợp nhịp nhàng giữa các đơn vị trong dây chuyền sản xuất.</data>
  <data key="d3">chunk-41aa67409eec056abddf79c9a9587c71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976463</data>
  <data key="d6"></data>
</node>
<node id="Cot 5">
  <data key="d0">Cot 5</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 5 là định mức lao động - chi phí lao động để hoàn thành một đơn vị sản phẩm theo định mức hiện hành.&lt;SEP&gt;Cot 5 là cột có giá trị bằng tổng của giá trị cột 4 và cột 3.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976463</data>
  <data key="d6"></data>
</node>
<node id="Cot 6">
  <data key="d0">Cot 6</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 6 là định mức máy móc - chi phí giờ máy (nếu thi công có máy) cho đơn vị sản phẩm theo định mức hiện hành.&lt;SEP&gt;Cot 6 là cột chứa giá trị thời gian hoặc số liệu được xác định thông qua hàm max hoặc min từ các công việc liên quan.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976463</data>
  <data key="d6"></data>
</node>
<node id="Cot 7">
  <data key="d0">Cot 7</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 7 là nhu cầu lao động (ngày công) được tính bằng tích của Cot 4 và Cot 5.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976463</data>
  <data key="d6"></data>
</node>
<node id="Cot 8">
  <data key="d0">Cot 8</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 8 là nhu cầu máy móc (ca máy) được tính bằng tích của Cot 4 và Cot 6.&lt;SEP&gt;Cot 8 là cột tính toán dựa trên hiệu số giữa cột 7 và cột 5 hoặc cột 6 và cột 4.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976463</data>
  <data key="d6"></data>
</node>
<node id="Cot 9">
  <data key="d0">Cot 9</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 9 là chế độ làm việc - số ca làm việc trong ngày, thường lấy 1 ca với lao động thủ công, 2-3 ca với thi công cơ giới.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976464</data>
  <data key="d6"></data>
</node>
<node id="Cot 10">
  <data key="d0">Cot 10</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 10 là biên chế số công nhân trong đơn vị thực hiện công việc.&lt;SEP&gt;Cot 10 là cột ghi ký hiệu các công việc có giá trị Z bằng 0, được xác định thông qua phân tích cột 8 và 9.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976464</data>
  <data key="d6"></data>
</node>
<node id="Cot 11">
  <data key="d0">Cot 11</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 11 là số máy trong đơn vị thực hiện công việc.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976464</data>
  <data key="d6"></data>
</node>
<node id="Bieu do the hien tien do thi cong">
  <data key="d0">Bieu do the hien tien do thi cong</data>
  <data key="d1">product</data>
  <data key="d2">Bieu do the hien tien do thi cong là sản phẩm trực quan hóa tiến độ thi công dưới dạng đường thẳng trên trục thời gian.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976464</data>
  <data key="d6"></data>
</node>
<node id="Hinh 2.2">
  <data key="d0">Hinh 2.2</data>
  <data key="d1">product</data>
  <data key="d2">Hinh 2.2 là hình ảnh minh họa biểu đồ tiến độ thi công trên sơ đồ ngang.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976464</data>
  <data key="d6"></data>
</node>
<node id="Cot 4">
  <data key="d0">Cot 4</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 4 là khối lượng công việc hoặc đơn vị sản phẩm cần tính toán để xác định nhu cầu lao động và máy móc.&lt;SEP&gt;Cot 4 là cột ghi giá trị thời gian hoặc số liệu liên quan đến công việc, được xác định thông qua các công thức như max hoặc tổng hợp từ cột 3 và cột 5.</data>
  <data key="d3">chunk-ad9801005d113532a60c2099a346917f&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
