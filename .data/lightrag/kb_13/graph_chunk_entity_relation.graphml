</edge>
<edge source="Sản xuất tinh gọn" target="Toyota Production System (TPS)">
  <data key="d7">1.0</data>
  <data key="d8">TPS là nguồn gốc trực tiếp của sản xuất tinh gọn, được cải tiến và phổ biến rộng rãi.</data>
  <data key="d9">cải tiến,nguồn gốc</data>
