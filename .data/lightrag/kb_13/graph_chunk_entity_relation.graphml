  <data key="d1">technology</data>
  <data key="d2">Mô hình 3P là phương pháp khai thác tiềm năng nguồn lực con người trong quản trị sản xuất.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
