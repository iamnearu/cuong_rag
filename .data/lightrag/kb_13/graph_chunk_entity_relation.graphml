  <data key="d0">Cong viec i-j</data>
  <data key="d1">event</data>
  <data key="d2">Cong viec i-j là một công việc cụ thể được giới hạn bởi sự kiện đầu i và sự kiện cuối j trong mạng lưới dự án.</data>
  <data key="d3">chunk-759b382482eecf9fe3d181ae21a2fd6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976513</data>
  <data key="d6"></data>
</node>
