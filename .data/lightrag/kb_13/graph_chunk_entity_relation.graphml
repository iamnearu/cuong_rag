  <data key="d0">Bước 3: Xác Định Các Thông Số Công Nghệ</data>
  <data key="d1">event</data>
  <data key="d2">Bước 3 liên quan đến việc thành lập các tổ sản xuất chuyên môn và xác định thông số công nghệ.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
