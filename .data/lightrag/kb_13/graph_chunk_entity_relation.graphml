</node>
<node id="Z?">
  <data key="d0">Z?</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Z? là giá trị tương tự Z, được sử dụng để xác định các công việc có giá trị bằng 0 trong cột 10.</data>
  <data key="d3">chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
