  <data key="d1">product</data>
  <data key="d2">Dây chuyền xây dựng là hệ thống sản xuất được thiết lập qua các bước lập kế hoạch và tổ chức.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
