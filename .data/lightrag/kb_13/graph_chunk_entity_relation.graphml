  <data key="d1">financial_metric</data>
  <data key="d2">50 tấn là khối lượng vận chuyển giữa các bộ phận.</data>
  <data key="d3">chunk-d057797ec16ef2fc62ed848e229f9d3f</data>
  <data key="d4">unknown_source</data>
