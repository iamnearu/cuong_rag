<node id="Hồ sơ thanh toán">
  <data key="d0">Hồ sơ thanh toán</data>
  <data key="d1">product</data>
  <data key="d2">Hồ sơ thanh toán là tập hợp tài liệu cần thiết để thực hiện thanh toán khối lượng cho nhà thầu phụ.</data>
  <data key="d3">chunk-c164371a2505dc88c4539f83f89ae713&lt;SEP&gt;chunk-0f63923c8282ddef51867d10a171b67a</data>
  <data key="d4">unknown_source</data>
