<node id="Quản lý cung ứng">
  <data key="d0">Quản lý cung ứng</data>
  <data key="d1">person</data>
  <data key="d2">Quản lý cung ứng là nhân sự chịu trách nhiệm trong quy trình mua sắm và thanh toán vật tư.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
