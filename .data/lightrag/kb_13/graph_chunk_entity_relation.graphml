</node>
<node id="Tài nguyên">
  <data key="d0">Tài nguyên</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tài nguyên là các nguồn lực được tiêu thụ trong quá trình thi công, liên quan đến các chỉ số trong SDM.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976492</data>
  <data key="d6"></data>
</node>
<node id="Bước 8">
  <data key="d0">Bước 8</data>
  <data key="d1">other</data>
  <data key="d2">Bước 8 là bước tính toán các thông số của SDM theo quy tắc đã trình bày, thường tập trung vào độ dài đường gang và chỉ số tiêu thụ tài nguyên.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976492</data>
  <data key="d6"></data>
</node>
