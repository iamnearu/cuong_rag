  <data key="d0">Thay Doi Bien Phap Thi Cong</data>
  <data key="d1">technology</data>
  <data key="d2">Thay Doi Bien Phap Thi Cong là phương pháp điều chỉnh Duong Gang thông qua thay đổi công nghệ thi công, ví dụ như sử dụng bê tông tại chỗ.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976435</data>
