  <data key="d0">Công việc L</data>
  <data key="d1">other</data>
  <data key="d2">Công việc L là bước lồng ảnh vào hộp, mất 60 giây và phụ thuộc vào C, K.</data>
  <data key="d3">chunk-bd8881c9a271d4fb8f19cf3eb391e4e1</data>
