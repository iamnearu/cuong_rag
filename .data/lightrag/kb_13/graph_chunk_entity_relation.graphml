  <data key="d1">product</data>
  <data key="d2">Phương án doanh nghiệp công suất nhỏ, ổn định với giá trị 10 triệu đồng cho cả ba tiêu chí.</data>
  <data key="d3">chunk-2edf35ad624ca51dfcca5e087d86aebe</data>
  <data key="d4">unknown_source</data>
