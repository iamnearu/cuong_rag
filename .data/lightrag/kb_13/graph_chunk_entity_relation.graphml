<node id="Tàu Thủy">
  <data key="d0">Tàu Thủy</data>
  <data key="d1">product</data>
  <data key="d2">Tàu thủy là sản phẩm lớn, phù hợp với bố trí mặt bằng theo vị trí cố định.</data>
  <data key="d3">chunk-df8fca63c78162257c36992352700179</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972684</data>
  <data key="d6"></data>
</node>
<node id="Công Trình Xây Dựng">
  <data key="d0">Công Trình Xây Dựng</data>
  <data key="d1">product</data>
  <data key="d2">Công trình xây dựng là sản phẩm không thể di chuyển, thường áp dụng bố trí mặt bằng cố định.&lt;SEP&gt;Công trình xây dựng là sản phẩm của hoạt động sản xuất xây dựng, gắn với địa điểm cụ thể.</data>
  <data key="d3">chunk-df8fca63c78162257c36992352700179&lt;SEP&gt;chunk-e39fcaaef27cd718993c01ad2659763f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976431</data>
  <data key="d6"></data>
</node>
<node id="Bố Trí Mặt Bằng Hỗn Hợp">
  <data key="d0">Bố Trí Mặt Bằng Hỗn Hợp</data>
  <data key="d1">other</data>
  <data key="d2">Bố trí mặt bằng hỗn hợp là hình thức kết hợp các loại bố trí cơ bản để phát huy ưu điểm và hạn chế nhược điểm.</data>
  <data key="d3">chunk-df8fca63c78162257c36992352700179</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972684</data>
  <data key="d6"></data>
</node>
<node id="Khu Giường Bệnh Nhân">
  <data key="d0">Khu Giường Bệnh Nhân</data>
  <data key="d1">location</data>
  <data key="d2">Khu giường bệnh nhân là khu vực trong cơ sở y tế dành cho bệnh nhân nằm điều trị.</data>
  <data key="d3">chunk-df8fca63c78162257c36992352700179</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972684</data>
  <data key="d6"></data>
</node>
<node id="Chụp X Quang">
  <data key="d0">Chụp X Quang</data>
  <data key="d1">location</data>
  <data key="d2">Chụp X quang là khu vực trong cơ sở y tế thực hiện các dịch vụ chẩn đoán hình ảnh.</data>
  <data key="d3">chunk-df8fca63c78162257c36992352700179</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972685</data>
  <data key="d6"></data>
</node>
<node id="Văn Phòng Giao Dịch Ở Ngân Hàng">
  <data key="d0">Văn Phòng Giao Dịch Ở Ngân Hàng</data>
  <data key="d1">location</data>
  <data key="d2">Văn phòng giao dịch ở ngân hàng là ví dụ về cơ sở tài chính bố trí theo quá trình.</data>
  <data key="d3">chunk-df8fca63c78162257c36992352700179</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972685</data>
  <data key="d6"></data>
</node>
<node id="Xưởng Sửa Chữa Xe Hơi">
  <data key="d0">Xưởng Sửa Chữa Xe Hơi</data>
  <data key="d1">location</data>
  <data key="d2">Xưởng sửa chữa xe hơi là ví dụ về cơ sở sản xuất bố trí theo khu vực sửa chữa theo chủng loại.</data>
  <data key="d3">chunk-df8fca63c78162257c36992352700179</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972685</data>
  <data key="d6"></data>
</node>
<node id="Nơi làm việc 1">
  <data key="d0">Nơi làm việc 1</data>
  <data key="d1">location</data>
  <data key="d2">Nơi làm việc 1 là vị trí đầu tiên trong dây chuyền lắp ráp, thực hiện Công việc A và B.</data>
  <data key="d3">chunk-2c3fcdeeba2d61d9e99ccec68bf9cc33</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972686</data>
