</node>
<node id="Phòng vật tư">
  <data key="d0">Phòng vật tư</data>
  <data key="d1">organization</data>
  <data key="d2">Phòng vật tư quản lý các hoạt động đặt hàng, nhận hàng và kiểm tra chất lượng vật tư.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955970</data>
  <data key="d6"></data>
</node>
<node id="Phòng kế toán">
  <data key="d0">Phòng kế toán</data>
  <data key="d1">organization</data>
  <data key="d2">Phòng kế toán thực hiện lập báo cáo công nợ, kế hoạch thanh toán và xử lý tài chính.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955970</data>
  <data key="d6"></data>
</node>
<node id="NCC">
  <data key="d0">NCC</data>
  <data key="d1">organization</data>
  <data key="d2">NCC (Nhà cung cấp) là đối tác cung ứng vật tư và tham gia vào các giai đoạn từ báo giá đến thanh toán.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955970</data>
  <data key="d6"></data>
</node>
<node id="Xét duyệt báo giá">
  <data key="d0">Xét duyệt báo giá</data>
  <data key="d1">event</data>
  <data key="d2">Xét duyệt báo giá là giai đoạn lựa chọn nhà cung cấp phù hợp dựa trên yêu cầu về số lượng, chất lượng và giá cả.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955970</data>
  <data key="d6"></data>
</node>
<node id="Lập đơn mua hàng">
  <data key="d0">Lập đơn mua hàng</data>
  <data key="d1">event</data>
  <data key="d2">Lập đơn mua hàng là bước chuẩn bị hồ sơ để đàm phán và ký kết hợp đồng với nhà cung cấp.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955970</data>
  <data key="d6"></data>
</node>
<node id="Tiến hành đặt hàng">
  <data key="d0">Tiến hành đặt hàng</data>
  <data key="d1">event</data>
  <data key="d2">Tiến hành đặt hàng là hoạt động thực hiện theo hợp đồng đã ký với nhà cung cấp.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955971</data>
  <data key="d6"></data>
</node>
<node id="Tiến hành nhận hàng">
  <data key="d0">Tiến hành nhận hàng</data>
  <data key="d1">event</data>
  <data key="d2">Tiến hành nhận hàng bao gồm kiểm tra chất lượng, khối lượng và nhập kho vật tư từ nhà cung cấp.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955971</data>
  <data key="d6"></data>
</node>
<node id="Lập thủ tục thanh toán">
  <data key="d0">Lập thủ tục thanh toán</data>
  <data key="d1">event</data>
  <data key="d2">Lập thủ tục thanh toán là giai đoạn xử lý tài chính dựa trên điều khoản hợp đồng và chuyển hồ sơ lưu trữ.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955971</data>
  <data key="d6"></data>
</node>
<node id="Lập phiếu báo cáo vật tư">
  <data key="d0">Lập phiếu báo cáo vật tư</data>
  <data key="d1">event</data>
  <data key="d2">Lập phiếu báo cáo vật tư là bước thu thập thông tin từ nhà cung cấp để gửi về phòng vật tư.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955971</data>
  <data key="d6"></data>
</node>
<node id="Tổng hợp báo cáo vật tư">
  <data key="d0">Tổng hợp báo cáo vật tư</data>
  <data key="d1">event</data>
  <data key="d2">Tổng hợp báo cáo vật tư là hoạt động tập hợp dữ liệu và chuyển cho phòng kế toán.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955971</data>
  <data key="d6"></data>
</node>
<node id="Lập báo cáo công nợ">
  <data key="d0">Lập báo cáo công nợ</data>
  <data key="d1">event</data>
  <data key="d2">Lập báo cáo công nợ là việc đối soát hóa đơn, chứng từ để xác định khoản phải trả.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777955972</data>
  <data key="d6"></data>
</node>
