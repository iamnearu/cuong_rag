  <data key="d0">Công suất công trình</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Công suất công trình là chỉ tiêu kỹ thuật phản ánh năng lực hoạt động của công trình.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976472</data>
  <data key="d6"></data>
</node>
<node id="Hiệu quả kinh tế">
  <data key="d0">Hiệu quả kinh tế</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Hiệu quả kinh tế là yếu tố đánh giá lợi ích tài chính từ việc xây dựng và khai thác công trình.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976472</data>
  <data key="d6"></data>
</node>
<node id="Thời hạn thu hồi vốn đầu tư">
  <data key="d0">Thời hạn thu hồi vốn đầu tư</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời hạn thu hồi vốn đầu tư là khoảng thời gian cần thiết để hoàn trả chi phí đầu tư cơ bản của công trình.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976473</data>
  <data key="d6"></data>
</node>
<node id="Tự động hóa">
  <data key="d0">Tự động hóa</data>
  <data key="d1">technology</data>
  <data key="d2">Tự động hóa được áp dụng vào các công việc đã cơ giới hóa và trong lĩnh vực lập kế hoạch, quản lý và điều hành sản xuất.&lt;SEP&gt;Tự động hóa là công nghệ được áp dụng để nâng cao hiệu quả sản xuất và quy trình kỹ thuật trong công trình.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983&lt;SEP&gt;chunk-f84d7c1bcd4c33020b90f92ca0e20cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976473</data>
  <data key="d6"></data>
</node>
<node id="Hệ số xây dựng">
  <data key="d0">Hệ số xây dựng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Hệ số xây dựng là chỉ tiêu phản ánh tỷ lệ sử dụng mặt bằng theo quy định tiêu chuẩn.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976473</data>
  <data key="d6"></data>
</node>
<node id="Hồ sơ dự án khả thi">
  <data key="d0">Hồ sơ dự án khả thi</data>
  <data key="d1">product</data>
  <data key="d2">Hồ sơ dự án khả thi bao gồm thuyết minh, tổng mặt bằng, bản vẽ công nghệ, danh mục thiết bị và ước tính mức đầu tư.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976473</data>
  <data key="d6"></data>
</node>
<node id="Mạng lưới giao thông">
  <data key="d0">Mạng lưới giao thông</data>
  <data key="d1">location</data>
  <data key="d2">Mạng lưới giao thông là yếu tố hạ tầng được khảo sát để xác định vị trí xây dựng công trình.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976473</data>
  <data key="d6"></data>
</node>
<node id="Số liệu khảo sát">
  <data key="d0">Số liệu khảo sát</data>
  <data key="d1">data</data>
  <data key="d2">Số liệu khảo sát bao gồm các thông tin địa chất, thời tiết, môi trường và xã hội thu thập để lập báo cáo kinh tế kỹ thuật.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976474</data>
  <data key="d6"></data>
</node>
<node id="Danh mục các loại máy móc, thiết bị">
  <data key="d0">Danh mục các loại máy móc, thiết bị</data>
  <data key="d1">product</data>
  <data key="d2">Danh mục các loại máy móc, thiết bị liệt kê chi tiết thiết bị cần thiết cho từng hạng mục công trình.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976474</data>
  <data key="d6"></data>
</node>
<node id="Hệ thống quản lý chất lượng">
  <data key="d0">Hệ thống quản lý chất lượng</data>
  <data key="d1">technology</data>
  <data key="d2">Hệ thống quản lý chất lượng là công nghệ được áp dụng để đảm bảo tiêu chuẩn trong sản phẩm và quy trình xây dựng.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976474</data>
  <data key="d6"></data>
</node>
<node id="Tổng mặt bằng">
  <data key="d0">Tổng mặt bằng</data>
  <data key="d1">product</data>
  <data key="d2">Tổng mặt bằng là tài liệu thể hiện mối liên hệ giữa các tòa nhà và công trình trong hồ sơ dự án khả thi.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976474</data>
  <data key="d6"></data>
</node>
<node id="Bản vẽ công nghệ">
  <data key="d0">Bản vẽ công nghệ</data>
  <data key="d1">product</data>
  <data key="d2">Bản vẽ công nghệ là thành phần của hồ sơ dự án khả thi, mô tả giải pháp kỹ thuật và thiết kế chi tiết.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976474</data>
  <data key="d6"></data>
</node>
<node id="Giải pháp kiến trúc">
  <data key="d0">Giải pháp kiến trúc</data>
  <data key="d1">product</data>
  <data key="d2">Giải pháp kiến trúc là phương án thiết kế giúp công trình hòa nhập với cảnh quan khu vực.</data>
  <data key="d3">chunk-1c0957d09a459def2e627aa350434983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976475</data>
  <data key="d6"></data>
</node>
<node id="Cong Viec">
  <data key="d0">Cong Viec</data>
  <data key="d1">event</data>
  <data key="d2">Cong Viec là một hoặc tập hợp quá trình lao động cần chi phí thời gian và tài nguyên thi công, được biểu diễn bằng mũi tên liền nét trên SDM.&lt;SEP&gt;Cong Viec là các hoạt động trong dự án, được phân loại theo thời gian bắt đầu sớm hoặc muộn và có giá trị dự trữ riêng.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976475</data>
  <data key="d6"></data>
</node>
<node id="Su Cho Doi">
  <data key="d0">Su Cho Doi</data>
  <data key="d1">event</data>
  <data key="d2">Su Cho Doi là quá trình thi công cần chi phí thời gian nhưng không cần tài nguyên, được biểu diễn bằng mũi tên liền nét với chỉ dẫn về thời hạn và tên sự chờ đợi.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976475</data>
  <data key="d6"></data>
</node>
<node id="Su Phu Thuoc">
  <data key="d0">Su Phu Thuoc</data>
  <data key="d1">event</data>
  <data key="d2">Su Phu Thuoc là công việc ảo không có thời gian và chi phí tài nguyên, biểu thị mối phụ thuộc giữa các công tác.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976475</data>
  <data key="d6"></data>
</node>
<node id="Su Kien">
  <data key="d0">Su Kien</data>
  <data key="d1">event</data>
  <data key="d2">Su Kien là mốc đánh dấu sự bắt đầu hoặc kết thúc của một hoặc vài công việc, được biểu diễn bằng vòng tròn có danh số thứ tự trên SDM.&lt;SEP&gt;Su Kien là các mốc thời gian trong sơ đồ mạng (SDM), được phân loại thành bắt đầu sớm (Ts) hoặc muộn (T") và liên kết với các công việc.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976475</data>
  <data key="d6"></data>
</node>
<node id="Duong Trong SDM">
  <data key="d0">Duong Trong SDM</data>
  <data key="d1">other</data>
  <data key="d2">Duong Trong SDM là chuỗi liên tục các công việc theo hướng xác định, chiều dài đường bằng tổng thời gian thực hiện các công việc đó.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976476</data>
  <data key="d6"></data>
</node>
<node id="Duong Lien Truoc Su Kien">
  <data key="d0">Duong Lien Truoc Su Kien</data>
  <data key="d1">other</data>
  <data key="d2">Duong Lien Truoc Su Kien là dãy liên tục các công việc đi từ sự kiện khởi công đến sự kiện cụ thể, ví dụ đường 0-1-3-4-5.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976476</data>
  <data key="d6"></data>
</node>
<node id="Duong Lien Sau Su Kien">
  <data key="d0">Duong Lien Sau Su Kien</data>
  <data key="d1">other</data>
  <data key="d2">Duong Lien Sau Su Kien là dãy liên tục các công việc đi từ sự kiện cụ thể đến sự kiện kết thúc SDM, ví dụ đường 5-6 hoặc 2-4-6.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976476</data>
  <data key="d6"></data>
</node>
<node id="Vong Tron">
  <data key="d0">Vong Tron</data>
  <data key="d1">other</data>
  <data key="d2">Vong Tron là hình tròn được sử dụng để biểu diễn sự kiện trên SDM, đánh dấu mốc bắt đầu hoặc kết thúc công việc.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976476</data>
  <data key="d6"></data>
</node>
<node id="Moc Bat Dau">
  <data key="d0">Moc Bat Dau</data>
  <data key="d1">event</data>
  <data key="d2">Moc Bat Dau là sự kiện không có công việc liên trước, đánh dấu điểm khởi công trong SDM.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976476</data>
  <data key="d6"></data>
</node>
<node id="Moc Ket Thuc">
  <data key="d0">Moc Ket Thuc</data>
  <data key="d1">event</data>
  <data key="d2">Moc Ket Thuc là sự kiện không có công việc liên sau, đánh dấu điểm hoàn thành cuối cùng của SDM.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976477</data>
  <data key="d6"></data>
</node>
<node id="Cong Tac Ao">
  <data key="d0">Cong Tac Ao</data>
  <data key="d1">event</data>
  <data key="d2">Cong Tac Ao là công việc ảo không có thời gian và chi phí tài nguyên, biểu thị mối phụ thuộc giữa các công tác.</data>
  <data key="d3">chunk-af988bfa782fe5c128656033538b879b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976478</data>
  <data key="d6"></data>
</node>
<node id="Chiéu dài 11">
  <data key="d0">Chiéu dài 11</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chiéu dài 11 là độ dài của đường gang trong sơ đồ mạng, được xác định là 11 đơn vị thời gian.</data>
  <data key="d3">chunk-058ade2f6cec483b7da16baae1207034</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976478</data>
