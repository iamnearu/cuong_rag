  <data key="d0">Bước 9</data>
  <data key="d1">other</data>
  <data key="d2">Bước 9 là bước chuyển SDM sang trục thời gian để phục vụ quan sát và các mục đích tiếp theo.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
