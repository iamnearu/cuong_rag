  <data key="d1">financial_metric</data>
  <data key="d2">Chỉ số mức độ nghiêm trọng là thước đo tác động của thiết bị đến mục tiêu hệ thống, được phân loại từ 1 đến 10.</data>
  <data key="d3">chunk-3edab69dc20e549a181dcd4774d908a1</data>
