</node>
<node id="Cong nghe san xuat">
  <data key="d0">Cong nghe san xuat</data>
  <data key="d1">technology</data>
  <data key="d2">Cong nghe san xuat là công nghệ cụ thể được sử dụng trong sản xuất, ảnh hưởng đến hiệu quả và quy mô dự án.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976598</data>
