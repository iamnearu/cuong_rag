  <data key="d6"></data>
</node>
<node id="Vòng 1">
  <data key="d0">Vòng 1</data>
  <data key="d1">other</data>
  <data key="d2">Vòng 1 là giai đoạn điều chỉnh các chỉ số tổ chức và tối ưu hóa SDM ban đầu để đạt được mục tiêu thi công.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
  <data key="d4">unknown_source</data>
