</node>
<node id="Ước Tính Mức Đầu Tư Xây Dựng">
  <data key="d0">Ước Tính Mức Đầu Tư Xây Dựng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Ước tính mức đầu tư xây dựng là con số dự kiến chi phí cho việc xây dựng công trình.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976421</data>
  <data key="d6"></data>
</node>
<node id="Tổng Mức Đầu Tư Của Dự Án">
  <data key="d0">Tổng Mức Đầu Tư Của Dự Án</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tổng mức đầu tư của dự án là tổng chi phí dự kiến cho toàn bộ dự án xây dựng.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976422</data>
