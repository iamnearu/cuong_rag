  <data key="d0">Thoi Gian Xay Dung</data>
  <data key="d1">date</data>
  <data key="d2">Thoi Gian Xay Dung là khoảng thời gian cần thiết để hoàn thành một công trình xây dựng.</data>
  <data key="d3">chunk-87e5521ef0e8a8b7e322c15ca2b747be</data>
