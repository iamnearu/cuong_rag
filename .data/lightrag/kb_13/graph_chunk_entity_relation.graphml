  <data key="d1">technology</data>
  <data key="d2">Công Nghệ Mới là kết quả từ việc ứng dụng vật liệu mới và cải tiến quy trình.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54</data>
