  <data key="d0">Định Mức Chi Phí Thời Gian</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Định mức chi phí thời gian là tiêu chuẩn tính toán nhu cầu nhân lực theo giờ công.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976413</data>
