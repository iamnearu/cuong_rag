</node>
<node id="Cải Tiến Điều Kiện Làm Việc">
  <data key="d0">Cải Tiến Điều Kiện Làm Việc</data>
  <data key="d1">other</data>
  <data key="d2">Cải tiến điều kiện và môi trường làm việc là yếu tố định tính ảnh hưởng đến năng suất thông qua việc tạo môi trường làm việc hiệu quả.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972711</data>
  <data key="d6"></data>
</node>
