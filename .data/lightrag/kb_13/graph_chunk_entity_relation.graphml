  <data key="d0">Số Giá Trong Một Ca Làm Việc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Số giá trong một ca làm việc là đơn vị tính toán chi phí theo ca.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
