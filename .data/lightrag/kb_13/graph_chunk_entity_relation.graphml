  <data key="d0">A va B</data>
  <data key="d1">organization</data>
  <data key="d2">A va B là hai bên liên quan (chủ đầu tư và nhà xây dựng) phê duyệt tiến độ pháp lệnh của dây chuyền sản xuất.</data>
  <data key="d3">chunk-66eba3c7ab4cdb031287e865cb6b1974</data>
