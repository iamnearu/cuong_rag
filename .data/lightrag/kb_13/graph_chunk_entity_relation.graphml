</node>
<node id="Sự chờ đợi">
  <data key="d0">Sự chờ đợi</data>
  <data key="d1">other</data>
  <data key="d2">Sự chờ đợi là lãng phí khi công nhân hoặc máy móc phải đợi do tắc nghẽn hoặc trì hoãn.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
  <data key="d4">unknown_source</data>
