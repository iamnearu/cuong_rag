<node id="1-3 năm">
  <data key="d0">1-3 năm</data>
  <data key="d1">financial_metric</data>
  <data key="d2">1-3 năm là khoảng thời gian được quy định cho việc phân bổ hoặc thanh toán các khoản chi phí hoặc tài sản.&lt;SEP&gt;1-3 năm là thời hạn phân bổ cho các khoản chi phí lớn như sửa chữa lớn.</data>
  <data key="d3">chunk-00fe331f136c5a09db18cac7106d146e&lt;SEP&gt;chunk-05605dbdcd26b3a979579b62d63a05e1</data>
