<node id="Cân bằng dây chuyền">
  <data key="d0">Cân bằng dây chuyền</data>
  <data key="d1">technology</data>
  <data key="d2">Cân bằng dây chuyền là quy trình thiết kế và phân bổ công việc trên các nơi làm việc để tối ưu hóa hiệu quả sản xuất.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972746</data>
