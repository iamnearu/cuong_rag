  <data key="d0">So toa nha</data>
  <data key="d1">financial_metric</data>
  <data key="d2">So toa nha là số lượng tòa nhà, ảnh hưởng đến số phân đoạn và thời hạn thi công.</data>
  <data key="d3">chunk-30a4d84bc5cbbf436668c4921eae00fe</data>
