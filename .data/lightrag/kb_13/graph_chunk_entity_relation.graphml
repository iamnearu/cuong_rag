  <data key="d1">person</data>
  <data key="d2">Người dùng là đối tượng tham gia phỏng vấn để xác định chỉ số mức độ nghiêm trọng của tài sản.</data>
  <data key="d3">chunk-3edab69dc20e549a181dcd4774d908a1</data>
