<node id="Công thức (3.63)">
  <data key="d0">Công thức (3.63)</data>
  <data key="d1">technology</data>
  <data key="d2">Công thức (3.63) là công cụ để kiểm tra điều kiện không chồng chéo giữa các dây chuyền, được trình bày trong tài liệu của VIETCONS.</data>
  <data key="d3">chunk-7ba3a1041c2f91bbee39db55c9753e23</data>
