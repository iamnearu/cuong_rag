  <data key="d1">technology</data>
  <data key="d2">MBP là mô hình quản trị hiện đại, cần được nghiên cứu và áp dụng.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
