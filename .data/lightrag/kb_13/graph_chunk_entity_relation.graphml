  <data key="d0">Moi lien he FF</data>
  <data key="d1">other</data>
  <data key="d2">Mối liên hệ FF (Finish-Finish) là mối quan hệ giữa thời điểm kết thúc của hai công việc trong sơ đồ mạng.</data>
  <data key="d3">chunk-7f0dec4672a908afd3ec21ee07bb407b</data>
