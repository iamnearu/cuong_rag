  <data key="d0">Chi phí dịch vụ mua ngoài</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí dịch vụ mua ngoài phản ánh chi phí sử dụng dịch vụ bên thứ ba, tăng từ 92,581,400 (30/09/2024) lên 99,818,121 (30/06/2025).&lt;SEP&gt;Chi phí dịch vụ mua ngoài là chi phí cho các dịch vụ bên ngoài, giảm từ 99,818,121 xuống 92,581,400.</data>
  <data key="d3">chunk-59409cbba6bae8aaca8d90d40c24b561&lt;SEP&gt;chunk-d8202aee0978880ad475854146c90711</data>
  <data key="d4">unknown_source</data>
