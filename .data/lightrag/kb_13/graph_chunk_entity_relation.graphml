  <data key="d0">Mệnh giá cổ phiếu</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Mệnh giá cổ phiếu là giá trị danh nghĩa của mỗi cổ phiếu, được quy định ở mức 10.000 VND.&lt;SEP&gt;Mệnh giá cổ phiếu là giá trị danh nghĩa của cổ phiếu, được ghi nhận là 10.000 VND.</data>
  <data key="d3">chunk-59409cbba6bae8aaca8d90d40c24b561&lt;SEP&gt;chunk-d8202aee0978880ad475854146c90711</data>
