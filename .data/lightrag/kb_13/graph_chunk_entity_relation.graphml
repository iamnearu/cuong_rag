  <data key="d0">Tủ lạnh</data>
  <data key="d1">product</data>
  <data key="d2">Sản phẩm được sản xuất theo dây chuyền lắp ráp, phù hợp với bố trí theo sản phẩm.</data>
  <data key="d3">chunk-e0e27eee7c4333b1515a0ba2cc7f3b4d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972602</data>
  <data key="d6"></data>
</node>
