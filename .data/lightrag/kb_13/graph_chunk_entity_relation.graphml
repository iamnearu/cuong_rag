</node>
<node id="Hoạt Động Không Làm Tăng Giá Trị">
  <data key="d0">Hoạt Động Không Làm Tăng Giá Trị</data>
  <data key="d1">concept</data>
  <data key="d2">Hoạt động không làm tăng giá trị là các bước trong quy trình sản xuất không đóng góp trực tiếp vào giá trị sản phẩm.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972751</data>
  <data key="d6"></data>
</node>
<node id="Thời Gian Thực Hiện Cần Thiết">
  <data key="d0">Thời Gian Thực Hiện Cần Thiết</data>
  <data key="d1">concept</data>
  <data key="d2">Thời gian thực hiện cần thiết là khoảng thời gian tối thiểu để hoàn thành một hoặc nhiều chi tiết sản phẩm trong quy trình sản xuất.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972751</data>
  <data key="d6"></data>
</node>
<node id="Công Đoạn Sơn">
  <data key="d0">Công Đoạn Sơn</data>
  <data key="d1">concept</data>
  <data key="d2">Công đoạn sơn là một bước trong quy trình sản xuất bàn, cần 3 tiếng để hoàn thành trước khi chuyển sang công đoạn kế tiếp.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972752</data>
  <data key="d6"></data>
</node>
<node id="Luồng Sản Phẩm Và Thông Tin">
  <data key="d0">Luồng Sản Phẩm Và Thông Tin</data>
  <data key="d1">concept</data>
  <data key="d2">Luồng sản phẩm và thông tin là sự di chuyển của sản phẩm và dữ liệu qua các công đoạn trong quy trình sản xuất.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972752</data>
  <data key="d6"></data>
</node>
<node id="Kiểm Tra Trong Dây Chuyền">
  <data key="d0">Kiểm Tra Trong Dây Chuyền</data>
  <data key="d1">concept</data>
  <data key="d2">Kiểm tra trong dây chuyền là hoạt động do công nhân thực hiện để đảm bảo chất lượng sản phẩm tại công đoạn của họ.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972752</data>
  <data key="d6"></data>
</node>
<node id="Kiểm Soát Tại Nguồn">
  <data key="d0">Kiểm Soát Tại Nguồn</data>
  <data key="d1">concept</data>
  <data key="d2">Kiểm soát tại nguồn là phương pháp xác định nguyên nhân gốc rễ của khuyết tật thay vì chỉ tìm lỗi sản phẩm.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972752</data>
  <data key="d6"></data>
</node>
<node id="Quy Trình Sản Xuất Tinh Gọn">
  <data key="d0">Quy Trình Sản Xuất Tinh Gọn</data>
  <data key="d1">concept</data>
  <data key="d2">Quy trình sản xuất tinh gọn là phương pháp loại bỏ lãng phí và tối ưu hóa hiệu suất sản xuất.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972752</data>
  <data key="d6"></data>
</node>
<node id="Người Giám Sát Trực Tiếp">
  <data key="d0">Người Giám Sát Trực Tiếp</data>
  <data key="d1">person</data>
  <data key="d2">Người giám sát trực tiếp là cá nhân chịu trách nhiệm phát hiện và ngăn chặn lỗi trong quy trình sản xuất.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972753</data>
  <data key="d6"></data>
</node>
<node id="Thiết Bị Tự Động">
  <data key="d0">Thiết Bị Tự Động</data>
  <data key="d1">product</data>
  <data key="d2">Thiết bị tự động là công cụ hỗ trợ phát hiện lỗi và dừng quy trình khi cần thiết.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972753</data>
  <data key="d6"></data>
</node>
