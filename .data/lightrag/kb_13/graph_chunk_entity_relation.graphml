</edge>
<edge source="Công suất" target="Nguyên tắc an toàn lao động">
  <data key="d7">1.0</data>
  <data key="d8">Nguyên tắc an toàn lao động là yếu tố bên ngoài ảnh hưởng đến công suất và tổ chức sản xuất của doanh nghiệp.</data>
  <data key="d9">an toàn,quy định</data>
