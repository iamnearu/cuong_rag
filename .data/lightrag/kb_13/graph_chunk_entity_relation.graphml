</node>
<node id="Luật Lao Động">
  <data key="d0">Luật Lao Động</data>
  <data key="d1">regulation</data>
  <data key="d2">Luật lao động là văn bản pháp lý quy định các tiêu chuẩn tuyển dụng và điều kiện lao động.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
