  <data key="d0">Các Tổ Sản Xuất Chuyên Môn</data>
  <data key="d1">organization</data>
  <data key="d2">Các Tổ Sản Xuất Chuyên Môn là đơn vị được thành lập để thực hiện các quá trình sản xuất thành phần trong dây chuyền xây dựng.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
