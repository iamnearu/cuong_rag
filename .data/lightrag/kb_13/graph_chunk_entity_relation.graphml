  <data key="d1">other</data>
  <data key="d2">Hinh 4.12 là hình minh họa liên quan đến phân loại dự trữ của công việc trong mạng lưới dự án.</data>
  <data key="d3">chunk-759b382482eecf9fe3d181ae21a2fd6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976515</data>
  <data key="d6"></data>
</node>
<node id="Duong Xuyen">
  <data key="d0">Duong Xuyen</data>
  <data key="d1">other</data>
  <data key="d2">Duong Xuyen là khái niệm chỉ đường đi dài nhất trong mạng lưới dự án, ảnh hưởng trực tiếp đến tổng thời hạn thi công.</data>
  <data key="d3">chunk-759b382482eecf9fe3d181ae21a2fd6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976515</data>
  <data key="d6"></data>
</node>
<node id="Thong so thoi gian">
  <data key="d0">Thong so thoi gian</data>
  <data key="d1">other</data>
  <data key="d2">Thong so thoi gian là các thông số mô tả quá trình vận hành dây chuyền sản xuất, bao gồm nhịp, bước, khoảng đoạn và thời hạn.</data>
  <data key="d3">chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
