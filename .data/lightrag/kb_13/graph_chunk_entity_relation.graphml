  <data key="d0">Phương Án Tối Ưu</data>
  <data key="d1">other</data>
  <data key="d2">Phương Án Tối Ưu là giải pháp thi công được lựa chọn dựa trên các tiêu chí như thời gian, chi phí và tài nguyên.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976373</data>
  <data key="d6"></data>
</node>
<node id="Gia Thành">
  <data key="d0">Gia Thành</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Gia Thành là yếu tố then chốt trong cạnh tranh thị trường, được quyết định bởi tổ chức quản lý điều hành.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976374</data>
  <data key="d6"></data>
</node>
