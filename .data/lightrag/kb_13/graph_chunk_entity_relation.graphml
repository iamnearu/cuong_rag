<node id="BHTN">
  <data key="d0">BHTN</data>
  <data key="d1">product</data>
  <data key="d2">BHTN là viết tắt của Bảo hiểm Thất nghiệp, một tổ chức quản lý bảo hiểm thất nghiệp theo quy định pháp luật.&lt;SEP&gt;BHTN (Bảo hiểm thất nghiệp) là một loại hình bảo hiểm được đề cập trong tài liệu.</data>
  <data key="d3">chunk-00fe331f136c5a09db18cac7106d146e&lt;SEP&gt;chunk-05605dbdcd26b3a979579b62d63a05e1</data>
  <data key="d4">unknown_source</data>
