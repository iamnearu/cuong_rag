  <data key="d4">unknown_source</data>
  <data key="d5">1777976496</data>
  <data key="d6"></data>
</node>
<node id="Thời hạn xây dựng">
  <data key="d0">Thời hạn xây dựng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời hạn xây dựng là chỉ tiêu kinh tế kỹ thuật xác định thời gian hoàn thành công trình.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976496</data>
  <data key="d6"></data>
</node>
<node id="Trình độ cơ giới hóa">
  <data key="d0">Trình độ cơ giới hóa</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Trình độ cơ giới hóa là chỉ tiêu kinh tế kỹ thuật đánh giá mức độ sử dụng máy móc trong thi công.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976496</data>
  <data key="d6"></data>
</node>
<node id="Chi phí lao động cho một đơn vị sản phẩm">
  <data key="d0">Chi phí lao động cho một đơn vị sản phẩm</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí lao động cho một đơn vị sản phẩm là chỉ tiêu kinh tế kỹ thuật tính toán chi phí nhân công trên sản phẩm.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976496</data>
  <data key="d6"></data>
</node>
<node id="Công trình tạm, lan trai">
  <data key="d0">Công trình tạm, lan trai</data>
  <data key="d1">product</data>
  <data key="d2">Công trình tạm, lan trai là loại công trình được đề cập trong hồ sơ thiết kế thi công của TKTCTC.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976496</data>
  <data key="d6"></data>
</node>
<node id="Đơn vị nhận thầu">
  <data key="d0">Đơn vị nhận thầu</data>
  <data key="d1">organization</data>
  <data key="d2">Đơn vị nhận thầu là tổ chức chịu trách nhiệm thực hiện thiết kế TKTCTC dưới sự chỉ đạo của kỹ sư trưởng.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976497</data>
  <data key="d6"></data>
</node>
<node id="Kỹ sư trưởng">
  <data key="d0">Kỹ sư trưởng</data>
  <data key="d1">person</data>
  <data key="d2">Kỹ sư trưởng là cá nhân giám sát và tham khảo ý kiến từ những người thi công trong quá trình thiết kế TKTCTC.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976497</data>
  <data key="d6"></data>
</node>
<node id="Kỹ sư và cán bộ kỹ thuật có kinh nghiệm">
  <data key="d0">Kỹ sư và cán bộ kỹ thuật có kinh nghiệm</data>
  <data key="d1">organization</data>
  <data key="d2">Kỹ sư và cán bộ kỹ thuật có kinh nghiệm là đội ngũ thuộc đơn vị nhận thầu thực hiện thiết kế TKTCTC.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976497</data>
  <data key="d6"></data>
</node>
<node id="2 tháng trước ngày khởi công">
  <data key="d0">2 tháng trước ngày khởi công</data>
  <data key="d1">date</data>
  <data key="d2">2 tháng trước ngày khởi công là thời gian yêu cầu hoàn thành thiết kế TKTCTC để kỹ thuật nghiên cứu và làm quen.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976497</data>
  <data key="d6"></data>
</node>
<node id="Tài Nguyên Thu Hồi">
  <data key="d0">Tài Nguyên Thu Hồi</data>
  <data key="d1">other</data>
  <data key="d2">Tài nguyên thu hồi là tài nguyên không thay đổi số lượng trong quá trình sử dụng, bao gồm nhân lực, cán bộ kỹ thuật, máy móc, thiết bị và cơ sở sản xuất phụ trợ.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976497</data>
  <data key="d6"></data>
</node>
<node id="Tài Nguyên Không Thu Hồi">
  <data key="d0">Tài Nguyên Không Thu Hồi</data>
  <data key="d1">other</data>
  <data key="d2">Tài nguyên không thu hồi là tài nguyên thay đổi khối lượng trong quá trình sử dụng, ví dụ vật liệu, nhiên liệu, thành phẩm, cấu kiện và tiền vốn.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976498</data>
  <data key="d6"></data>
</node>
<node id="Nhân Lực">
  <data key="d0">Nhân Lực</data>
  <data key="d1">product</data>
  <data key="d2">Nhân lực là một loại tài nguyên thu hồi, không thay đổi số lượng trong quá trình sử dụng.&lt;SEP&gt;Nhân lực là tài nguyên chủ đạo trong sản xuất xây dựng, ảnh hưởng trực tiếp đến tiến độ và phân bổ các tài nguyên khác.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4&lt;SEP&gt;chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976498</data>
  <data key="d6"></data>
</node>
<node id="Tiền Vốn">
  <data key="d0">Tiền Vốn</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tiền vốn là tài nguyên không thu hồi, biến đổi trực tiếp theo khối lượng sản phẩm tạo ra.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976498</data>
  <data key="d6"></data>
</node>
<node id="Công Việc Hoàn Thành">
  <data key="d0">Công Việc Hoàn Thành</data>
  <data key="d1">other</data>
  <data key="d2">Công việc hoàn thành là yếu tố ảnh hưởng đến khối lượng tài nguyên không thu hồi, vì khối lượng tài nguyên biến đổi tỷ lệ thuận với khối lượng công việc hoàn thành.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976498</data>
  <data key="d6"></data>
</node>
<node id="Cường Độ Sử Dụng">
  <data key="d0">Cường Độ Sử Dụng</data>
  <data key="d1">other</data>
  <data key="d2">Cường độ sử dụng là chỉ số đo mức độ tiêu thụ tài nguyên tại thời điểm t, được ký hiệu là R;(t) trong công thức.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976498</data>
  <data key="d6"></data>
</node>
<node id="Khối Lượng Hiện Có">
  <data key="d0">Khối Lượng Hiện Có</data>
  <data key="d1">other</data>
  <data key="d2">Khối lượng hiện có là số lượng tài nguyên tồn tại tại thời điểm t, được ký hiệu là H,(t) trong công thức.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976498</data>
  <data key="d6"></data>
</node>
<node id="Hình 4.31">
  <data key="d0">Hình 4.31</data>
  <data key="d1">product</data>
  <data key="d2">Hình 4.31 là biểu đồ minh họa mối quan hệ giữa cung và tiêu thụ tài nguyên trong quá trình sản xuất.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976499</data>
  <data key="d6"></data>
</node>
<node id="Bài Toán Tối Ưu">
  <data key="d0">Bài Toán Tối Ưu</data>
  <data key="d1">other</data>
  <data key="d2">Bài toán tối ưu là vấn đề nghiên cứu nhằm phân bổ tài nguyên hiệu quả, giảm thiểu sai phương của biến động sử dụng so với trung bình.</data>
  <data key="d3">chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976499</data>
  <data key="d6"></data>
</node>
<node id="Bang 4.2">
  <data key="d0">Bang 4.2</data>
  <data key="d1">product</data>
  <data key="d2">Bang 4.2 là một bảng liệt kê các công việc với thời gian thực hiện và mối quan hệ phụ thuộc, được sử dụng trong quá trình lập SDM.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976499</data>
  <data key="d6"></data>
</node>
<node id="Hinh 4.9a">
  <data key="d0">Hinh 4.9a</data>
  <data key="d1">product</data>
  <data key="d2">Hinh 4.9a là một sơ đồ minh họa cách lập sơ đồ mạng, thể hiện các công việc và mối liên hệ ban đầu.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976499</data>
  <data key="d6"></data>
</node>
<node id="Hinh 4.9b">
  <data key="d0">Hinh 4.9b</data>
  <data key="d1">product</data>
  <data key="d2">Hinh 4.9b là sơ đồ mạng sau khi được điều chỉnh và tính toán thời gian thực hiện.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976500</data>
  <data key="d6"></data>
</node>
<node id="Hinh 4.10">
  <data key="d0">Hinh 4.10</data>
  <data key="d1">product</data>
  <data key="d2">Hinh 4.10 là sơ đồ minh họa các thông số của sự kiện trong SDM.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976500</data>
  <data key="d6"></data>
</node>
<node id="Hinh 4.11">
  <data key="d0">Hinh 4.11</data>
  <data key="d1">product</data>
  <data key="d2">Hinh 4.11 là sơ đồ minh họa sự kiện i trong sơ đồ mạng.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976500</data>
  <data key="d6"></data>
</node>
<node id="Thong so su kien">
  <data key="d0">Thong so su kien</data>
  <data key="d1">technology</data>
  <data key="d2">Thong so su kien là các thông số kỹ thuật liên quan đến sự kiện trong sơ đồ mạng SDM, bao gồm thời điểm sớm và các công thức tính toán.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976500</data>
  <data key="d6"></data>
</node>
<node id="Buoc 1l">
  <data key="d0">Buoc 1l</data>
  <data key="d1">event</data>
  <data key="d2">Buoc 1l là bước chuyển đổi SDM sang dạng biểu đồ ngang để thuận tiện cho việc sử dụng, đặc biệt trong trường hợp điều hành tiến độ.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976501</data>
  <data key="d6"></data>
</node>
<node id="Buoc 12">
  <data key="d0">Buoc 12</data>
  <data key="d1">event</data>
  <data key="d2">Buoc 12 là bước lập biểu đồ cung ứng tài nguyên, đảm bảo tiến độ thực thi theo kế hoạch đã đề ra.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976501</data>
  <data key="d6"></data>
</node>
<node id="Thoi diem som cua su kien">
  <data key="d0">Thoi diem som cua su kien</data>
  <data key="d1">concept</data>
  <data key="d2">Thoi diem som cua su kien là thời điểm sự kiện có thể xảy ra sớm nhất, được xác định bằng độ dài của con đường dài nhất từ sự kiện đầu đến sự kiện đang xét.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976501</data>
  <data key="d6"></data>
</node>
<node id="TT">
  <data key="d0">TT</data>
  <data key="d1">product</data>
  <data key="d2">TT là cột đánh số thứ tự trong bảng liệt kê các công việc của SDM, nhưng thiếu giá trị cho công việc EX.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976501</data>
  <data key="d6"></data>
</node>
<node id="X1">
  <data key="d0">X1</data>
  <data key="d1">event</data>
  <data key="d2">X1 là một công việc trong SDM, có thời gian thực hiện 1 đơn vị và bắt đầu ngay.&lt;SEP&gt;X1 là một công việc trong phương pháp SDM với thời gian thực hiện 2 đơn vị.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976502</data>
  <data key="d6"></data>
</node>
<node id="X2">
  <data key="d0">X2</data>
  <data key="d1">event</data>
  <data key="d2">X2 là một công việc trong SDM, có thời gian thực hiện 2 đơn vị và bắt đầu ngay.&lt;SEP&gt;X2 là một công việc trong phương pháp SDM với thời gian thực hiện 1 đơn vị.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976502</data>
  <data key="d6"></data>
</node>
<node id="EX">
  <data key="d0">EX</data>
  <data key="d1">event</data>
  <data key="d2">EX là một công việc trong SDM, có thời gian thực hiện 5 đơn vị và phụ thuộc vào công việc X1.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976503</data>
  <data key="d6"></data>
</node>
<node id="X4">
  <data key="d0">X4</data>
  <data key="d1">event</data>
  <data key="d2">X4 là một công việc trong SDM, có thời gian thực hiện 3 đơn vị và phụ thuộc vào công việc X1, X2.&lt;SEP&gt;X4 là một công việc trong phương pháp SDM với thời gian thực hiện 4 đơn vị.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976503</data>
  <data key="d6"></data>
</node>
<node id="X5">
  <data key="d0">X5</data>
  <data key="d1">event</data>
  <data key="d2">X5 là một công việc trong SDM, có thời gian thực hiện 5 đơn vị và phụ thuộc vào công việc X1, X2.&lt;SEP&gt;X5 là một công việc trong phương pháp SDM với thời gian thực hiện 5 đơn vị và chênh lệch thông số sớm-muộn lớn.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976503</data>
  <data key="d6"></data>
</node>
<node id="X6">
  <data key="d0">X6</data>
  <data key="d1">event</data>
  <data key="d2">X6 là một công việc trong SDM, có thời gian thực hiện 3 đơn vị và phụ thuộc vào công việc X3, X4.&lt;SEP&gt;X6 là một công việc trong phương pháp SDM với thời gian thực hiện 8 đơn vị.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976503</data>
  <data key="d6"></data>
</node>
<node id="X7">
  <data key="d0">X7</data>
  <data key="d1">event</data>
  <data key="d2">X7 là một công việc trong SDM, có thời gian thực hiện 8 đơn vị (dài nhất) và phụ thuộc vào công việc X5.&lt;SEP&gt;X7 là một công việc trong phương pháp SDM với thời gian thực hiện 4 đơn vị.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb&lt;SEP&gt;chunk-9fb46e99d2d0b9ee7337d1e2f24efb8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976503</data>
  <data key="d6"></data>
</node>
<node id="Con duong dai nhat">
  <data key="d0">Con duong dai nhat</data>
  <data key="d1">concept</data>
  <data key="d2">Con duong dai nhat là khái niệm kỹ thuật trong SDM, xác định thời điểm xảy ra sự kiện sớm nhất thông qua độ dài lớn nhất của các con đường dẫn đến sự kiện.</data>
  <data key="d3">chunk-a09b96f602c3e9532a3ff374a8644bfb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976504</data>
  <data key="d6"></data>
</node>
<node id="Ts. NGUYEN DiNH THAM">
  <data key="d0">Ts. NGUYEN DiNH THAM</data>
  <data key="d1">person</data>
  <data key="d2">Ts. NGUYEN DiNH THAM là tác giả chính của cuốn sách "TO CHUC XAY DUNG", chịu trách nhiệm biên soạn chương 1, 2, 3, mục 4.4.b chương 4 và chương 5.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976504</data>
  <data key="d6"></data>
</node>
<node id="Trung taâm ñaøo taïo xaây döïng VIETCONS">
  <data key="d0">Trung taâm ñaøo taïo xaây döïng VIETCONS</data>
  <data key="d1">organization</data>
  <data key="d2">Trung tâm đào tạo xây dựng VIETCONS là tổ chức xuất bản và quản lý nội dung cuốn sách "TO CHUC XAY DUNG".&lt;SEP&gt;Trung taâm ñaøo taïo xaây döïng VIETCONS là địa điểm đào tạo thuộc tổ chức VIETCONS.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829&lt;SEP&gt;chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976504</data>
  <data key="d6"></data>
</node>
<node id="TO CHUC XAY DUNG">
  <data key="d0">TO CHUC XAY DUNG</data>
  <data key="d1">product</data>
  <data key="d2">TO CHUC XAY DUNG là cuốn sách được chia thành hai tập, tập một về lập kế hoạch, tổ chức và điều hành sản xuất, tập hai về thiết kế và tổ chức mặt bằng thi công.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976504</data>
  <data key="d6"></data>
</node>
<node id="Ks. HOANG MINH HOAI">
  <data key="d0">Ks. HOANG MINH HOAI</data>
  <data key="d1">person</data>
  <data key="d2">Ks. HOANG MINH HOAI là chuyên viên cao cấp thuộc Vụ Chính sách Bộ Xây dựng, đã đóng góp ý kiến cho nội dung cuốn sách.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976504</data>
  <data key="d6"></data>
</node>
<node id="Ths. PHAM DANG KHOA">
  <data key="d0">Ths. PHAM DANG KHOA</data>
  <data key="d1">person</data>
  <data key="d2">Ths. PHAM DANG KHOA là giảng viên Bộ môn Công nghệ và Tổ chức Xây dựng Trường Đại học Xây dựng Hà Nội, đã hỗ trợ xuất bản cuốn sách.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976504</data>
  <data key="d6"></data>
</node>
<node id="Ks. NGUYEN HONG MINH">
  <data key="d0">Ks. NGUYEN HONG MINH</data>
  <data key="d1">person</data>
  <data key="d2">Ks. NGUYEN HONG MINH là cán bộ giảng dạy Bộ môn Công nghệ và Tổ chức Xây dựng Trường Đại học Xây dựng Hà Nội, đã tham gia vào quá trình xuất bản cuốn sách.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976505</data>
  <data key="d6"></data>
</node>
<node id="Bo xay dung Ha Noi">
  <data key="d0">Bo xay dung Ha Noi</data>
  <data key="d1">location</data>
  <data key="d2">Bộ Xây dựng Hà Nội là cơ quan nơi các chuyên gia như Ks. HOANG MINH HOAI, Ths. PHAM DANG KHOA và Ks. NGUYEN HONG MINH làm việc.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976505</data>
  <data key="d6"></data>
</node>
<node id="Vụ Chính sách Bộ Xây Dựng">
  <data key="d0">Vụ Chính sách Bộ Xây Dựng</data>
  <data key="d1">organization</data>
  <data key="d2">Vụ Chính sách Bộ Xây Dựng là đơn vị trực thuộc Bộ Xây Dựng, nơi Ks. HOANG MINH HOAI làm chuyên viên cao cấp.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976505</data>
  <data key="d6"></data>
</node>
<node id="Trường Đại học Xây Dựng Hà Nội">
  <data key="d0">Trường Đại học Xây Dựng Hà Nội</data>
  <data key="d1">organization</data>
  <data key="d2">Trường Đại học Xây Dựng Hà Nội là cơ sở giáo dục nơi Ths. PHAM DANG KHOA và Ks. NGUYEN HONG MINH làm giảng viên.</data>
  <data key="d3">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976505</data>
  <data key="d6"></data>
</node>
<node id="Day chuyen bộ phận">
  <data key="d0">Day chuyen bộ phận</data>
  <data key="d1">product</data>
  <data key="d2">Day chuyen bộ phận là loại dây chuyền đơn giản, tổ chức theo nguyên tắc chuyên môn hóa, sản xuất các công việc hoàn thành như đào đất, xây, cốt thép, đổ bê tông.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976505</data>
  <data key="d6"></data>
</node>
<node id="Bieu do xién">
  <data key="d0">Bieu do xién</data>
  <data key="d1">product</data>
  <data key="d2">Bieu do xién là biểu đồ thể hiện tiến độ dây chuyền, thường được dùng để minh họa các thông số không gian, thời gian và công nghệ.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976506</data>
  <data key="d6"></data>
</node>
<node id="Day chuyen chuyên môn hóa">
  <data key="d0">Day chuyen chuyên môn hóa</data>
  <data key="d1">product</data>
  <data key="d2">Day chuyen chuyên môn hóa là tập hợp các dây chuyền thành phần liên kết qua thông số công nghệ và không gian, sản xuất sản phẩm như kết cấu, phần ngôi nhà hoặc công trình.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976506</data>
  <data key="d6"></data>
</node>
<node id="Công nghệ xây dựng">
  <data key="d0">Công nghệ xây dựng</data>
  <data key="d1">technology</data>
  <data key="d2">Công nghệ xây dựng là yếu tố kỹ thuật được sử dụng để thiết kế và triển khai các dây chuyền sản xuất trong ngành xây dựng.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976506</data>
  <data key="d6"></data>
</node>
<node id="Hinh 3.14">
  <data key="d0">Hinh 3.14</data>
  <data key="d1">product</data>
  <data key="d2">Hinh 3.14 là hình ảnh minh họa cách thể hiện dây chuyền chuyên môn hóa đầy đủ hoặc tóm lược.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976506</data>
  <data key="d6"></data>
</node>
<node id="Hinh 3.15">
  <data key="d0">Hinh 3.15</data>
  <data key="d1">product</data>
  <data key="d2">Hinh 3.15 là hình ảnh minh họa dây chuyền liên hợp.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976506</data>
  <data key="d6"></data>
</node>
<node id="Day chuyen công trình">
  <data key="d0">Day chuyen công trình</data>
  <data key="d1">product</data>
  <data key="d2">Day chuyen công trình là loại dây chuyền kết hợp về tổ chức và công nghệ, sản xuất sản phẩm là một hoặc nhiều công trình xây dựng dân dụng hoặc công nghiệp.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976507</data>
  <data key="d6"></data>
</node>
<node id="Day chuyen lien hop">
  <data key="d0">Day chuyen lien hop</data>
  <data key="d1">product</data>
  <data key="d2">Day chuyen lien hop là loại dây chuyền kết hợp nhiều dây chuyền thành phần, thường được áp dụng ở cấp chỉ đạo kế hoạch.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976507</data>
  <data key="d6"></data>
</node>
<node id="Chu ky công nghệ">
  <data key="d0">Chu ky công nghệ</data>
  <data key="d1">technology</data>
  <data key="d2">Chu ky công nghệ là khái niệm liên quan đến thời gian triển khai các công việc trên một sản phẩm hoặc phân đoạn trong dây chuyền chuyên môn hóa.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976507</data>
  <data key="d6"></data>
</node>
<node id="Sản phẩm xây dựng">
  <data key="d0">Sản phẩm xây dựng</data>
  <data key="d1">product</data>
  <data key="d2">Sản phẩm xây dựng là kết quả đầu ra của các dây chuyền như kết cấu, phần ngôi nhà hoặc công trình hoàn thiện.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976507</data>
  <data key="d6"></data>
</node>
<node id="Tien do">
  <data key="d0">Tien do</data>
  <data key="d1">product</data>
  <data key="d2">Tien do là biểu đồ thể hiện tiến độ thi công dự án.&lt;SEP&gt;Tien do là tiến độ dây chuyền, thường được thể hiện trên biểu đồ xién để minh họa các thông số không gian, thời gian và công nghệ.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e&lt;SEP&gt;chunk-411d24fabcd2a61771e7679e0a74227c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976508</data>
  <data key="d6"></data>
</node>
<node id="Nguyên tắc day chuyen">
  <data key="d0">Nguyên tắc day chuyen</data>
  <data key="d1">concept</data>
  <data key="d2">Nguyên tắc day chuyen là phương pháp tổ chức sản xuất theo nguyên tắc chuyên môn hóa, áp dụng trong dây chuyền bộ phận.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976508</data>
  <data key="d6"></data>
</node>
<node id="Quy mô công trình">
  <data key="d0">Quy mô công trình</data>
  <data key="d1">concept</data>
  <data key="d2">Quy mô công trình là yếu tố ảnh hưởng đến mức độ chuyên môn hóa của dây chuyền bộ phận và tổ chức của đơn vị xây lắp.</data>
  <data key="d3">chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976508</data>
  <data key="d6"></data>
</node>
<node id="Thời điểm sớm">
  <data key="d0">Thời điểm sớm</data>
  <data key="d1">other</data>
  <data key="d2">Thời điểm sớm là thời gian sớm nhất một sự kiện có thể xảy ra, được xác định bằng công thức (4.2) trong văn bản.</data>
  <data key="d3">chunk-1dec1abd253ede439e142793d088ef0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976508</data>
  <data key="d6"></data>
</node>
<node id="Thời điểm muộn">
  <data key="d0">Thời điểm muộn</data>
  <data key="d1">other</data>
  <data key="d2">Thời điểm muộn là thời gian muộn nhất một sự kiện có thể xảy ra mà không ảnh hưởng đến sự kiện cuối cùng, được tính toán theo công thức (4.3).</data>
  <data key="d3">chunk-1dec1abd253ede439e142793d088ef0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976508</data>
  <data key="d6"></data>
</node>
<node id="Du dự của sự kiện">
  <data key="d0">Du dự của sự kiện</data>
  <data key="d1">other</data>
  <data key="d2">Du dự của sự kiện là khoảng thời gian linh hoạt cho phép sự kiện xảy ra sớm hoặc muộn mà không làm chậm tiến độ tổng thể.</data>
  <data key="d3">chunk-1dec1abd253ede439e142793d088ef0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976508</data>
  <data key="d6"></data>
</node>
<node id="Thông số của công việc">
  <data key="d0">Thông số của công việc</data>
  <data key="d1">other</data>
  <data key="d2">Thông số của công việc bao gồm thời gian bắt đầu sớm, thời gian kết thúc muộn và các yếu tố liên quan đến quản lý mạng lưới.</data>
  <data key="d3">chunk-1dec1abd253ede439e142793d088ef0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976509</data>
  <data key="d6"></data>
</node>
<node id="Sự kiện khởi công">
  <data key="d0">Sự kiện khởi công</data>
  <data key="d1">event</data>
  <data key="d2">Sự kiện khởi công là sự kiện đầu tiên trong mạng lưới, từ đó bắt đầu tính toán thời điểm sớm của các sự kiện khác.</data>
  <data key="d3">chunk-1dec1abd253ede439e142793d088ef0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976509</data>
  <data key="d6"></data>
</node>
<node id="Sự kiện cuối cùng">
  <data key="d0">Sự kiện cuối cùng</data>
  <data key="d1">event</data>
  <data key="d2">Sự kiện cuối cùng là sự kiện kết thúc trong mạng lưới, từ đó bắt đầu tính toán thời điểm muộn ngược về các sự kiện trước.</data>
  <data key="d3">chunk-1dec1abd253ede439e142793d088ef0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976509</data>
  <data key="d6"></data>
</node>
<node id="Nghị định của Chính phủ về Quản lý Xây dựng">
  <data key="d0">Nghị định của Chính phủ về Quản lý Xây dựng</data>
  <data key="d1">regulation</data>
  <data key="d2">Nghị định của Chính phủ về Quản lý Xây dựng là văn bản pháp lý quy định thời hạn thi công đối với các công trình do nhà nước quản lý.</data>
  <data key="d3">chunk-ab7434271b1707c34ba0d8a269e732dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976509</data>
  <data key="d6"></data>
</node>
<node id="Hợp đồng giao thầu">
  <data key="d0">Hợp đồng giao thầu</data>
  <data key="d1">other</data>
  <data key="d2">Hợp đồng giao thầu là văn bản pháp lý xác định thời hạn thi công công trình, được sử dụng để điều chỉnh tiến độ và đảm bảo tuân thủ pháp lệnh.</data>
  <data key="d3">chunk-ab7434271b1707c34ba0d8a269e732dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976509</data>
  <data key="d6"></data>
</node>
<node id="Thời hạn pháp lệnh">
  <data key="d0">Thời hạn pháp lệnh</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời hạn pháp lệnh là mốc thời gian bắt buộc do pháp luật hoặc hợp đồng quy định, ảnh hưởng trực tiếp đến tiến độ thi công.</data>
  <data key="d3">chunk-ab7434271b1707c34ba0d8a269e732dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976510</data>
  <data key="d6"></data>
</node>
<node id="Hệ số điều hòa K">
  <data key="d0">Hệ số điều hòa K</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Hệ số điều hòa K là chỉ số đo lường mức độ ổn định của biểu đồ nhân lực, phản ánh sự điều hòa nguồn nhân lực trong quá trình thi công.</data>
  <data key="d3">chunk-ab7434271b1707c34ba0d8a269e732dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976510</data>
  <data key="d6"></data>
</node>
<node id="Hệ số ổn định K2">
  <data key="d0">Hệ số ổn định K2</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Hệ số ổn định K2 là chỉ số đánh giá tính ổn định của biểu đồ nhân lực, hỗ trợ phân tích hiệu quả quản lý nguồn lực.</data>
  <data key="d3">chunk-ab7434271b1707c34ba0d8a269e732dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976510</data>
  <data key="d6"></data>
</node>
<node id="Nt,">
  <data key="d0">Nt,</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Nt, là số công nhân trung bình tính theo công thức (2.12), dùng để đánh giá biểu đồ nhân lực.</data>
  <data key="d3">chunk-ab7434271b1707c34ba0d8a269e732dd</data>
