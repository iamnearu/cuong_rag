<node id="Liên Doanh Liên Kết">
  <data key="d0">Liên Doanh Liên Kết</data>
  <data key="d1">other</data>
  <data key="d2">Liên Doanh Liên Kết là hình thức hợp tác giữa các đơn vị xây dựng hoặc giữa công ty trong nước và đối tác nước ngoài.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54</data>
