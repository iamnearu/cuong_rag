  <data key="d0">Hòan thiện (1)</data>
  <data key="d1">organization</data>
  <data key="d2">Hòan thiện (1) là bộ phận sản xuất, có khối lượng vận chuyển 50 tấn đến In ấn (2), 100 tấn đến Đóng gói (3), và 20 tấn đến Kiểm tra (6).</data>
  <data key="d3">chunk-d057797ec16ef2fc62ed848e229f9d3f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972616</data>
