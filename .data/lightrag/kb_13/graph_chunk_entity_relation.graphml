</edge>
<edge source="Công suất" target="Nhà xưởng">
  <data key="d7">1.0</data>
  <data key="d8">Diện tích mặt bằng và bố trí hạ tầng của nhà xưởng là yếu tố giới hạn hoặc hỗ trợ công suất sản xuất.</data>
  <data key="d9">giới hạn,hạ tầng</data>
