  <data key="d0">Nhà Nước</data>
  <data key="d1">organization</data>
  <data key="d2">Nhà Nước là tổ chức quản lý và điều hành các hoạt động xây dựng thông qua chính sách và quy định.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
