<node id="Biên bản nghiệm thu">
  <data key="d0">Biên bản nghiệm thu</data>
  <data key="d1">product</data>
  <data key="d2">Biên bản nghiệm thu là tài liệu xác nhận chất lượng và khối lượng công việc hoàn thành của nhà thầu phụ.</data>
  <data key="d3">chunk-c164371a2505dc88c4539f83f89ae713</data>
