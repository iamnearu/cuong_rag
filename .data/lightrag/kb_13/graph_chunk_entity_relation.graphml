</node>
<node id="Duyệt chi">
  <data key="d0">Duyệt chi</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Duyệt chi là bước trong quy trình thanh toán, xác nhận việc chi trả tiền cho nhà thầu phụ.</data>
  <data key="d3">chunk-c164371a2505dc88c4539f83f89ae713</data>
