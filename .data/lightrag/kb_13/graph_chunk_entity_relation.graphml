</node>
<node id="Công ty Hoàng Long">
  <data key="d0">Công ty Hoàng Long</data>
  <data key="d1">organization</data>
  <data key="d2">Công ty Hoàng Long là tổ chức có doanh số bán ô tô được sử dụng để minh họa phương pháp hoạch định xu hướng.&lt;SEP&gt;Công ty Hoàng Long là một tổ chức kinh doanh ô tô, được đề cập trong ví dụ về dự báo nhu cầu bán hàng.</data>
  <data key="d3">chunk-3fb7a67aecd6f3725a90baaa088e0e57&lt;SEP&gt;chunk-48cfc4f8a0834f4e070394d72bfe189b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972661</data>
  <data key="d6"></data>
</node>
<node id="Hoạch định xu hướng">
  <data key="d0">Hoạch định xu hướng</data>
  <data key="d1">technology</data>
  <data key="d2">Hoạch định xu hướng là kỹ thuật dự báo nhu cầu dựa trên xu hướng dữ liệu lịch sử, thường sử dụng phương trình tuyến tính.</data>
  <data key="d3">chunk-3fb7a67aecd6f3725a90baaa088e0e57</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972661</data>
  <data key="d6"></data>
</node>
<node id="6 tháng đầu năm">
  <data key="d0">6 tháng đầu năm</data>
  <data key="d1">date</data>
  <data key="d2">6 tháng đầu năm là khoảng thời gian được sử dụng để phân tích doanh số bán ô tô của Công ty Hoàng Long.</data>
  <data key="d3">chunk-3fb7a67aecd6f3725a90baaa088e0e57</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972661</data>
  <data key="d6"></data>
</node>
