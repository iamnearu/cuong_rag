</node>
<node id="Du tru rierg">
  <data key="d0">Du tru rierg</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Du tru rierg là khoảng trống giữa hai sự kiện kết thúc công việc có cùng chỉ số (Z² = Tj - Ts - tij).</data>
  <data key="d3">chunk-fd7552ebff5e023dce24f2886dd9c6af</data>
  <data key="d4">unknown_source</data>
