<edge source="Sơ đồ chuỗi giá trị" target="Sản xuất tinh gọn">
  <data key="d7">2.0</data>
  <data key="d8">Sơ đồ chuỗi giá trị là công cụ phân tích trong sản xuất tinh gọn.&lt;SEP&gt;Sơ đồ chuỗi giá trị được sử dụng trong sản xuất tinh gọn để trực quan hóa luồng sản phẩm và thông tin, hỗ trợ cải tiến quy trình.</data>
  <data key="d9">công cụ,cải tiến hiệu quả,nguyên tắc,phân tích quy trình</data>
  <data key="d10">chunk-86b5b2cb403cf9c9db03446c6dabeed6&lt;SEP&gt;chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1777972775</data>
  <data key="d13"></data>
</edge>
<edge source="5S" target="Sản xuất tinh gọn">
  <data key="d7">2.0</data>
  <data key="d8">5S là phương pháp tổ chức được áp dụng trong sản xuất tinh gọn.&lt;SEP&gt;5S là một trong những công cụ cốt lõi của sản xuất tinh gọn nhằm tối ưu hóa hiệu quả và môi trường làm việc.</data>
  <data key="d9">công cụ,nguyên tắc,phương pháp sản xuất,tổ chức làm việc</data>
  <data key="d10">chunk-86b5b2cb403cf9c9db03446c6dabeed6&lt;SEP&gt;chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1777972774</data>
  <data key="d13"></data>
</edge>
<edge source="5S" target="Năng Suất Tổng Hợp">
  <data key="d7">1.0</data>
  <data key="d8">5S là công nghệ giúp tăng năng suất tổng hợp bằng cách tổ chức không gian làm việc.</data>
  <data key="d9">quản lý 5S,tổ chức</data>
  <data key="d10">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1777972876</data>
  <data key="d13"></data>
</edge>
<edge source="Bảo trì dự phòng" target="Sản xuất tinh gọn">
  <data key="d7">1.0</data>
  <data key="d8">Bảo trì dự phòng được áp dụng trong sản xuất tinh gọn để đảm bảo thiết bị hoạt động ổn định và giảm thời gian dừng máy.</data>
  <data key="d9">bảo trì thiết bị,giảm thiểu sự cố</data>
  <data key="d10">chunk-86b5b2cb403cf9c9db03446c6dabeed6</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1777972774</data>
  <data key="d13"></data>
</edge>
<edge source="Bảo trì sản xuất tổng hợp" target="Sản xuất tinh gọn">
  <data key="d7">1.0</data>
  <data key="d8">Bảo trì sản xuất tổng hợp là thành phần của sản xuất tinh gọn, phân công công nhân trực tiếp tham gia bảo dưỡng thiết bị.</data>
  <data key="d9">bảo trì thiết bị,trách nhiệm công nhân</data>
  <data key="d10">chunk-86b5b2cb403cf9c9db03446c6dabeed6</data>
