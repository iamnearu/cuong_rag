  <data key="d0">An Toàn Lao Động</data>
  <data key="d1">concept</data>
  <data key="d2">An toàn lao động là yêu cầu bắt buộc trong xây dựng nhằm phòng tránh tai nạn lao động nghiêm trọng.</data>
  <data key="d3">chunk-5b849f30ebbea48035f3488b40b43009</data>
