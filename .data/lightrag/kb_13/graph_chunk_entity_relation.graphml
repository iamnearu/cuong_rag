<node id="Lý thuyết quyết định">
  <data key="d0">Lý thuyết quyết định</data>
  <data key="d1">concept</data>
  <data key="d2">Lý thuyết quyết định là phương pháp phân tích để lựa chọn hành động có lợi nhuận, được áp dụng trong hoạch định công suất.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972691</data>
  <data key="d6"></data>
</node>
<node id="Điều kiện chắc chắn">
  <data key="d0">Điều kiện chắc chắn</data>
  <data key="d1">concept</data>
  <data key="d2">Điều kiện chắc chắn là tình huống người ra quyết định biết chắc hậu quả của hành động, ví dụ như gửi tiền tiết kiệm hoặc dự đoán giá nguyên vật liệu.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972691</data>
  <data key="d6"></data>
</node>
<node id="Điều kiện không chắc chắn">
  <data key="d0">Điều kiện không chắc chắn</data>
  <data key="d1">concept</data>
  <data key="d2">Điều kiện không chắc chắn là tình huống người ra quyết định không biết kết quả xảy ra, ví dụ như dự đoán thời tiết hoặc thị trường chứng khoán.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972691</data>
  <data key="d6"></data>
</node>
<node id="Điều kiện rủi ro">
  <data key="d0">Điều kiện rủi ro</data>
  <data key="d1">concept</data>
  <data key="d2">Điều kiện rủi ro là tình huống người ra quyết định không biết chắc kết quả nhưng có thể dự đoán xác suất, ví dụ như dự đoán tỷ lệ chiến thắng của tay vợt.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972691</data>
  <data key="d6"></data>
</node>
<node id="Tối đa hóa lợi nhuận">
  <data key="d0">Tối đa hóa lợi nhuận</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tối đa hóa lợi nhuận là mục tiêu của quyết định dưới điều kiện chắc chắn.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972692</data>
  <data key="d6"></data>
</node>
<node id="Tối đa hóa giá trị tiền tệ mong đợi">
  <data key="d0">Tối đa hóa giá trị tiền tệ mong đợi</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tối đa hóa giá trị tiền tệ mong đợi là phương pháp tiếp cận phổ biến trong quyết định dưới điều kiện rủi ro.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972692</data>
  <data key="d6"></data>
</node>
<node id="Công Suất">
  <data key="d0">Công Suất</data>
  <data key="d1">other</data>
  <data key="d2">Công suất là năng lực sản xuất được hoạch định và khai thác trong doanh nghiệp, ảnh hưởng trực tiếp đến hiệu quả kinh doanh.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972692</data>
  <data key="d6"></data>
</node>
<node id="Phương Án Công Suất">
  <data key="d0">Phương Án Công Suất</data>
  <data key="d1">product</data>
  <data key="d2">Phương án công suất là tập hợp các kế hoạch và chiến lược để xác định quy mô sản xuất tối ưu cho doanh nghiệp.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972692</data>
  <data key="d6"></data>
</node>
<node id="Nguyên Liệu">
  <data key="d0">Nguyên Liệu</data>
  <data key="d1">product</data>
  <data key="d2">Nguyên liệu là yếu tố đầu vào cần thiết cho sản xuất, ảnh hưởng đến quy mô và đặc điểm công suất.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972692</data>
  <data key="d6"></data>
</node>
<node id="Chi Phí Tác Nghiệp">
  <data key="d0">Chi Phí Tác Nghiệp</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí tác nghiệp là các khoản chi phí cần thiết để duy trì và vận hành công suất đã xây dựng.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972693</data>
  <data key="d6"></data>
</node>
<node id="Bảo Dưỡng Máy Móc">
  <data key="d0">Bảo Dưỡng Máy Móc</data>
  <data key="d1">product</data>
  <data key="d2">Bảo dưỡng máy móc là hoạt động duy trì hiệu quả hoạt động của thiết bị sản xuất trong công suất.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972693</data>
  <data key="d6"></data>
</node>
<node id="Thời Gian Thực Hiện">
  <data key="d0">Thời Gian Thực Hiện</data>
  <data key="d1">other</data>
  <data key="d2">Thời gian thực hiện là yếu tố quan trọng trong việc lựa chọn phương án công suất tối ưu.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972693</data>
  <data key="d6"></data>
</node>
<node id="Thu Hồi Vốn">
  <data key="d0">Thu Hồi Vốn</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thu hồi vốn là quá trình lấy lại nguồn tài chính đầu tư vào công suất.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972694</data>
  <data key="d6"></data>
</node>
<node id="Nguồn Nhân Lực">
  <data key="d0">Nguồn Nhân Lực</data>
  <data key="d1">other</data>
  <data key="d2">Nguồn nhân lực là yếu tố ảnh hưởng đến khả năng thực hiện và quản lý công suất.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972694</data>
  <data key="d6"></data>
</node>
<node id="Quản Lý Doanh Nghiệp">
  <data key="d0">Quản Lý Doanh Nghiệp</data>
  <data key="d1">other</data>
  <data key="d2">Quản lý doanh nghiệp là cách thức tổ chức và điều hành để đảm bảo công suất được khai thác hiệu quả.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972694</data>
  <data key="d6"></data>
</node>
<node id="Chế Độ Kế Hoạch Bảo Dưỡng Dự Phòng">
  <data key="d0">Chế Độ Kế Hoạch Bảo Dưỡng Dự Phòng</data>
  <data key="d1">product</data>
  <data key="d2">Chế độ kế hoạch bảo dưỡng dự phòng là phương pháp chủ động duy trì công suất thông qua bảo trì định kỳ.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972694</data>
  <data key="d6"></data>
</node>
<node id="Quy Hoạch Nguyên Liệu">
  <data key="d0">Quy Hoạch Nguyên Liệu</data>
  <data key="d1">other</data>
  <data key="d2">Quy hoạch nguyên liệu là quá trình lên kế hoạch sử dụng nguyên liệu để đảm bảo công suất được khai thác hiệu quả.</data>
  <data key="d3">chunk-65569694f76503e0823056fdf2002e88</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972695</data>
  <data key="d6"></data>
</node>
<node id="Bộ Y tế">
  <data key="d0">Bộ Y tế</data>
  <data key="d1">organization</data>
  <data key="d2">Bộ Y tế là cơ quan ban hành quy định về giới hạn nhiệt độ nơi làm việc không vượt quá 32°C và 40°C.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972695</data>
  <data key="d6"></data>
</node>
<node id="Tiêu chuẩn Việt Nam">
  <data key="d0">Tiêu chuẩn Việt Nam</data>
  <data key="d1">regulation</data>
  <data key="d2">Tiêu chuẩn Việt Nam quy định giới hạn mức ồn tại nơi làm việc theo thời gian làm việc (85 dBA cho 8 giờ, 90 dBA cho 4 giờ, v.v.).</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972695</data>
  <data key="d6"></data>
</node>
<node id="Thùng chứa nhiên liệu">
  <data key="d0">Thùng chứa nhiên liệu</data>
  <data key="d1">product</data>
  <data key="d2">Thùng chứa nhiên liệu là sản phẩm được sản xuất cho tàu con thoi của NASA, với thời gian lao động ban đầu là 400 giờ.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972695</data>
  <data key="d6"></data>
</node>
<node id="NASA">
  <data key="d0">NASA</data>
  <data key="d1">organization</data>
  <data key="d2">NASA là tổ chức yêu cầu sản xuất thùng chứa nhiên liệu với tỷ lệ kinh nghiệm 80%.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972695</data>
  <data key="d6"></data>
</node>
<node id="Tổng cục Thống kê">
  <data key="d0">Tổng cục Thống kê</data>
  <data key="d1">organization</data>
  <data key="d2">Tổng cục Thống kê là cơ quan thực hiện chương trình nghiên cứu đánh giá năng suất doanh nghiệp nhỏ.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972696</data>
  <data key="d6"></data>
</node>
<node id="Vốn đầu tư">
  <data key="d0">Vốn đầu tư</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Vốn đầu tư là chỉ tiêu tài chính, tăng từ 15.000 USD lên 18.000 USD.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972696</data>
  <data key="d6"></data>
</node>
<node id="Điện năng">
  <data key="d0">Điện năng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Điện năng là chỉ tiêu năng lượng, giảm từ 180.000 KW xuống 160.750 KW.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972696</data>
  <data key="d6"></data>
</node>
<node id="Năng suất">
  <data key="d0">Năng suất</data>
  <data key="d1">concept</data>
  <data key="d2">Năng suất là khái niệm trung tâm trong văn bản, liên quan đến hiệu quả sản xuất và các yếu tố ảnh hưởng.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869&lt;SEP&gt;chunk-0cd5bbf148baa71362aafce470dd89e6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972696</data>
  <data key="d6"></data>
</node>
<node id="32°C">
  <data key="d0">32°C</data>
  <data key="d1">financial_metric</data>
  <data key="d2">32°C là giới hạn nhiệt độ nơi làm việc theo quy định của Bộ Y tế.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972696</data>
  <data key="d6"></data>
</node>
<node id="40°C">
  <data key="d0">40°C</data>
  <data key="d1">financial_metric</data>
  <data key="d2">40°C là giới hạn nhiệt độ tại khu vực sản xuất nóng theo quy định của Bộ Y tế.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972697</data>
  <data key="d6"></data>
</node>
<node id="85 dBA">
  <data key="d0">85 dBA</data>
  <data key="d1">financial_metric</data>
  <data key="d2">85 dBA là mức ồn tối đa cho phép khi làm việc 8 giờ liên tục theo Tiêu chuẩn Việt Nam.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972697</data>
  <data key="d6"></data>
</node>
<node id="90 dBA">
  <data key="d0">90 dBA</data>
  <data key="d1">financial_metric</data>
  <data key="d2">90 dBA là mức ồn tối đa cho phép khi làm việc 4 giờ liên tục theo Tiêu chuẩn Việt Nam.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972697</data>
  <data key="d6"></data>
</node>
<node id="95 dBA">
  <data key="d0">95 dBA</data>
  <data key="d1">financial_metric</data>
  <data key="d2">95 dBA là mức ồn tối đa cho phép khi làm việc 2 giờ liên tục theo Tiêu chuẩn Việt Nam.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972697</data>
  <data key="d6"></data>
</node>
<node id="100 dBA">
  <data key="d0">100 dBA</data>
  <data key="d1">financial_metric</data>
  <data key="d2">100 dBA là mức ồn tối đa cho phép khi làm việc 1 giờ liên tục theo Tiêu chuẩn Việt Nam.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972697</data>
  <data key="d6"></data>
</node>
<node id="Thời gian tự do hợp lý">
  <data key="d0">Thời gian tự do hợp lý</data>
  <data key="d1">concept</data>
  <data key="d2">Thời gian tự do hợp lý là yếu tố được đề cập trong việc cải thiện năng suất lao động thông qua việc sắp xếp thời gian làm việc linh hoạt.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972698</data>
  <data key="d6"></data>
</node>
<node id="Các tư thế và thao tác làm việc">
  <data key="d0">Các tư thế và thao tác làm việc</data>
  <data key="d1">concept</data>
  <data key="d2">Các tư thế và thao tác làm việc là phương pháp được đề xuất để hợp lý hóa quy trình lao động, góp phần nâng cao hiệu quả sản xuất.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972698</data>
  <data key="d6"></data>
</node>
<node id="Cải tiến điều kiện và môi trường làm việc">
  <data key="d0">Cải tiến điều kiện và môi trường làm việc</data>
  <data key="d1">concept</data>
  <data key="d2">Cải tiến điều kiện và môi trường làm việc là giải pháp quan trọng nhằm ảnh hưởng tích cực đến năng suất lao động.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972698</data>
  <data key="d6"></data>
</node>
<node id="Tỷ lệ kinh nghiệm 80%">
  <data key="d0">Tỷ lệ kinh nghiệm 80%</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tỷ lệ kinh nghiệm 80% là chỉ tiêu được áp dụng trong ví dụ về sản xuất thùng chứa nhiên liệu của NASA, phản ánh sự giảm dần thời gian lao động qua các đơn vị sản xuất.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972698</data>
  <data key="d6"></data>
</node>
<node id="Sản lượng">
  <data key="d0">Sản lượng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Sản lượng là chỉ tiêu đo lường kết quả sản xuất, được phân biệt với năng suất trong câu hỏi 4 của văn bản.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972699</data>
  <data key="d6"></data>
</node>
<node id="Chỉ tiêu đo lường năng suất">
  <data key="d0">Chỉ tiêu đo lường năng suất</data>
  <data key="d1">concept</data>
  <data key="d2">Chỉ tiêu đo lường năng suất là các tiêu chí được đề cập trong câu hỏi 5, dùng để đánh giá hiệu quả hoạt động của doanh nghiệp.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972699</data>
  <data key="d6"></data>
</node>
<node id="Nhiệt độ nơi làm việc">
  <data key="d0">Nhiệt độ nơi làm việc</data>
  <data key="d1">concept</data>
  <data key="d2">Nhiệt độ nơi làm việc là yếu tố ảnh hưởng đến sức khỏe và năng suất lao động, với quy định cụ thể từ Bộ Y tế.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972699</data>
  <data key="d6"></data>
</node>
<node id="Tiếng ồn tại nơi làm việc">
  <data key="d0">Tiếng ồn tại nơi làm việc</data>
  <data key="d1">concept</data>
  <data key="d2">Tiếng ồn tại nơi làm việc là nguyên nhân gây giảm năng suất và ảnh hưởng đến sức khỏe người lao động.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972699</data>
  <data key="d6"></data>
</node>
<node id="Vệ sinh tại nơi làm việc">
  <data key="d0">Vệ sinh tại nơi làm việc</data>
  <data key="d1">concept</data>
  <data key="d2">Vệ sinh tại nơi làm việc là điều kiện quan trọng ảnh hưởng đến chức năng não bộ và các bệnh lý hô hấp.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972700</data>
  <data key="d6"></data>
</node>
<node id="75-85 Dexiben">
  <data key="d0">75-85 Dexiben</data>
  <data key="d1">financial_metric</data>
  <data key="d2">75-85 Dexiben là mức ồn gây giảm 15% năng suất lao động, được nêu trong văn bản.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972700</data>
  <data key="d6"></data>
</node>
<node id="85-95 Dexiben">
  <data key="d0">85-95 Dexiben</data>
  <data key="d1">financial_metric</data>
  <data key="d2">85-95 Dexiben là mức ồn gây giảm 20% năng suất lao động, được nêu trong văn bản.</data>
  <data key="d3">chunk-7d1dfad3e0165df22dcc22198c7eb869</data>
  <data key="d4">unknown_source</data>
