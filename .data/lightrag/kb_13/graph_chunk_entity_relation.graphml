  <data key="d6"></data>
</node>
<node id="Bước 7">
  <data key="d0">Bước 7</data>
  <data key="d1">other</data>
  <data key="d2">Bước 7 là bước xác định các tham số cần thiết của SDM theo quy tắc đã trình bày.</data>
  <data key="d3">chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
  <data key="d4">unknown_source</data>
