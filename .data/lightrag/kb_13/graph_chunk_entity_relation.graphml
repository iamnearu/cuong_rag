  <data key="d0">Nghị Định</data>
  <data key="d1">regulation</data>
  <data key="d2">Nghị Định là văn bản pháp lý do Chính Phủ ban hành để quản lý thời hạn thi công xây dựng.</data>
  <data key="d3">chunk-7dfc32c6d93e918924c330bd1756b4bb</data>
  <data key="d4">unknown_source</data>
