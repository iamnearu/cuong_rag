</node>
<node id="Thoi Gian Du Tru">
  <data key="d0">Thoi Gian Du Tru</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thoi Gian Du Tru là khoảng thời gian linh hoạt của công việc không thuộc đường gang, được biểu thị bằng đoạn nét mạnh trên sơ đồ mạng.</data>
  <data key="d3">chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976529</data>
  <data key="d6"></data>
</node>
<node id="α">
  <data key="d0">α</data>
  <data key="d1">financial_metric</data>
  <data key="d2">α là một chỉ số ảnh hưởng đến sự ổn định và điều hòa của dây chuyền sản xuất, luôn nhỏ hơn 1 và bằng 1 khi m tiến đến vô cùng.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976529</data>
  <data key="d6"></data>
</node>
<node id="β">
  <data key="d0">β</data>
  <data key="d1">financial_metric</data>
  <data key="d2">β là một chỉ số ảnh hưởng đến sự ổn định và điều hòa của dây chuyền sản xuất, luôn nhỏ hơn 1 và bằng 1 khi m tiến đến vô cùng.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976529</data>
  <data key="d6"></data>
</node>
<node id="y">
  <data key="d0">y</data>
  <data key="d1">financial_metric</data>
  <data key="d2">y là chỉ số năng suất của dây chuyền, đo bằng số sản phẩm làm ra trong một đơn vị thời gian.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976529</data>
  <data key="d6"></data>
</node>
<node id="S">
  <data key="d0">S</data>
  <data key="d1">financial_metric</data>
  <data key="d2">S là chỉ số chi phí thời gian cho một sản phẩm, tính bằng thời gian trung bình để làm ra một đơn vị sản phẩm.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976529</data>
  <data key="d6"></data>
</node>
<node id="c">
  <data key="d0">c</data>
  <data key="d1">financial_metric</data>
  <data key="d2">c là hệ số nhân trong việc cân bằng dây chuyền nhip boi bằng cách tăng số công nhân.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976530</data>
  <data key="d6"></data>
</node>
<node id="Dây chuyền nhip nhang">
  <data key="d0">Dây chuyền nhip nhang</data>
  <data key="d1">technology</data>
  <data key="d2">Dây chuyền nhip nhang là loại dây chuyền sản xuất có các thành phần với nhịp độ khác nhau nhưng không có dây chuyền nào là bội số của nhịp nhàng.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976530</data>
  <data key="d6"></data>
</node>
<node id="Dây chuyền nhip boi">
  <data key="d0">Dây chuyền nhip boi</data>
  <data key="d1">technology</data>
  <data key="d2">Dây chuyền nhip boi là loại dây chuyền sản xuất có một số dây chuyền nhip là bội số của nhịp nhàng các dây chuyền khác.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976530</data>
  <data key="d6"></data>
</node>
