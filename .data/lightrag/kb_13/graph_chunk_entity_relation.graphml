  <data key="d0">Công Việc Gộp</data>
  <data key="d1">event</data>
  <data key="d2">Công Việc Gộp là một công việc kết hợp thay thế nhóm công việc khi có sự kiện bắt đầu và kết thúc chung trong sơ đồ mạng SDM.</data>
  <data key="d3">chunk-ff1f9fcb44676bbf9b364d1f1182d15a</data>
