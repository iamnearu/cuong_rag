  <data key="d1">technology</data>
  <data key="d2">Phương pháp tổ chức xây dựng đa chuyên là cách thức tiến hành công việc theo dây chuyền để tối ưu hóa hiệu quả thi công.</data>
  <data key="d3">chunk-5b849f30ebbea48035f3488b40b43009</data>
