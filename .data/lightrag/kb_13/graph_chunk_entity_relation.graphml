  <data key="d1">financial_metric</data>
  <data key="d2">Muc song cua xa hoi là yếu tố được đánh giá để xác định khả năng tiêu thụ sản phẩm tại địa phương và khu vực xuất khẩu.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
