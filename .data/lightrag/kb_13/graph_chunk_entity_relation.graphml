</node>
<node id="Walt Disney">
  <data key="d0">Walt Disney</data>
  <data key="d1">organization</data>
  <data key="d2">Walt Disney là một tổ chức nổi tiếng toàn cầu trong lĩnh vực công viên và khu nghỉ dưỡng, sở hữu nhiều địa điểm như Disney World và Disney Land tại các quốc gia khác nhau.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972640</data>
  <data key="d6"></data>
</node>
<node id="Disney World">
  <data key="d0">Disney World</data>
  <data key="d1">location</data>
  <data key="d2">Disney World là một địa điểm công viên giải trí của Walt Disney tại Florida, tạo ra lợi nhuận 32 tỷ đô la cho tập đoàn vào năm 2007.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972640</data>
  <data key="d6"></data>
</node>
<node id="Disney Land">
  <data key="d0">Disney Land</data>
  <data key="d1">location</data>
  <data key="d2">Disney Land là một công viên giải trí của Walt Disney, có mặt tại Hồng Kông, Pari, và Tokyo.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972640</data>
  <data key="d6"></data>
</node>
<node id="Hồng Kông">
  <data key="d0">Hồng Kông</data>
  <data key="d1">location</data>
  <data key="d2">Hồng Kông là nơi đặt Disney Land, được mở cửa năm 2005.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972641</data>
  <data key="d6"></data>
</node>
<node id="Pari">
  <data key="d0">Pari</data>
  <data key="d1">location</data>
  <data key="d2">Pari là địa điểm của Disney Land, được mở cửa năm 1992.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972641</data>
  <data key="d6"></data>
</node>
<node id="Tokyo">
  <data key="d0">Tokyo</data>
  <data key="d1">location</data>
  <data key="d2">Tokyo là nơi đặt Tokyo Disney Land, được mở cửa năm 1983.</data>
