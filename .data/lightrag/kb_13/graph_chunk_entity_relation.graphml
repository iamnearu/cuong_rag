  <data key="d0">Vật Liệu Nhập Khẩu</data>
  <data key="d1">product</data>
  <data key="d2">Vật liệu nhập khẩu là loại vật liệu cần giảm thiểu tối đa trong thiết kế và thi công công trình.</data>
  <data key="d3">chunk-d451d2038a98e4929b77d5130519747e</data>
  <data key="d4">unknown_source</data>
