  <data key="d0">Thoi Gian Thi Cong Binh Thuong</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thoi Gian Thi Cong Binh Thuong là thời gian thi công bình thường, tương ứng với chi phí trực tiếp tối thiểu.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
