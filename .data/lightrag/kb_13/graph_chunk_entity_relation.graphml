  <data key="d1">other</data>
  <data key="d2">Du tru toan phan Zp (hay Z') là khoảng thời gian lớn nhất có thể trì hoãn bắt đầu hoặc kéo dài thời gian thi công mà không làm thay đổi tổng thời hạn xây dựng công trình.</data>
  <data key="d3">chunk-759b382482eecf9fe3d181ae21a2fd6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976513</data>
  <data key="d6"></data>
</node>
