  <data key="d1">financial_metric</data>
  <data key="d2">Dieu kien kinh te khu vuc là yếu tố phân tích trong quá trình lập dự án, bao gồm nhu cầu xã hội, mạng lưới hạ tầng, nguồn nhân lực.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
