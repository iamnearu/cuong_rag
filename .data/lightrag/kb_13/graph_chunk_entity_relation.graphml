  <data key="d0">Buoc cua day chuyen</data>
  <data key="d1">technology</data>
  <data key="d2">Buoc cua day chuyen là khoảng thời gian giữa bắt đầu dây chuyền (i-1) và dây chuyền i trên phân đoạn đầu tiên, thường chọn là số nguyên của modun chu kỳ.</data>
  <data key="d3">chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976515</data>
