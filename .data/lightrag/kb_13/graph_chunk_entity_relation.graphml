<node id="Khảo Sát">
  <data key="d0">Khảo Sát</data>
  <data key="d1">other</data>
  <data key="d2">Khảo sát là hoạt động thu thập dữ liệu kỹ thuật để hỗ trợ thiết kế và thi công công trình.</data>
  <data key="d3">chunk-d451d2038a98e4929b77d5130519747e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976546</data>
