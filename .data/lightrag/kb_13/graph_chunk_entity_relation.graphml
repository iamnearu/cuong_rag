  <data key="d0">Vật Liệu Địa Phương</data>
  <data key="d1">product</data>
  <data key="d2">Vật liệu địa phương là loại vật liệu được sử dụng tối đa để giảm chi phí và phụ thuộc vào vật liệu nhập khẩu.</data>
  <data key="d3">chunk-d451d2038a98e4929b77d5130519747e</data>
