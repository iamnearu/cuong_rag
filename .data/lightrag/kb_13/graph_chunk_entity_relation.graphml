  <data key="d0">TKTCTC</data>
  <data key="d1">organization</data>
  <data key="d2">TKTCTC là tổ chức thiết kế tổ chức thi công, phục vụ công tác tổ chức thực hiện, chỉ đạo và kiểm tra các giai đoạn thi công công trình.</data>
  <data key="d3">chunk-351f3b7e5be86b74799969a59370207e</data>
