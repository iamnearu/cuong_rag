  <data key="d0">Báo cáo của Mekong Capital tháng 06/2004</data>
  <data key="d1">product</data>
  <data key="d2">Báo cáo của Mekong Capital tháng 06/2004 nêu rõ 36% doanh nghiệp sản xuất ở Mỹ đã triển khai hệ thống sản xuất tinh gọn.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
