  <data key="d1">concept</data>
  <data key="d2">Occasional là phân loại xác suất xảy ra sự cố, biểu thị khả năng thỉnh thoảng trong thời gian hoạt động.</data>
  <data key="d3">chunk-de7780a8198337b611d64243eb4a196b</data>
