</edge>
<edge source="Công suất" target="Tình hình thị trường và mức độ cạnh tranh">
  <data key="d7">1.0</data>
  <data key="d8">Tình hình thị trường và mức độ cạnh tranh là yếu tố bên ngoài cần xem xét khi lựa chọn công suất.</data>
  <data key="d9">cạnh tranh,thị trường</data>
