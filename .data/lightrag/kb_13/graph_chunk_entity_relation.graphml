  <data key="d5">1777976595</data>
  <data key="d6"></data>
</node>
<node id="Khao sat kinh te">
  <data key="d0">Khao sat kinh te</data>
  <data key="d1">event</data>
  <data key="d2">Khao sat kinh te là hoạt động thu thập dữ liệu về điều kiện kinh tế, vị trí, nguồn nguyên liệu, hạ tầng để xác định tính khả thi.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976596</data>
  <data key="d6"></data>
</node>
