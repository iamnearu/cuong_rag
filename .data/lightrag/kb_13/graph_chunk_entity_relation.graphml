  <data key="d1">concept</data>
  <data key="d2">Khái niệm và phân loại công suất là nội dung cơ bản được trình bày trong Chương II, bắt đầu từ trang 25.</data>
  <data key="d3">chunk-bfb09dc2f0322ea84f0381a3d2cccb49</data>
