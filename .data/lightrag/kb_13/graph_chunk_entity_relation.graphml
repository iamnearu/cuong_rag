<node id="Operation Management">
  <data key="d0">Operation Management</data>
  <data key="d1">product</data>
  <data key="d2">Operation Management là cuốn sách của J.Heizer và B. Render được trích dẫn như nguồn tham khảo trong văn bản.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
