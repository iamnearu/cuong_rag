<node id="EMVi">
  <data key="d0">EMVi</data>
  <data key="d1">financial_metric</data>
  <data key="d2">EMVi là giá trị tiền tệ mong đợi của phương án i, được tính bằng xác suất nhân với giá trị mong đợi của từng tình huống.</data>
  <data key="d3">chunk-2edf35ad624ca51dfcca5e087d86aebe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972610</data>
  <data key="d6"></data>
</node>
<node id="Sij">
  <data key="d0">Sij</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Sij là xác suất theo tình huống j của phương án i, sử dụng trong công thức tính giá trị kỳ vọng.</data>
  <data key="d3">chunk-2edf35ad624ca51dfcca5e087d86aebe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972610</data>
