  <data key="d1">product</data>
  <data key="d2">Vật Liệu Mới là loại vật liệu mới xuất hiện, ảnh hưởng đến công nghệ sản xuất.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54</data>
