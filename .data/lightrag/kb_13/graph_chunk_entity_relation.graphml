  <data key="d0">Giảm phế phẩm và sự lãng phí không cần thiết</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Mục tiêu của sản xuất tinh gọn là giảm chi phí liên quan đến phế phẩm và lãng phí.</data>
  <data key="d3">chunk-d2d278979af05972f378b1209c78529e</data>
