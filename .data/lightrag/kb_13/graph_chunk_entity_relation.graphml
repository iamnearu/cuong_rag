  <data key="d0">Chi phí vay</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí vay bao gồm lãi vay và các chi phí liên quan đến việc lập hợp đồng vay, như phí thẩm định, phí kiểm toán.&lt;SEP&gt;Chi phí vay là chi phí phát sinh từ việc vay vốn, bao gồm lãi vay và các chi phí liên quan đến việc quản lý nợ.</data>
  <data key="d3">chunk-87770fe8bdb2cd0294b53c1d6eb782ee&lt;SEP&gt;chunk-e303473f5f442690355a3ca3417f4360</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777970479</data>
  <data key="d6"></data>
</node>
<node id="Vốn hóa chi phí vay">
  <data key="d0">Vốn hóa chi phí vay</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Vốn hóa chi phí vay là việc ghi nhận chi phí vay vào giá trị tài sản khi doanh nghiệp xác định được lợi ích tương lai từ khoản đầu tư.</data>
  <data key="d3">chunk-87770fe8bdb2cd0294b53c1d6eb782ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952837</data>
  <data key="d6"></data>
</node>
<node id="Chi phí hoạt động kỳ trước">
  <data key="d0">Chi phí hoạt động kỳ trước</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí hoạt động kỳ trước là các khoản chi phí đã được vốn hóa nhưng chưa thanh toán trong kỳ kế toán.</data>
  <data key="d3">chunk-87770fe8bdb2cd0294b53c1d6eb782ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952837</data>
  <data key="d6"></data>
</node>
<node id="Giá thị trường">
  <data key="d0">Giá thị trường</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Giá thị trường là giá trị giao dịch của tài sản trên thị trường, được dùng để xác định chênh lệch với giá gốc.</data>
  <data key="d3">chunk-87770fe8bdb2cd0294b53c1d6eb782ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952837</data>
  <data key="d6"></data>
</node>
<node id="Giá gốc">
  <data key="d0">Giá gốc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Giá gốc là chi phí ban đầu để mua hoặc tạo ra tài sản, được so sánh với giá thị trường để tính toán lợi nhuận.</data>
  <data key="d3">chunk-87770fe8bdb2cd0294b53c1d6eb782ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952837</data>
  <data key="d6"></data>
</node>
<node id="THUẬT MÌNH BÁO CÁO TÀI CHÍNH">
  <data key="d0">THUẬT MÌNH BÁO CÁO TÀI CHÍNH</data>
  <data key="d1">regulation</data>
  <data key="d2">THUẬT MÌNH BÁO CÁO TÀI CHÍNH là quy định chuẩn bị báo cáo tài chính, quy định phân loại khoản vay và các chi phí liên quan.</data>
  <data key="d3">chunk-87770fe8bdb2cd0294b53c1d6eb782ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952837</data>
  <data key="d6"></data>
</node>
<node id="Chế độ kế toán">
  <data key="d0">Chế độ kế toán</data>
  <data key="d1">regulation</data>
  <data key="d2">Chế độ kế toán là quy định về phương pháp ghi nhận và xử lý chi phí vay trong báo cáo tài chính.</data>
  <data key="d3">chunk-87770fe8bdb2cd0294b53c1d6eb782ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952838</data>
  <data key="d6"></data>
</node>
