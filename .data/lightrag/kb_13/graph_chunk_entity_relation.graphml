</node>
<node id="Công Thức (2.1)">
  <data key="d0">Công Thức (2.1)</data>
  <data key="d1">other</data>
  <data key="d2">Công thức (2.1) là phương pháp tính toán nhu cầu nhân lực dựa trên khối lượng công việc và định mức.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976415</data>
