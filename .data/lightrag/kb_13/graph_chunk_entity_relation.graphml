<node id="Quy định những ngành nghề không được cấp phép mới trong khu dân cư tập trung">
  <data key="d0">Quy định những ngành nghề không được cấp phép mới trong khu dân cư tập trung</data>
  <data key="d1">regulation</data>
  <data key="d2">Quy định này do Ủy ban nhân dân TP Hồ Chí Minh ban hành theo QD 200/2004/QD-UB, cấm các ngành nghề cụ thể trong khu dân cư.</data>
  <data key="d3">chunk-c62241106864f95b29428820ca88043a</data>
