  <data key="d1">artifact</data>
  <data key="d2">Hình 4.17 là minh họa cụ thể về việc chuyển đổi SDM sang sơ đồ ngang.</data>
  <data key="d3">chunk-fd7552ebff5e023dce24f2886dd9c6af</data>
