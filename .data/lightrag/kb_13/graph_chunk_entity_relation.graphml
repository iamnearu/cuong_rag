  <data key="d1">organization</data>
  <data key="d2">T6 chuc thi cong là tổ chức liên quan đến việc quản lý các khoảng đoạn kỹ thuật trong dây chuyền sản xuất.</data>
  <data key="d3">chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
