  <data key="d1">product</data>
  <data key="d2">Biểu đồ xu hướng là công cụ trực quan thể hiện sự thay đổi của dữ liệu theo thời gian.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972751</data>
