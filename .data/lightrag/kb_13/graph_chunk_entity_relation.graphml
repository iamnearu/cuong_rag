</node>
<node id="Tổ Chức Xây Dựng">
  <data key="d0">Tổ Chức Xây Dựng</data>
  <data key="d1">organization</data>
  <data key="d2">Tổ Chức Xây Dựng là đơn vị chịu trách nhiệm lập kế hoạch và điều phối các công tác thi công.</data>
  <data key="d3">chunk-7dfc32c6d93e918924c330bd1756b4bb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976479</data>
