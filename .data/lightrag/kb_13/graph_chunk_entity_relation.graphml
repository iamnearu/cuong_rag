<node id="Thiết Kế Kỹ Thuật">
  <data key="d0">Thiết Kế Kỹ Thuật</data>
  <data key="d1">event</data>
  <data key="d2">Thiết kế kỹ thuật là giai đoạn đầu trong thiết kế hai giai đoạn, dựa trên cơ sở khảo sát và báo cáo dự án khả thi.</data>
  <data key="d3">chunk-d451d2038a98e4929b77d5130519747e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976545</data>
