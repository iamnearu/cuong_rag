  <data key="d0">Kho hàng B</data>
  <data key="d1">location</data>
  <data key="d2">Kho hàng B là một trong các vị trí được đề cập trong ví dụ, có tọa độ (90, 110) và vận chuyển 1.000 container/tháng.</data>
  <data key="d3">chunk-c62241106864f95b29428820ca88043a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972738</data>
  <data key="d6"></data>
</node>
