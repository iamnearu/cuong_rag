  <data key="d0">Hình 3.25</data>
  <data key="d1">other</data>
  <data key="d2">Hình 3.25 là hình ảnh minh họa một dây chuyền nhip boi.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976530</data>
  <data key="d6"></data>
</node>
<node id="Hình 3.26">
  <data key="d0">Hình 3.26</data>
  <data key="d1">other</data>
  <data key="d2">Hình 3.26 là hình ảnh minh họa cách tổ chức dây chuyền làm việc song song để cân bằng nhịp độ.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976530</data>
  <data key="d6"></data>
</node>
<node id="Quy luật của dây chuyền nhip boi">
  <data key="d0">Quy luật của dây chuyền nhip boi</data>
  <data key="d1">other</data>
  <data key="d2">Quy luật của dây chuyền nhip boi là thời hạn của dây chuyền bị kéo dài do khoảng thời gian Z, tỷ lệ thuận với m.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976531</data>
  <data key="d6"></data>
</node>
<node id="Dây chuyền r">
  <data key="d0">Dây chuyền r</data>
  <data key="d1">technology</data>
  <data key="d2">Dây chuyền r là một dây chuyền sản xuất cụ thể có nhịp bằng 2K trong dây chuyền nhip boi.</data>
  <data key="d3">chunk-314045f67c39e6861fc5155d8bc7d622</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976531</data>
  <data key="d6"></data>
</node>
<node id="Trục thời gian">
  <data key="d0">Trục thời gian</data>
  <data key="d1">technology</data>
  <data key="d2">Trục thời gian là yếu tố trong sơ đồ ngang, biểu diễn thời gian thực hiện các công việc theo trục tọa độ.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976531</data>
  <data key="d6"></data>
</node>
<node id="Sự kiện">
  <data key="d0">Sự kiện</data>
  <data key="d1">event</data>
  <data key="d2">Sự kiện là các mốc trong SDM, xác định thời điểm bắt đầu hoặc kết thúc của các công việc.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976531</data>
  <data key="d6"></data>
</node>
<node id="Thời hạn bắt đầu sớm nhất">
  <data key="d0">Thời hạn bắt đầu sớm nhất</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời hạn bắt đầu sớm nhất là tham số trong SDM xác định thời điểm bắt đầu sớm nhất của công việc, được đo bằng hoành độ đầu mút trái trên trục tọa độ.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976531</data>
  <data key="d6"></data>
</node>
<node id="Thời gian thực hiện">
  <data key="d0">Thời gian thực hiện</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời gian thực hiện là tham số trong SDM xác định khoảng thời gian cần thiết để hoàn thành một công việc, được tính bằng hoành độ đầu mút phải trừ đi hoành độ đầu mút trái.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976532</data>
  <data key="d6"></data>
</node>
<node id="Công việc đồng thời">
  <data key="d0">Công việc đồng thời</data>
  <data key="d1">technology</data>
  <data key="d2">Công việc đồng thời là loại công việc trong SDM có thể thực hiện song song với các công việc khác, được biểu diễn bằng nét song song và đường nét mảnh.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976532</data>
  <data key="d6"></data>
</node>
<node id="Công việc bắt đầu muộn">
  <data key="d0">Công việc bắt đầu muộn</data>
  <data key="d1">technology</data>
  <data key="d2">Công việc bắt đầu muộn là loại công việc trong SDM được đặt ở mốc hoàn thành muộn (T"), thường liên quan đến sự kiện kết thúc dự án.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976532</data>
  <data key="d6"></data>
</node>
