  <data key="d0">06/2004</data>
  <data key="d1">date</data>
  <data key="d2">Ngày 06/2004 là thời điểm báo cáo của Mekong Capital được công bố.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972646</data>
  <data key="d6"></data>
</node>
<node id="1990">
  <data key="d0">1990</data>
  <data key="d1">date</data>
  <data key="d2">Năm 1990 là thời điểm khái niệm "Lean Manufacturing" được giới thiệu trong sách "The Machine that Changed the World".</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972646</data>
  <data key="d6"></data>
</node>
<node id="Lãng phí">
  <data key="d0">Lãng phí</data>
  <data key="d1">concept</data>
  <data key="d2">Lãng phí là các hoạt động không tạo ra giá trị tăng thêm cho khách hàng, được phân loại trong sản xuất tinh gọn.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972646</data>
  <data key="d6"></data>
</node>
<node id="Value-added activities">
  <data key="d0">Value-added activities</data>
  <data key="d1">concept</data>
  <data key="d2">Hoạt động tạo ra giá trị tăng thêm là các bước chuyển hóa nguyên vật liệu thành sản phẩm theo yêu cầu của khách hàng.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972646</data>
  <data key="d6"></data>
</node>
<node id="Non value-added activities">
  <data key="d0">Non value-added activities</data>
  <data key="d1">concept</data>
  <data key="d2">Hoạt động không tạo ra giá trị tăng thêm là các bước không cần thiết trong quá trình sản xuất, được coi là lãng phí.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972647</data>
  <data key="d6"></data>
</node>
<node id="Necessary non value-added activities">
  <data key="d0">Necessary non value-added activities</data>
  <data key="d1">concept</data>
  <data key="d2">Hoạt động cần thiết nhưng không tạo ra giá trị tăng thêm là các bước không thể loại bỏ ngay trong ngắn hạn, ví dụ tồn kho dự phòng.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972647</data>
  <data key="d6"></data>
</node>
