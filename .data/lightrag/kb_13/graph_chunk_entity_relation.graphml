</node>
<node id="Trang Thiết Bị Sản Xuất">
  <data key="d0">Trang Thiết Bị Sản Xuất</data>
  <data key="d1">product</data>
  <data key="d2">Trang thiết bị sản xuất là tài nguyên phụ thuộc vào nhân lực, cần được phân bổ hợp lý trong tiến độ xây dựng.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976598</data>
  <data key="d6"></data>
</node>
<node id="R(t)">
  <data key="d0">R(t)</data>
  <data key="d1">financial_metric</data>
  <data key="d2">R(t) là hàm biểu thị mức sử dụng tài nguyên tại thời điểm t trong quá trình xây dựng.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976599</data>
  <data key="d6"></data>
</node>
<node id="E">
  <data key="d0">E</data>
  <data key="d1">financial_metric</data>
  <data key="d2">E là độ sai phương trung bình của việc sử dụng tài nguyên, được tính toán để tối ưu hóa phân bổ.&lt;SEP&gt;E là một công việc trong dự án, có khởi sự và khởi muộn bằng nhau, không có dự trữ.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3&lt;SEP&gt;chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976599</data>
  <data key="d6"></data>
</node>
<node id="rm">
  <data key="d0">rm</data>
  <data key="d1">financial_metric</data>
  <data key="d2">rm là cường độ sử dụng tài nguyên không đổi trên khoảng thời gian tm.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976599</data>
  <data key="d6"></data>
</node>
<node id="q">
  <data key="d0">q</data>
  <data key="d1">financial_metric</data>
  <data key="d2">q là số khoảng thời gian có cường độ sử dụng tài nguyên r không đổi.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976599</data>
  <data key="d6"></data>
</node>
<node id="Rmax">
  <data key="d0">Rmax</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rmax là giá trị phân tán lớn nhất của tài nguyên, được sử dụng để đánh giá sự biến động trong phân bổ.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976600</data>
  <data key="d6"></data>
</node>
<node id="Rt">
  <data key="d0">Rt</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rt là giá trị trung bình của tài nguyên, liên quan đến chỉ số phân tán và hệ số điều hòa.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976600</data>
  <data key="d6"></data>
</node>
<node id="Hệ Số Điều Hòa">
  <data key="d0">Hệ Số Điều Hòa</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Hệ số điều hòa là chỉ tiêu đánh giá mức độ điều hòa trong phân bổ tài nguyên, được tính toán dựa trên Rmax và Rt.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976600</data>
  <data key="d6"></data>
</node>
<node id="Hệ Số Ổn Định">
  <data key="d0">Hệ Số Ổn Định</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Hệ số ổn định là chỉ tiêu đánh giá sự ổn định của việc sử dụng tài nguyên, liên quan đến Rt và Rmax.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976600</data>
  <data key="d6"></data>
</node>
<node id="Cường Độ Sử Dụng Tài Nguyên">
  <data key="d0">Cường Độ Sử Dụng Tài Nguyên</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cường độ sử dụng tài nguyên là yếu tố quan trọng trong bài toán tối ưu hóa phân bổ tài nguyên.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976600</data>
  <data key="d6"></data>
</node>
<node id="Bài Toán Quy Hoạch Tuyến Tính">
  <data key="d0">Bài Toán Quy Hoạch Tuyến Tính</data>
  <data key="d1">technology</data>
  <data key="d2">Bài toán quy hoạch tuyến tính là phương pháp toán học được áp dụng để giải bài toán tối ưu hóa sử dụng tài nguyên.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976601</data>
  <data key="d6"></data>
</node>
<node id="Tiến Độ Xây Dựng">
  <data key="d0">Tiến Độ Xây Dựng</data>
  <data key="d1">event</data>
  <data key="d2">Tiến độ xây dựng là kế hoạch thời gian thực hiện công trình, cần kết hợp với biểu đồ nhân lực tối ưu.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976601</data>
  <data key="d6"></data>
</node>
<node id="Bài Toán Tối Ưu Hóa Sử Dụng Tài Nguyên">
  <data key="d0">Bài Toán Tối Ưu Hóa Sử Dụng Tài Nguyên</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Bài toán tối ưu hóa sử dụng tài nguyên là vấn đề trung tâm trong quản lý tiến độ và tài nguyên xây dựng.</data>
  <data key="d3">chunk-2f2f9ad2a471c126a0da7b0db761bce3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976601</data>
  <data key="d6"></data>
</node>
<node id="B.D">
  <data key="d0">B.D</data>
  <data key="d1">event</data>
  <data key="d2">B.D là công việc bắt đầu trong dự án, có khởi sự là thời điểm lựa chọn, thường được đặt là 0.</data>
  <data key="d3">chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976601</data>
  <data key="d6"></data>
</node>
<node id="D">
  <data key="d0">D</data>
  <data key="d1">event</data>
  <data key="d2">D là một công việc trong dự án, có một công việc liên trước là B với khởi sự bằng 0 và thời gian tp = 20.</data>
  <data key="d3">chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976602</data>
  <data key="d6"></data>
</node>
<node id="H">
  <data key="d0">H</data>
  <data key="d1">event</data>
  <data key="d2">H là một công việc trong dự án, có khởi sự và khởi muộn bằng nhau, không có dự trữ.</data>
  <data key="d3">chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976602</data>
  <data key="d6"></data>
</node>
<node id="Hình 5.5">
  <data key="d0">Hình 5.5</data>
  <data key="d1">product</data>
  <data key="d2">Hình 5.5 là ví dụ minh họa tính toán SDM nút với quan hệ thuận.</data>
  <data key="d3">chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976602</data>
  <data key="d6"></data>
</node>
<node id="Du tru toan phan">
  <data key="d0">Du tru toan phan</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Du tru toan phan là chỉ số xác định theo công thức (5.7), thể hiện khoảng dự trữ của công việc.</data>
  <data key="d3">chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976603</data>
  <data key="d6"></data>
</node>
<node id="Khối muốn">
  <data key="d0">Khối muốn</data>
  <data key="d1">other</data>
  <data key="d2">Khối muốn là khái niệm trong SDM, xác định thời điểm bắt đầu muộn nhất của công việc để đảm bảo kế hoạch đạt mục tiêu.</data>
  <data key="d3">chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976603</data>
  <data key="d6"></data>
</node>
<node id="Khối sớm">
  <data key="d0">Khối sớm</data>
  <data key="d1">other</data>
  <data key="d2">Khối sớm là khái niệm trong SDM, xác định thời điểm bắt đầu sớm nhất của công việc dựa trên các công việc liên trước.</data>
  <data key="d3">chunk-0a927c5aaa95b93596f4f3d5fdd57303</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976603</data>
  <data key="d6"></data>
</node>
<node id="Sơ đồ GANT">
  <data key="d0">Sơ đồ GANT</data>
  <data key="d1">product</data>
  <data key="d2">Sơ đồ GANT là công cụ biểu diễn tiến độ công trình theo dạng ngang, giúp trực quan hóa và theo dõi các thông số phụ.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976603</data>
  <data key="d6"></data>
</node>
<node id="Tiến độ ban đầu">
  <data key="d0">Tiến độ ban đầu</data>
  <data key="d1">event</data>
  <data key="d2">Tiến độ ban đầu là kế hoạch thời gian xây dựng công trình được lập và điều chỉnh qua nhiều vòng.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976603</data>
  <data key="d6"></data>
</node>
<node id="Vòng điều chỉnh 1">
  <data key="d0">Vòng điều chỉnh 1</data>
  <data key="d1">event</data>
  <data key="d2">Vòng điều chỉnh 1 là giai đoạn điều chỉnh bước lập tiến độ ban đầu bằng cách sắp xếp lại công việc.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976604</data>
  <data key="d6"></data>
</node>
<node id="Vòng điều chỉnh 2">
  <data key="d0">Vòng điều chỉnh 2</data>
  <data key="d1">event</data>
  <data key="d2">Vòng điều chỉnh 2 tập trung vào thay đổi tổ chức sản xuất như số lượng công nhân, máy móc.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976604</data>
  <data key="d6"></data>
</node>
<node id="Vòng điều chỉnh 3">
  <data key="d0">Vòng điều chỉnh 3</data>
  <data key="d1">event</data>
  <data key="d2">Vòng điều chỉnh 3 liên quan đến thay đổi biện pháp thi công hoặc phương án khác.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976604</data>
  <data key="d6"></data>
</node>
<node id="Vòng điều chỉnh 4">
  <data key="d0">Vòng điều chỉnh 4</data>
  <data key="d1">event</data>
  <data key="d2">Vòng điều chỉnh 4 là giai đoạn thay đổi công nghệ sản xuất khi các vòng trước không đạt yêu cầu.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976604</data>
  <data key="d6"></data>
</node>
<node id="Phương pháp lập tiến độ thứ 3 (mức C)">
  <data key="d0">Phương pháp lập tiến độ thứ 3 (mức C)</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp lập tiến độ thứ 3 (mức C) là kỹ thuật được khuyến nghị để sử dụng máy tính hiệu quả trong quản lý tiến độ.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976604</data>
  <data key="d6"></data>
</node>
<node id="Các chương trình phần mềm">
  <data key="d0">Các chương trình phần mềm</data>
  <data key="d1">product</data>
  <data key="d2">Các chương trình phần mềm hiện đại được sử dụng để giải quyết bài toán lập và điều chỉnh tiến độ xây dựng.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976605</data>
  <data key="d6"></data>
</node>
<node id="Dinh muc lao dong">
  <data key="d0">Dinh muc lao dong</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Dinh muc lao dong là chỉ tiêu chi phí lao động để hoàn thành một đơn vị sản phẩm theo định mức hiện hành.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976605</data>
  <data key="d6"></data>
</node>
<node id="Dinh muc may moc">
  <data key="d0">Dinh muc may moc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Dinh muc may moc là chỉ tiêu chi phí giờ máy (nếu thi công có máy) cho đơn vị sản phẩm theo định mức hiện hành.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976605</data>
  <data key="d6"></data>
</node>
<node id="Gia thanh phuong an">
  <data key="d0">Gia thanh phuong an</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Gia thanh phuong an là tiêu chí điều hòa chi phí phương án trong quá trình điều chỉnh tiến độ xây dựng.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976605</data>
  <data key="d6"></data>
</node>
<node id="Ngày công">
  <data key="d0">Ngày công</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Ngày công là đơn vị đo lường nhu cầu lao động trong phần số liệu của sơ đồ GANT.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976605</data>
  <data key="d6"></data>
</node>
<node id="Ca">
  <data key="d0">Ca</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Ca là đơn vị đo lường nhu cầu máy móc trong phần số liệu của sơ đồ GANT.</data>
  <data key="d3">chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976606</data>
