  <data key="d1">technology</data>
  <data key="d2">Ky thuat là yếu tố kỹ thuật gây ra sự hình thành gian đoạn trong dây chuyền sản xuất.</data>
  <data key="d3">chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
  <data key="d4">unknown_source</data>
