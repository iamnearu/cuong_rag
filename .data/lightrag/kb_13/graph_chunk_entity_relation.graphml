  <data key="d0">Danh Mục Máy Móc, Thiết Bị</data>
  <data key="d1">product</data>
  <data key="d2">Danh mục máy móc, thiết bị liệt kê các loại thiết bị cần sử dụng cho từng hạng mục công trình.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
  <data key="d4">unknown_source</data>
