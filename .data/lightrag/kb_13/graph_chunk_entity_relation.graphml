  <data key="d0">Su kien hoan thanh</data>
  <data key="d1">event</data>
  <data key="d2">Su kien hoan thanh là sự kiện đánh dấu thời điểm kết thúc của các công việc trong lịch trình dự án.</data>
  <data key="d3">chunk-759b382482eecf9fe3d181ae21a2fd6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976513</data>
