  <data key="d1">organization</data>
  <data key="d2">Vận chuyển (5) là bộ phận sản xuất, nhận 50 tấn từ Nhận hàng (4).</data>
  <data key="d3">chunk-d057797ec16ef2fc62ed848e229f9d3f</data>
  <data key="d4">unknown_source</data>
