<node id="Lgang">
  <data key="d0">Lgang</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Lgang là chỉ tiêu thời gian cụ thể (ví dụ: 36 ngày, 26 ngày) liên quan đến điều chỉnh sơ đồ mạng.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
