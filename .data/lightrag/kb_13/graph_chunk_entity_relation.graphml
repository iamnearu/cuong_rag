  <data key="d0">Khoảng dự trữ</data>
  <data key="d1">concept</data>
  <data key="d2">Khoảng dự trữ (Z) là thời gian trống hoặc thời gian cần điều chỉnh giữa các day chuyền do sự chênh lệch nhip léch.</data>
  <data key="d3">chunk-665fca972eb05b3a8fc8a159e2839cf4</data>
