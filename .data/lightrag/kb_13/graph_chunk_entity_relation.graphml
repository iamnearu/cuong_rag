<node id="SDM TrEN TRUC THOI GIAN">
  <data key="d0">SDM TrEN TRUC THOI GIAN</data>
  <data key="d1">product</data>
  <data key="d2">SDM TrEN TRUC THOI GIAN là phương pháp chuyển đổi sơ đồ mạng sang trục thời gian để quản lý tiến độ và tài nguyên.</data>
  <data key="d3">chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
