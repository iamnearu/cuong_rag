  <data key="d0">Doanh số máy hút bụi</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Doanh số máy hút bụi là chỉ tiêu phản ánh lượng máy hút bụi bán được hàng tháng tại cửa hàng A.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972718</data>
