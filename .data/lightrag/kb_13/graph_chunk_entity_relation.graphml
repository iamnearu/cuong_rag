  <data key="d1">product</data>
  <data key="d2">Máy điều hòa là sản phẩm được siêu thị điện máy bán, với nhu cầu biến động theo mùa.</data>
  <data key="d3">chunk-48cfc4f8a0834f4e070394d72bfe189b</data>
