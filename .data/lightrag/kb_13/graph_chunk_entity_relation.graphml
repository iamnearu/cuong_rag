</node>
<node id="Công Thức (2.4)">
  <data key="d0">Công Thức (2.4)</data>
  <data key="d1">other</data>
  <data key="d2">Công thức (2.4) là biểu thức xác định biên chế tối ưu cho nhân công và máy móc.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976415</data>
  <data key="d6"></data>
</node>
<node id="Mức Độ Chuyên Môn Hóa">
  <data key="d0">Mức Độ Chuyên Môn Hóa</data>
  <data key="d1">other</data>
  <data key="d2">Mức độ chuyên môn hóa là yếu tố ảnh hưởng đến số lượng công việc và tổ chức thi công.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976415</data>
  <data key="d6"></data>
</node>
<node id="Tổ Chức Thực Hiện">
  <data key="d0">Tổ Chức Thực Hiện</data>
  <data key="d1">other</data>
  <data key="d2">Tổ chức thực hiện là cách sắp xếp công việc và nguồn lực để đảm bảo tiến độ.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976415</data>
  <data key="d6"></data>
</node>
<node id="Biến Pháp Thi Công">
  <data key="d0">Biến Pháp Thi Công</data>
  <data key="d1">other</data>
  <data key="d2">Biến pháp thi công là phương pháp kỹ thuật ảnh hưởng đến môi trường xung quanh.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976416</data>
  <data key="d6"></data>
</node>
<node id="Môi Trường Xung Quanh">
  <data key="d0">Môi Trường Xung Quanh</data>
  <data key="d1">location</data>
  <data key="d2">Môi trường xung quanh là không gian chịu tác động từ các biện pháp thi công.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976416</data>
  <data key="d6"></data>
</node>
<node id="Biểu Thức (2.5)">
  <data key="d0">Biểu Thức (2.5)</data>
  <data key="d1">other</data>
  <data key="d2">Biểu thức (2.5) là công thức xác định số lượng nhân công và máy móc tối đa có thể làm việc bình thường trên phân đoạn.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976417</data>
  <data key="d6"></data>
</node>
<node id="Định Mức Giá Trị Trung Bình">
  <data key="d0">Định Mức Giá Trị Trung Bình</data>
  <data key="d1">other</data>
  <data key="d2">Định mức giá trị trung bình là tiêu chuẩn tính toán cho các công việc kết hợp dựa trên giá trị trung bình của các công việc thành phần.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976417</data>
  <data key="d6"></data>
</node>
<node id="Phân Khu">
  <data key="d0">Phân Khu</data>
  <data key="d1">other</data>
  <data key="d2">Phân khu là phương pháp chia nhỏ công trình để quản lý thi công hiệu quả.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976417</data>
  <data key="d6"></data>
</node>
<node id="Phân Đoạn">
  <data key="d0">Phân Đoạn</data>
  <data key="d1">other</data>
  <data key="d2">Phân đoạn là cách chia công việc thành các phần nhỏ để thực hiện độc lập.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976417</data>
  <data key="d6"></data>
</node>
<node id="Vị Trí Công Tác">
  <data key="d0">Vị Trí Công Tác</data>
  <data key="d1">other</data>
  <data key="d2">Vị trí công tác là địa điểm cụ thể mà máy móc và nhân công thực hiện công việc.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976417</data>
  <data key="d6"></data>
</node>
<node id="Phương Pháp Đường Phần Trăm">
  <data key="d0">Phương Pháp Đường Phần Trăm</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp đường phần trăm là một phương pháp kiểm tra tiến độ công việc, biểu diễn tiến độ dưới dạng phần trăm khối lượng công việc hoàn thành.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976418</data>
  <data key="d6"></data>
</node>
<node id="Hình 2.7">
  <data key="d0">Hình 2.7</data>
  <data key="d1">product</data>
  <data key="d2">Hình 2.7 là hình ảnh minh họa kế hoạch xây dựng công trình và các đường giới hạn tích phân trên, dưới của phương thức đầu tư vốn.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976418</data>
  <data key="d6"></data>
</node>
<node id="Kế Hoạch Xây Dựng">
  <data key="d0">Kế Hoạch Xây Dựng</data>
  <data key="d1">event</data>
  <data key="d2">Kế hoạch xây dựng là quá trình lập và thực hiện tiến độ thi công công trình, đảm bảo thời hạn và giá thành không đổi.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976418</data>
  <data key="d6"></data>
</node>
<node id="Đường Tích Phân">
  <data key="d0">Đường Tích Phân</data>
  <data key="d1">technology</data>
  <data key="d2">Đường tích phân thể hiện tổng vốn đầu tư vào công trình tại các thời điểm trên tiến độ.&lt;SEP&gt;Đường tích phân là biểu diễn trực quan khối lượng công việc đã thực hiện theo thời gian, dùng để so sánh với kế hoạch.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b&lt;SEP&gt;chunk-b29022fe8b5f5d506ad3c3a30a6b4bcd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976418</data>
  <data key="d6"></data>
</node>
<node id="Đường C">
  <data key="d0">Đường C</data>
  <data key="d1">product</data>
  <data key="d2">Đường C là đường giới hạn tích phân trên hoặc dưới trong phương thức đầu tư vốn vào công trình.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976418</data>
  <data key="d6"></data>
</node>
<node id="Giá Thành">
  <data key="d0">Giá Thành</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Giá thành là chỉ tiêu tài chính phản ánh chi phí xây dựng công trình, cần được giữ ổn định trong quá trình thi công.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976419</data>
  <data key="d6"></data>
</node>
<node id="Thời Hạn Thi Công">
  <data key="d0">Thời Hạn Thi Công</data>
  <data key="d1">date</data>
  <data key="d2">Thời hạn thi công là mốc thời gian quy định để hoàn thành công trình, phải được đảm bảo không thay đổi.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976419</data>
  <data key="d6"></data>
</node>
<node id="Đường Vi Phân Đầu Tư Vốn">
  <data key="d0">Đường Vi Phân Đầu Tư Vốn</data>
  <data key="d1">technology</data>
  <data key="d2">Đường vi phân đầu tư vốn là biểu diễn sự thay đổi của vốn đầu tư theo thời gian, ảnh hưởng đến diện tích tích phân.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976419</data>
  <data key="d6"></data>
</node>
<node id="Đường Tích Phân Đầu Tư Hợp Lý">
  <data key="d0">Đường Tích Phân Đầu Tư Hợp Lý</data>
  <data key="d1">technology</data>
  <data key="d2">Đường tích phân đầu tư hợp lý là phương án tối ưu phân bổ vốn để đạt hiệu quả cao nhất trong thi công công trình.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976419</data>
  <data key="d6"></data>
</node>
<node id="Đường 2.6a">
  <data key="d0">Đường 2.6a</data>
  <data key="d1">product</data>
  <data key="d2">Đường 2.6a là đường thẳng trong biểu đồ thể hiện một hình thức đầu tư vốn vào công trình.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976419</data>
  <data key="d6"></data>
</node>
<node id="Đường 2.6b">
  <data key="d0">Đường 2.6b</data>
  <data key="d1">product</data>
  <data key="d2">Đường 2.6b là đường parabol lõm, đại diện cho một phương thức phân bổ vốn đầu tư.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976420</data>
  <data key="d6"></data>
</node>
<node id="Đường 2.6c">
  <data key="d0">Đường 2.6c</data>
  <data key="d1">product</data>
  <data key="d2">Đường 2.6c là đường parabol 16i, mô tả một cách tiếp cận khác trong đầu tư vốn.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976420</data>
  <data key="d6"></data>
</node>
<node id="Giá Trị Cuối Cùng (C)">
  <data key="d0">Giá Trị Cuối Cùng (C)</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Giá trị cuối cùng (C) là chỉ tiêu tài chính chung cho ba hình thức đầu tư, đảm bảo kết quả tương đương.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976420</data>
  <data key="d6"></data>
</node>
<node id="Diện Tích Phần Gạch (T)">
  <data key="d0">Diện Tích Phần Gạch (T)</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Diện tích phần gạch (T) biểu thị mức vốn đầu tư tích lũy vào công trình theo thời gian.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976420</data>
  <data key="d6"></data>
</node>
<node id="Nguy Cơ Chậm Tiến Độ">
  <data key="d0">Nguy Cơ Chậm Tiến Độ</data>
  <data key="d1">concept</data>
  <data key="d2">Nguy cơ chậm tiến độ là rủi ro xảy ra khi đường tích phân có diện tích nhỏ nhất, làm tăng khả năng sai lệch tiến độ.</data>
  <data key="d3">chunk-93e41281f10b500894cdb1ee8516663b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976420</data>
  <data key="d6"></data>
</node>
<node id="Thiết Kế Công Trình Xây Dựng">
  <data key="d0">Thiết Kế Công Trình Xây Dựng</data>
  <data key="d1">event</data>
  <data key="d2">Thiết kế công trình xây dựng là quá trình lập kế hoạch và thiết kế kỹ thuật cho các công trình dân dụng và công nghiệp.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976421</data>
  <data key="d6"></data>
</node>
<node id="Giải Pháp Kiến Trúc">
  <data key="d0">Giải Pháp Kiến Trúc</data>
  <data key="d1">technology</data>
  <data key="d2">Giải pháp kiến trúc là các phương án thiết kế không gian và hình khối công trình.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976421</data>
  <data key="d6"></data>
</node>
<node id="Hệ Thống Thiết Bị">
  <data key="d0">Hệ Thống Thiết Bị</data>
  <data key="d1">product</data>
  <data key="d2">Hệ thống thiết bị bao gồm các thiết bị, máy móc được tích hợp vào công trình.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976421</data>
  <data key="d6"></data>
</node>
