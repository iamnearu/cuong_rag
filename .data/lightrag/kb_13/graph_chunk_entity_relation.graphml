  <data key="d1">product</data>
  <data key="d2">Nguyên Vật Liệu là thành phần cơ bản trong quy trình sản xuất xây dựng.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54</data>
  <data key="d4">unknown_source</data>
