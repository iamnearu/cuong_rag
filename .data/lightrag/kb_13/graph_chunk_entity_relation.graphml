</node>
<node id="Nhân viên cung ứng">
  <data key="d0">Nhân viên cung ứng</data>
  <data key="d1">person</data>
  <data key="d2">Nhân viên cung ứng tham gia vào các bước như xét duyệt báo giá, lập đơn mua hàng và thanh toán.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
  <data key="d4">unknown_source</data>
