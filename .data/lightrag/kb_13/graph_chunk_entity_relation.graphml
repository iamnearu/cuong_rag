  <data key="d1">technology</data>
  <data key="d2">Modun chu ky là khoảng thời gian dùng để mô đun hóa các thông số thời gian, thường là số ngày làm việc.</data>
  <data key="d3">chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
