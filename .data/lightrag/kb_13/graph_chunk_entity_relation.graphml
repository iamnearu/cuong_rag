  <data key="d13"></data>
</edge>
<edge source="TO CHUC XAY DUNG" target="Ks. HOANG MINH HOAI">
  <data key="d7">1.0</data>
  <data key="d8">Ks. HOANG MINH HOAI đã đóng góp ý kiến chuyên môn cho nội dung cuốn sách.</data>
  <data key="d9">phản biện,đóng góp ý kiến</data>
  <data key="d10">chunk-bb678e0e9145828970cec33388a6e829</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1777976767</data>
  <data key="d13"></data>
</edge>
<edge source="TO CHUC XAY DUNG" target="Ths. PHAM DANG KHOA">
  <data key="d7">1.0</data>
  <data key="d8">Ths. PHAM DANG KHOA đã hỗ trợ quá trình xuất bản cuốn sách thông qua công tác giảng dạy.</data>
  <data key="d9">giảng dạy,hỗ trợ xuất bản</data>
  <data key="d10">chunk-bb678e0e9145828970cec33388a6e829</data>
