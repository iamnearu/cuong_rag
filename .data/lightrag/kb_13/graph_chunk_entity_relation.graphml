  <data key="d0">ebook-bao-tri-dua-tren-rui-ro</data>
  <data key="d1">event</data>
  <data key="d2">ebook-bao-tri-dua-tren-rui-ro là chiến dịch marketing hoặc sự kiện được gắn với các liên kết URL, nhằm quảng bá phần mềm bảo trì dựa trên rủi ro.</data>
  <data key="d3">chunk-317d251f7268a14bd52e23a9172394b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777921507</data>
  <data key="d6"></data>
</node>
<node id="Phương Pháp Xác Suất">
  <data key="d0">Phương Pháp Xác Suất</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp xác suất là một kỹ thuật sử dụng các chỉ báo xác suất như thời gian giữa các lần lỗi để gán chỉ số xuất hiện, loại bỏ tính chủ quan trong đánh giá định tính.</data>
  <data key="d3">chunk-3edab69dc20e549a181dcd4774d908a1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777921507</data>
  <data key="d6"></data>
</node>
<node id="Người Quản Lý">
  <data key="d0">Người Quản Lý</data>
  <data key="d1">person</data>
  <data key="d2">Người quản lý là đối tượng tham gia phỏng vấn để xác định chỉ số mức độ nghiêm trọng của tài sản.</data>
  <data key="d3">chunk-3edab69dc20e549a181dcd4774d908a1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777921507</data>
  <data key="d6"></data>
</node>
