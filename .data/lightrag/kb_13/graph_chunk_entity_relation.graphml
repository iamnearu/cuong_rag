</node>
<node id="Không Gian">
  <data key="d0">Không Gian</data>
  <data key="d1">other</data>
  <data key="d2">Không gian là yếu tố liên quan đến vị trí và phân đoạn thi công.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976413</data>
  <data key="d6"></data>
</node>
<node id="Thời Gian">
  <data key="d0">Thời Gian</data>
  <data key="d1">other</data>
  <data key="d2">Thời gian là tham số xác định giai đoạn thi công và đưa công trình vào hoạt động.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
