</node>
<node id="Cong thuc (3.7)">
  <data key="d0">Cong thuc (3.7)</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cong thuc (3.7) là công thức toán học được sử dụng để xác định mối quan hệ giữa các tham số thời gian trong dây chuyền sản xuất.</data>
  <data key="d3">chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
