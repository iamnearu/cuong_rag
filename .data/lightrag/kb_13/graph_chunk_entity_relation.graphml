</node>
<node id="Những khuyết tật">
  <data key="d0">Những khuyết tật</data>
  <data key="d1">other</data>
  <data key="d2">Những khuyết tật là loại lãng phí bao gồm sai sót về giấy tờ, thông tin, giao hàng trễ, sản xuất sai quy cách.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972606</data>
  <data key="d6"></data>
</node>
<node id="Lãng phí về tồn kho">
  <data key="d0">Lãng phí về tồn kho</data>
  <data key="d1">other</data>
  <data key="d2">Lãng phí về tồn kho là việc dự trữ quá mức nguyên vật liệu, bán thành phẩm và thành phẩm.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972606</data>
  <data key="d6"></data>
</node>
<node id="Di chuyển không hợp lý">
  <data key="d0">Di chuyển không hợp lý</data>
  <data key="d1">other</data>
  <data key="d2">Di chuyển không hợp lý là lãng phí do tổ chức công đoạn vận chuyển không hiệu quả.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972606</data>
