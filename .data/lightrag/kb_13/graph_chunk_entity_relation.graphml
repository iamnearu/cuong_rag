  <data key="d0">Bước 3</data>
  <data key="d1">event</data>
  <data key="d2">Bước 3 là xác định các mối quan hệ bắt buộc giữa các công việc.&lt;SEP&gt;Bước 3 là bước xác định các mối quan hệ giữa các công việc, được kiểm tra lại trong Vòng 2.</data>
  <data key="d3">chunk-ff1f9fcb44676bbf9b364d1f1182d15a&lt;SEP&gt;chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
