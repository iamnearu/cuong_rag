  <data key="d0">To chuc xay dung</data>
  <data key="d1">technology</data>
  <data key="d2">Tổ chức xây dựng là phương pháp quản lý và điều hành thi công để đạt hiệu quả kinh tế - kỹ thuật tối ưu.</data>
  <data key="d3">chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976560</data>
  <data key="d6"></data>
</node>
<node id="Co gioi hoa xay dung">
  <data key="d0">Co gioi hoa xay dung</data>
  <data key="d1">technology</data>
  <data key="d2">Cơ giới hóa xây dựng là việc sử dụng thiết bị, máy móc để nâng cao năng suất lao động.</data>
  <data key="d3">chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976560</data>
  <data key="d6"></data>
</node>
<node id="Kinh te xay dung">
  <data key="d0">Kinh te xay dung</data>
  <data key="d1">technology</data>
  <data key="d2">Kinh tế xây dựng là ngành nghiên cứu các yếu tố kinh tế ảnh hưởng đến hiệu quả thi công.</data>
  <data key="d3">chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976560</data>
  <data key="d6"></data>
</node>
<node id="Hop dong giao nhan thau">
  <data key="d0">Hop dong giao nhan thau</data>
  <data key="d1">regulation</data>
  <data key="d2">Hợp đồng giao nhận thầu là văn bản pháp lý quy định trách nhiệm và quyền lợi giữa các bên trong dự án xây dựng.</data>
  <data key="d3">chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976560</data>
  <data key="d6"></data>
</node>
<node id="Cac van ban phap luan">
  <data key="d0">Cac van ban phap luan</data>
  <data key="d1">regulation</data>
  <data key="d2">Các văn bản pháp luận là tài liệu pháp lý xác định thời hạn và mục tiêu thi công công trình.</data>
  <data key="d3">chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976560</data>
  <data key="d6"></data>
</node>
<node id="Cac tieu chuan ky thuat">
  <data key="d0">Cac tieu chuan ky thuat</data>
  <data key="d1">regulation</data>
  <data key="d2">Các tiêu chuẩn kỹ thuật là quy định kỹ thuật do thiết kế quy định, cần đạt để đảm bảo chất lượng công trình.</data>
  <data key="d3">chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976561</data>
  <data key="d6"></data>
</node>
<node id="Lien hop cong trinh">
  <data key="d0">Lien hop cong trinh</data>
  <data key="d1">product</data>
  <data key="d2">Liên hợp công trình là tập hợp các công trình dân dụng và công nghiệp được xây dựng đồng bộ.</data>
  <data key="d3">chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976561</data>
  <data key="d6"></data>
</node>
<node id="Day chuyền">
  <data key="d0">Day chuyền</data>
  <data key="d1">method</data>
  <data key="d2">Day chuyền là phương pháp sản xuất liên tục các phân đoạn trong hệ thống sản xuất.</data>
  <data key="d3">chunk-665fca972eb05b3a8fc8a159e2839cf4</data>
