  <data key="d1">other</data>
  <data key="d2">Tiêu chuẩn đạo đức và trách nhiệm xã hội là yêu cầu trong quản trị sản xuất và tác nghiệp.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
