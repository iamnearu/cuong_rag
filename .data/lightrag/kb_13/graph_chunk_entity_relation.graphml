</node>
<node id="Thu nhập khác">
  <data key="d0">Thu nhập khác</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thu nhập khác là nguồn thu không thuộc hoạt động kinh doanh chính, ghi nhận giá trị 0 trong cả hai giai đoạn.&lt;SEP&gt;Thu nhập khác là các khoản thu không thuộc doanh thu chính, duy trì mức 0 trong cả hai kỳ.</data>
  <data key="d3">chunk-59409cbba6bae8aaca8d90d40c24b561&lt;SEP&gt;chunk-d8202aee0978880ad475854146c90711</data>
