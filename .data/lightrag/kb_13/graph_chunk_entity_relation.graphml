  <data key="d1">financial_metric</data>
  <data key="d2">Gian Tiep Phi là chi phí gián tiếp không trực tiếp liên quan đến thi công, tăng khi thời gian thi công kéo dài.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
