<node id="Đơn Vị Xây Lắp">
  <data key="d0">Đơn Vị Xây Lắp</data>
  <data key="d1">organization</data>
  <data key="d2">Đơn Vị Xây Lắp là tổ chức trực tiếp thực hiện thi công các công trình xây dựng.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976434</data>
  <data key="d6"></data>
</node>
<node id="Duong Gang">
  <data key="d0">Duong Gang</data>
  <data key="d1">technology</data>
  <data key="d2">Duong Gang là đường nối các sự kiện có T" = Tm trong SDM, đại diện cho lộ trình quan trọng nhất của dự án.&lt;SEP&gt;Duong Gang là khái niệm chỉ đường đi trở thành "đường chìa khóa" khi sử dụng hết dự trữ toàn phần Zp.&lt;SEP&gt;Duong Gang là đường dài nhất trong sơ đồ mạng (SDM), đại diện cho chuỗi công việc không có thời gian dự trữ và ảnh hưởng trực tiếp đến tiến độ hoàn thành công trình.&lt;SEP&gt;Duong Gang là khái niệm trong quản lý dự án, đại diện cho chuỗi công việc dài nhất xác định thời gian hoàn thành dự án.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9&lt;SEP&gt;chunk-759b382482eecf9fe3d181ae21a2fd6a&lt;SEP&gt;chunk-5b26e5f5d915c5019f73938c44e862aa&lt;SEP&gt;chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976434</data>
  <data key="d6"></data>
</node>
<node id="Tang Tai Nguyen Thi Cong">
  <data key="d0">Tang Tai Nguyen Thi Cong</data>
  <data key="d1">technology</data>
  <data key="d2">Tang Tai Nguyen Thi Cong là phương pháp rút ngắn thời gian Duong Gang bằng cách tăng nguồn lực thi công mà không ảnh hưởng đến mặt bằng.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976435</data>
  <data key="d6"></data>
</node>
