  <data key="d0">Nhà Hàng</data>
  <data key="d1">organization</data>
  <data key="d2">Nhà Hàng là doanh nghiệp trong lĩnh vực dịch vụ, định vị gần nơi tiêu thụ nhằm thu hút khách hàng.</data>
