  <data key="d0">Phương án 3</data>
  <data key="d1">product</data>
  <data key="d2">Phương án 3 là lựa chọn xây dựng doanh nghiệp công suất lớn, được chọn theo tiêu chí Maximax.</data>
  <data key="d3">chunk-2edf35ad624ca51dfcca5e087d86aebe</data>
