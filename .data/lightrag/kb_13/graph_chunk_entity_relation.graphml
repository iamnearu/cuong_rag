  <data key="d1">product</data>
  <data key="d2">Phương án 2 là lựa chọn xây dựng doanh nghiệp công suất vừa, được chọn theo tiêu chí May rủi ngang nhau và điều kiện rủi ro.</data>
  <data key="d3">chunk-2edf35ad624ca51dfcca5e087d86aebe</data>
  <data key="d4">unknown_source</data>
