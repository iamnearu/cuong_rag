  <data key="d0">Thời gian làm việc trong ngày</data>
  <data key="d1">regulation</data>
  <data key="d2">Thời gian làm việc trong ngày là quy định về thời lượng làm việc theo ca, ảnh hưởng đến xác định thời gian chu kỳ.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972746</data>
  <data key="d6"></data>
</node>
