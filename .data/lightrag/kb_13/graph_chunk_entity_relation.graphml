  <data key="d0">Cơ Quan Tư Vấn Thiết Kế</data>
  <data key="d1">organization</data>
  <data key="d2">Cơ Quan Tư Vấn Thiết Kế là tổ chức chuyên cung cấp dịch vụ thiết kế và tư vấn kỹ thuật xây dựng.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
