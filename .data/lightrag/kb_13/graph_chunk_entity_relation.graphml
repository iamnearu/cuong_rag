<node id="Thoi Gian Thi Cong Khan Truong">
  <data key="d0">Thoi Gian Thi Cong Khan Truong</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thoi Gian Thi Cong Khan Truong là thời gian thi công ngắn nhất có thể đạt được, liên quan đến chi phí trực tiếp tối đa.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
