  <data key="d1">financial_metric</data>
  <data key="d2">AD (độ lệch tuyệt đối) là chỉ tiêu đo lường sai lệch giữa giá trị thực tế và dự báo.</data>
  <data key="d3">chunk-f22c5bf91908df9fb93f0212b963b7b9&lt;SEP&gt;chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
