  <data key="d0">Bước 2: Xác Định Mức Độ Chuyên Môn Hóa</data>
  <data key="d1">event</data>
  <data key="d2">Bước 2 tập trung vào việc xác định mức độ chuyên môn hóa để lập danh mục công việc.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
