  <data key="d0">Bang 3.1 Phan doan</data>
  <data key="d1">event</data>
  <data key="d2">Bang 3.1 Phan doan là bảng dữ liệu dạng ma trận với 5 hàng và 6 cột chưa có nhãn, chứa các giá trị số từ 1 đến 3.</data>
  <data key="d3">chunk-c042ac6b8490137677e2ba4b7d881350</data>
