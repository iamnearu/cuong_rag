  <data key="d0">Thoi han</data>
  <data key="d1">other</data>
  <data key="d2">Thoi han là thời hạn hoàn thành của dây chuyền sản xuất, được xác định thông qua các thông số thời gian.</data>
  <data key="d3">chunk-a256103ab2bd3aa8d7a59ad45d3b068c</data>
