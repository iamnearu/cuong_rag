  <data key="d1">technology</data>
  <data key="d2">Bước 2 trong cân bằng dây chuyền tập trung vào đo lường thời gian thực hiện từng công việc cụ thể.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
