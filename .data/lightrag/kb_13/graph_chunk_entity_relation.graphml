</node>
<node id="Cot 3">
  <data key="d0">Cot 3</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Cot 3 là cột chứa giá trị số liệu được sử dụng trong công thức tính toán cho các cột khác.</data>
  <data key="d3">chunk-eb35d5d5f5c0f7a42dbcd57a80c2159b</data>
