</node>
<node id="Địa điểm E">
  <data key="d0">Địa điểm E</data>
  <data key="d1">location</data>
  <data key="d2">Địa điểm E có tọa độ x=7, y=9 và khối lượng vận chuyển 15 tấn/tháng.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972611</data>
  <data key="d6"></data>
</node>
<node id="Địa điểm F">
  <data key="d0">Địa điểm F</data>
  <data key="d1">location</data>
  <data key="d2">Địa điểm F có tọa độ x=3, y=2 và khối lượng vận chuyển 10 tấn/tháng.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972611</data>
  <data key="d6"></data>
</node>
<node id="Địa điểm G">
  <data key="d0">Địa điểm G</data>
  <data key="d1">location</data>
  <data key="d2">Địa điểm G có tọa độ x=2, y=6 và khối lượng vận chuyển 5 tấn/tháng.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972611</data>
  <data key="d6"></data>
</node>
<node id="Khối lượng vận chuyển hàng tháng">
  <data key="d0">Khối lượng vận chuyển hàng tháng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Khối lượng vận chuyển hàng tháng dao động từ 5 đến 15 tấn, với giá trị cao nhất tại địa điểm C và E.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972612</data>
  <data key="d6"></data>
</node>
<node id="Phương pháp tọa độ trung tâm">
  <data key="d0">Phương pháp tọa độ trung tâm</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp tọa độ trung tâm là kỹ thuật được sử dụng để hỗ trợ định vị doanh nghiệp, trình bày từ trang 47.&lt;SEP&gt;Phương pháp tọa độ trung tâm là kỹ thuật được sử dụng để xác định vị trí trung tâm tối ưu dựa trên tọa độ và khối lượng vận chuyển.&lt;SEP&gt;Phương pháp tọa độ trung tâm được áp dụng để lựa chọn địa điểm kho hàng trung tâm dựa trên tọa độ và khối lượng vận chuyển.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd&lt;SEP&gt;chunk-bfb09dc2f0322ea84f0381a3d2cccb49&lt;SEP&gt;chunk-c62241106864f95b29428820ca88043a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972612</data>
  <data key="d6"></data>
</node>
<node id="Toyota">
  <data key="d0">Toyota</data>
  <data key="d1">organization</data>
  <data key="d2">Toyota là tập đoàn sản xuất ô tô hàng đầu thế giới với triết lý sản xuất tinh gọn (Lean Manufacturing).&lt;SEP&gt;Toyota là công ty ô tô Nhật Bản, nơi hệ thống sản xuất Toyota Production System (TPS) được phát triển và trở thành nền tảng cho sản xuất tinh gọn.&lt;SEP&gt;Toyota là công ty liên quan đến dây chuyền lắp ráp khung gầm xe tải và phương thức sản xuất tinh gọn.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd&lt;SEP&gt;chunk-d2d278979af05972f378b1209c78529e&lt;SEP&gt;chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972612</data>
  <data key="d6"></data>
</node>
<node id="JIT (Just-In-Time)">
  <data key="d0">JIT (Just-In-Time)</data>
  <data key="d1">technology</data>
  <data key="d2">JIT là hệ thống sản xuất "đúng lúc, kịp thời", một cột trụ chính trong triết lý sản xuất của Toyota.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972612</data>
  <data key="d6"></data>
</node>
<node id="Jidoka">
  <data key="d0">Jidoka</data>
  <data key="d1">technology</data>
  <data key="d2">Jidoka là hệ thống tự động kiểm lỗi, đảm bảo không có phế phẩm chuyển sang giai đoạn tiếp theo.&lt;SEP&gt;Jidoka là công nghệ tự động hóa thông minh trong sản xuất tinh gọn, giúp phát hiện và ngăn chặn lỗi tại nguồn.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd&lt;SEP&gt;chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972612</data>
  <data key="d6"></data>
</node>
<node id="Sản xuất tinh gọn (Lean Manufacturing)">
  <data key="d0">Sản xuất tinh gọn (Lean Manufacturing)</data>
  <data key="d1">technology</data>
  <data key="d2">Sản xuất tinh gọn là phương thức quản lý hiện đại được cụ thể hóa qua triết lý của Toyota.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972613</data>
  <data key="d6"></data>
</node>
<node id="Ngôi nhà hệ thống sản xuất Toyota">
  <data key="d0">Ngôi nhà hệ thống sản xuất Toyota</data>
  <data key="d1">event</data>
  <data key="d2">Ngôi nhà hệ thống sản xuất Toyota là biểu tượng cấu trúc với hai cột trụ JIT và Jidoka, nền tảng là quy trình ổn định và văn hóa công ty.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972613</data>
  <data key="d6"></data>
</node>
<node id="Nhà máy A">
  <data key="d0">Nhà máy A</data>
  <data key="d1">organization</data>
  <data key="d2">Nhà máy A là tổ chức muốn chọn địa điểm kho hàng trung tâm dựa trên tọa độ và khối lượng vận chuyển.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972613</data>
  <data key="d6"></data>
</node>
<node id="Ma trận Richard Muther">
  <data key="d0">Ma trận Richard Muther</data>
  <data key="d1">technology</data>
  <data key="d2">Ma trận Richard Muther là công cụ được sử dụng để sắp xếp vị trí các nơi làm việc trong doanh nghiệp.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972613</data>
  <data key="d6"></data>
</node>
<node id="Hộp 5.1">
  <data key="d0">Hộp 5.1</data>
  <data key="d1">event</data>
  <data key="d2">Hộp 5.1 là nghiên cứu tình huống về hệ thống sản xuất của tập đoàn Toyota.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972613</data>
  <data key="d6"></data>
</node>
<node id="CHƢƠNG V. JIT VÀ HỆ THỐNG SẢN XUẤT TINH GỌN">
  <data key="d0">CHƢƠNG V. JIT VÀ HỆ THỐNG SẢN XUẤT TINH GỌN</data>
  <data key="d1">event</data>
  <data key="d2">CHƢƠNG V là chương trình bày về JIT và hệ thống sản xuất tinh gọn.</data>
  <data key="d3">chunk-c1079bebc864be7086acd606fd855cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972614</data>
  <data key="d6"></data>
</node>
<node id="Công Ty A">
  <data key="d0">Công Ty A</data>
  <data key="d1">organization</data>
  <data key="d2">Công Ty A là một tổ chức sử dụng phương pháp bình quân di động để dự báo doanh số bán hàng.&lt;SEP&gt;Công Ty A là doanh nghiệp cung ứng hóa chất và thiết bị cho các cửa hiệu ảnh.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b&lt;SEP&gt;chunk-bd931678f134437e61227b29b70610d3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972614</data>
  <data key="d6"></data>
</node>
<node id="Cửa Hàng A">
  <data key="d0">Cửa Hàng A</data>
  <data key="d1">organization</data>
  <data key="d2">Cửa Hàng A là một tổ chức áp dụng mô hình dự báo bình quân di động có trọng số cho doanh số bán hàng.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972614</data>
  <data key="d6"></data>
</node>
<node id="Bình Quân Di Động">
  <data key="d0">Bình Quân Di Động</data>
  <data key="d1">technology</data>
  <data key="d2">Bình Quân Di Động là phương pháp dự báo định lượng sử dụng giá trị trung bình di chuyển.&lt;SEP&gt;Bình Quân Di Động là phương pháp dự báo sử dụng trung bình cộng của các giai đoạn quan sát để dự đoán giá trị tương lai.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b&lt;SEP&gt;chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972614</data>
  <data key="d6"></data>
</node>
<node id="Bình Quân Di Động Có Trọng Số">
  <data key="d0">Bình Quân Di Động Có Trọng Số</data>
  <data key="d1">technology</data>
  <data key="d2">Bình Quân Di Động Có Trọng Số là phương pháp dự báo định lượng sử dụng giá trị trung bình di chuyển có trọng số.&lt;SEP&gt;Bình Quân Di Động Có Trọng Số là phương pháp dự báo gán trọng số khác nhau cho các giai đoạn quan sát để phản ánh mức độ ảnh hưởng.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b&lt;SEP&gt;chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972614</data>
  <data key="d6"></data>
</node>
<node id="San Bằng Mũ">
  <data key="d0">San Bằng Mũ</data>
  <data key="d1">technology</data>
  <data key="d2">San Bằng Mũ là kỹ thuật dự báo định lượng sử dụng để điều chỉnh xu hướng dữ liệu.&lt;SEP&gt;San Bằng Mũ là phương pháp dự báo sử dụng hệ số san bằng mũ (α) để tính toán nhu cầu tương lai dựa trên dữ liệu trước đó.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b&lt;SEP&gt;chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972615</data>
  <data key="d6"></data>
</node>
<node id="San Bằng Mũ Giản Đơn">
  <data key="d0">San Bằng Mũ Giản Đơn</data>
  <data key="d1">technology</data>
  <data key="d2">San Bằng Mũ Giản Đơn là kỹ thuật dự báo thuộc phương pháp san bằng mũ, không điều chỉnh xu hướng biến động.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972615</data>
  <data key="d6"></data>
</node>
<node id="San Bằng Mũ Có Điều Chỉnh Xu Hướng">
  <data key="d0">San Bằng Mũ Có Điều Chỉnh Xu Hướng</data>
  <data key="d1">technology</data>
  <data key="d2">San Bằng Mũ Có Điều Chỉnh Xu Hướng là kỹ thuật mở rộng của san bằng mũ, bổ sung điều chỉnh xu hướng để cải thiện độ chính xác.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972615</data>
  <data key="d6"></data>
</node>
<node id="Doanh Số Bán Hàng">
  <data key="d0">Doanh Số Bán Hàng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Doanh Số Bán Hàng là chỉ tiêu tài chính phản ánh số lượng sản phẩm bán ra trong các giai đoạn quan sát.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972615</data>
  <data key="d6"></data>
</node>
<node id="Tháng 1 Đến Tháng 6">
  <data key="d0">Tháng 1 Đến Tháng 6</data>
  <data key="d1">date</data>
  <data key="d2">Tháng 1 Đến Tháng 6 là khoảng thời gian được sử dụng để thống kê doanh số bán hàng trong ví dụ.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972615</data>
  <data key="d6"></data>
</node>
<node id="Trọng Số">
  <data key="d0">Trọng Số</data>
  <data key="d1">technology</data>
  <data key="d2">Trọng Số là các con số được gán cho các số liệu quá khứ để chỉ ra mức độ quan trọng của chúng ảnh hưởng đến kết quả dự báo.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972615</data>
  <data key="d6"></data>
</node>
<node id="Hệ Số San Bằng Mũ (α)">
  <data key="d0">Hệ Số San Bằng Mũ (α)</data>
  <data key="d1">technology</data>
  <data key="d2">Hệ Số San Bằng Mũ (α) là tham số kỹ thuật trong phương pháp San Bằng Mũ, có giá trị từ 0 đến 1.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972616</data>
  <data key="d6"></data>
</node>
<node id="AD (Absolute Deviation)">
  <data key="d0">AD (Absolute Deviation)</data>
  <data key="d1">financial_metric</data>
  <data key="d2">AD là sai số dự báo, được tính bằng nhu cầu thực tế trừ đi dự báo.</data>
  <data key="d3">chunk-1a57f31c1c80f96c69f025bd79f9253b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972616</data>
  <data key="d6"></data>
</node>
<node id="In ấn (2)">
  <data key="d0">In ấn (2)</data>
  <data key="d1">organization</data>
  <data key="d2">In ấn (2) là một bộ phận trong quy trình sản xuất, có khối lượng vận chuyển 50 tấn đến Đóng gói (3) và 10 tấn đến Kiểm tra (6).</data>
  <data key="d3">chunk-d057797ec16ef2fc62ed848e229f9d3f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972616</data>
