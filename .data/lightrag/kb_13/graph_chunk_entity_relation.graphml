<node id="Hợp Đồng A-B">
  <data key="d0">Hợp Đồng A-B</data>
  <data key="d1">regulation</data>
  <data key="d2">Hợp đồng A-B là loại hợp đồng phổ biến trong sản xuất xây dựng, liên quan đến tư vấn và giám sát.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976432</data>
  <data key="d6"></data>
</node>
<node id="Công Nghệ Xây Dựng">
  <data key="d0">Công Nghệ Xây Dựng</data>
  <data key="d1">technology</data>
  <data key="d2">Công nghệ xây dựng là yếu tố then chốt trong việc lập phương án kỹ thuật và tổ chức thi công.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976432</data>
  <data key="d6"></data>
</node>
<node id="Phương Án Công Nghệ Xây Lắp Hợp Lý">
  <data key="d0">Phương Án Công Nghệ Xây Lắp Hợp Lý</data>
  <data key="d1">technology</data>
  <data key="d2">Phương án công nghệ xây lắp hợp lý là giải pháp kỹ thuật tối ưu phù hợp với điều kiện thực tế thi công.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976432</data>
  <data key="d6"></data>
</node>
<node id="Chủ Đầu Tư">
  <data key="d0">Chủ Đầu Tư</data>
  <data key="d1">organization</data>
  <data key="d2">Chủ Đầu Tư là tổ chức hoặc cá nhân sở hữu và tài trợ cho các dự án xây dựng.&lt;SEP&gt;Chủ đầu tư là cá nhân hoặc tổ chức phê duyệt và đồng ý các sai lệch trong thiết kế nếu nâng cao chất lượng.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f&lt;SEP&gt;chunk-d451d2038a98e4929b77d5130519747e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976432</data>
  <data key="d6"></data>
</node>
<node id="Công Ty Cung Ứng Vật Tư Thiết Bị">
  <data key="d0">Công Ty Cung Ứng Vật Tư Thiết Bị</data>
  <data key="d1">organization</data>
  <data key="d2">Công Ty Cung Ứng Vật Tư Thiết Bị là doanh nghiệp cung cấp vật liệu và thiết bị cho hoạt động xây dựng.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976432</data>
