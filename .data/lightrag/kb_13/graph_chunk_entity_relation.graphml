  <data key="d0">Chuẩn Bị Mặt Bằng</data>
  <data key="d1">other</data>
  <data key="d2">Chuẩn Bị Mặt Bằng là quá trình chuẩn bị trước khi thi công chính, bao gồm phá dỡ, di chuyển nhà cửa và công trình trong phạm vi công trường.</data>
  <data key="d3">chunk-7dfc32c6d93e918924c330bd1756b4bb</data>
