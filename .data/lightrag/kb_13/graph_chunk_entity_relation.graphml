<node id="Thiết kế hệ thống sản xuất">
  <data key="d0">Thiết kế hệ thống sản xuất</data>
  <data key="d1">technology</data>
  <data key="d2">Thiết kế hệ thống sản xuất là quá trình rút ngắn thời gian và giảm chi phí lãng phí trong sản xuất.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
