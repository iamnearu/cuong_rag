  <data key="d1">person</data>
  <data key="d2">Anh Nam là một sinh viên mới tốt nghiệp khoa Quản trị kinh doanh và được tuyển dụng vào vị trí phân tích kinh doanh tại một tập đoàn sản xuất điện thoại.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972716</data>
  <data key="d6"></data>
</node>
<node id="Giám đốc điều hành">
  <data key="d0">Giám đốc điều hành</data>
  <data key="d1">person</data>
  <data key="d2">Giám đốc điều hành là người lãnh đạo tập đoàn sản xuất điện thoại, đang gặp gỡ Anh Nam để thảo luận về vấn đề dự báo sản xuất.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972716</data>
  <data key="d6"></data>
</node>
<node id="Tập đoàn sản xuất điện thoại">
  <data key="d0">Tập đoàn sản xuất điện thoại</data>
  <data key="d1">organization</data>
  <data key="d2">Tập đoàn sản xuất điện thoại là tổ chức chế tạo nhiều dòng điện thoại phục vụ nhiều thị trường và khách hàng.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972716</data>
  <data key="d6"></data>
</node>
<node id="Điện thoại">
  <data key="d0">Điện thoại</data>
  <data key="d1">product</data>
  <data key="d2">Điện thoại là sản phẩm chính của tập đoàn sản xuất điện thoại, được phân tích để cải thiện kế hoạch sản xuất.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972716</data>
  <data key="d6"></data>
</node>
<node id="Phương pháp san bằng số mũ giản đơn">
  <data key="d0">Phương pháp san bằng số mũ giản đơn</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp san bằng số mũ giản đơn là kỹ thuật dự báo sử dụng hệ số suy giảm (α) để tính toán nhu cầu tháng tiếp theo.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972717</data>
  <data key="d6"></data>
</node>
<node id="Phương pháp bình quân di động 3 tháng">
  <data key="d0">Phương pháp bình quân di động 3 tháng</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp bình quân di động 3 tháng là kỹ thuật dự báo sử dụng trung bình doanh số của 3 tháng gần nhất.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972717</data>
  <data key="d6"></data>
</node>
<node id="Phương pháp bình quân di động 3 tháng có trọng số">
  <data key="d0">Phương pháp bình quân di động 3 tháng có trọng số</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp bình quân di động 3 tháng có trọng số là kỹ thuật dự báo áp dụng trọng số 3, 2, 1 cho các tháng gần nhất đến xa nhất.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972717</data>
  <data key="d6"></data>
</node>
<node id="Doanh số">
  <data key="d0">Doanh số</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Doanh số là chỉ tiêu phản ánh lượng máy hút bụi bán được hàng tháng, được ghi nhận theo đơn vị nghìn chiếc.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972717</data>
  <data key="d6"></data>
</node>
<node id="Tháng 9">
  <data key="d0">Tháng 9</data>
  <data key="d1">date</data>
  <data key="d2">Tháng 9 là thời điểm thứ hai có doanh số cao nhất (17 nghìn chiếc) trong chuỗi dữ liệu.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972717</data>
  <data key="d6"></data>
</node>
<node id="Tết Nguyên Đán">
  <data key="d0">Tết Nguyên Đán</data>
  <data key="d1">event</data>
  <data key="d2">Tết Nguyên Đán là dịp lễ quan trọng mà Giám đốc điều hành yêu cầu Anh Nam hoàn thành báo cáo trước.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972718</data>
  <data key="d6"></data>
</node>
<node id="RSFE">
  <data key="d0">RSFE</data>
  <data key="d1">financial_metric</data>
  <data key="d2">RSFE là chỉ tiêu tín hiệu theo dõi liên quan đến dự báo nhu cầu.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da&lt;SEP&gt;chunk-73e44caa1b0b29f7f3a0d414586a18fd</data>
  <data key="d4">unknown_source</data>
