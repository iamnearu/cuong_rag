  <data key="d0">Mức Sống Nhân Dân</data>
  <data key="d1">concept</data>
  <data key="d2">Mức Sống Nhân Dân là yếu tố ảnh hưởng đến sự phát triển của ngành xây dựng.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
