  <data key="d0">Thiết kế bố trí theo sản phẩm</data>
  <data key="d1">technology</data>
  <data key="d2">Thiết kế bố trí theo sản phẩm sắp xếp máy móc và lao động theo trình tự sản xuất sản phẩm cụ thể.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972708</data>
  <data key="d6"></data>
</node>
<node id="Bố trí mặt bằng kho hàng">
  <data key="d0">Bố trí mặt bằng kho hàng</data>
  <data key="d1">technology</data>
  <data key="d2">Bố trí mặt bằng kho hàng tập trung vào lưu trữ, phân loại và vận chuyển hàng hóa hiệu quả.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972708</data>
  <data key="d6"></data>
</node>
<node id="Chuẩn hoá quy trình">
  <data key="d0">Chuẩn hoá quy trình</data>
  <data key="d1">technology</data>
  <data key="d2">Chuẩn hoá quy trình là việc thiết lập các tiêu chuẩn rõ ràng để đảm bảo tính nhất quán trong sản xuất.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972708</data>
  <data key="d6"></data>
</node>
<node id="Truyền đạt quy trình chuẩn cho công nhân">
  <data key="d0">Truyền đạt quy trình chuẩn cho công nhân</data>
  <data key="d1">technology</data>
  <data key="d2">Truyền đạt quy trình chuẩn cho công nhân nhằm đảm bảo mọi người tuân thủ đúng quy định sản xuất.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972708</data>
  <data key="d6"></data>
</node>
<node id="Quản lý bằng các công cụ trực quan">
  <data key="d0">Quản lý bằng các công cụ trực quan</data>
  <data key="d1">technology</data>
  <data key="d2">Quản lý bằng các công cụ trực quan sử dụng hình ảnh, biểu tượng để truyền đạt thông tin nhanh chóng.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972708</data>
  <data key="d6"></data>
</node>
<node id="Chất lượng từ gốc">
  <data key="d0">Chất lượng từ gốc</data>
  <data key="d1">technology</data>
  <data key="d2">Chất lượng từ gốc tập trung vào kiểm soát chất lượng ngay từ đầu vào để tránh lỗi.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972708</data>
  <data key="d6"></data>
</node>
<node id="Bảo trì dự phòng và bảo trì sản xuất tổng hợp">
  <data key="d0">Bảo trì dự phòng và bảo trì sản xuất tổng hợp</data>
  <data key="d1">technology</data>
  <data key="d2">Bảo trì dự phòng và bảo trì sản xuất tổng hợp đảm bảo thiết bị hoạt động liên tục, giảm thời gian dừng máy.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972709</data>
  <data key="d6"></data>
</node>
<node id="Giảm thiểu quy mô của lô sản xuất">
  <data key="d0">Giảm thiểu quy mô của lô sản xuất</data>
  <data key="d1">technology</data>
  <data key="d2">Giảm thiểu quy mô lô sản xuất nhằm đáp ứng nhanh nhu cầu thị trường và giảm tồn kho.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972709</data>
  <data key="d6"></data>
</node>
<node id="Lean Manufacturing">
  <data key="d0">Lean Manufacturing</data>
  <data key="d1">technology</data>
  <data key="d2">Lean Manufacturing là thuật ngữ tiếng Anh tương đương với "Sản xuất tinh gọn", tập trung vào loại bỏ lãng phí và tối ưu hóa quy trình sản xuất.&lt;SEP&gt;Lean Manufacturing là hệ thống sản xuất tinh gọn được áp dụng để cải thiện hiệu quả và giảm lãng phí.</data>
  <data key="d3">chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b&lt;SEP&gt;chunk-a6966c6135e273253a8585c7661feb09</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972709</data>
  <data key="d6"></data>
</node>
<node id="Yếu Tố Lãnh Đạo">
  <data key="d0">Yếu Tố Lãnh Đạo</data>
  <data key="d1">other</data>
  <data key="d2">Yếu tố lãnh đạo là yếu tố định tính ảnh hưởng đến năng suất thông qua mục tiêu và chiến lược quản trị.&lt;SEP&gt;Yếu tố lãnh đạo là yếu tố xem xét mục tiêu và chiến lược quản trị ảnh hưởng đến năng suất trong doanh nghiệp.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f&lt;SEP&gt;chunk-1181419295960e1c6db358ff384b2cc3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972709</data>
  <data key="d6"></data>
</node>
<node id="Yếu Tố Quản Lý">
  <data key="d0">Yếu Tố Quản Lý</data>
  <data key="d1">other</data>
  <data key="d2">Yếu tố quản lý là yếu tố định tính liên quan đến cơ cấu tổ chức và chính sách quản lý trong doanh nghiệp.&lt;SEP&gt;Yếu tố quản lý bao gồm cơ cấu tổ chức, hệ thống quản lý và chính sách đối với lao động, tác động đến năng suất.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f&lt;SEP&gt;chunk-1181419295960e1c6db358ff384b2cc3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972709</data>
  <data key="d6"></data>
</node>
<node id="Yếu Tố Phát Triển Sản Phẩm">
  <data key="d0">Yếu Tố Phát Triển Sản Phẩm</data>
  <data key="d1">other</data>
  <data key="d2">Yếu tố phát triển sản phẩm là yếu tố định tính liên quan đến cải tiến và đổi mới sản phẩm, ảnh hưởng đến năng suất.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972710</data>
  <data key="d6"></data>
</node>
<node id="Yếu Tố Chiến Lược Thị Trường">
  <data key="d0">Yếu Tố Chiến Lược Thị Trường</data>
  <data key="d1">other</data>
  <data key="d2">Yếu tố chiến lược thị trường là yếu tố định tính liên quan đến sản phẩm và chiến lược thị trường, tác động đến năng suất.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972710</data>
  <data key="d6"></data>
</node>
<node id="Yếu Tố Tài Chính">
  <data key="d0">Yếu Tố Tài Chính</data>
  <data key="d1">other</data>
  <data key="d2">Yếu tố tài chính bao gồm chính sách tài chính và các chỉ tiêu tài chính, ảnh hưởng đến năng suất trong doanh nghiệp.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972710</data>
  <data key="d6"></data>
</node>
<node id="Các Mối Quan Hệ Hợp Tác">
  <data key="d0">Các Mối Quan Hệ Hợp Tác</data>
  <data key="d1">other</data>
  <data key="d2">Các mối quan hệ hợp tác, liên doanh, liên kết là yếu tố định tính ảnh hưởng đến năng suất thông qua sự phối hợp giữa các bên.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972710</data>
  <data key="d6"></data>
</node>
<node id="Mối Quan Hệ Quản Trị - Người Lao Động">
  <data key="d0">Mối Quan Hệ Quản Trị - Người Lao Động</data>
  <data key="d1">other</data>
  <data key="d2">Mối quan hệ giữa quản trị và người lao động là yếu tố định tính ảnh hưởng đến năng suất thông qua sự phối hợp và động lực làm việc.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972710</data>
  <data key="d6"></data>
</node>
<node id="Nghiên Cứu Thời Gian Lao Động">
  <data key="d0">Nghiên Cứu Thời Gian Lao Động</data>
  <data key="d1">other</data>
  <data key="d2">Nghiên cứu thời gian lao động và thời gian tự do hợp lý là yếu tố định tính ảnh hưởng đến năng suất thông qua việc tối ưu hóa thời gian làm việc.</data>
  <data key="d3">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972711</data>
