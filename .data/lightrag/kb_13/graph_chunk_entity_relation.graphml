<node id="Công ty Việt Ahh">
  <data key="d0">Công ty Việt Ahh</data>
  <data key="d1">organization</data>
  <data key="d2">Công ty Việt Ahh là doanh nghiệp được đề cập trong bảng tổng hợp tài chính với các khoản thu chi liên quan.</data>
  <data key="d3">chunk-69834ed6386eb913c5eb437568d43868</data>
