  <data key="d0">Nhận hàng (4)</data>
  <data key="d1">organization</data>
  <data key="d2">Nhận hàng (4) là bộ phận sản xuất, có khối lượng vận chuyển 50 tấn đến Vận chuyển (5).</data>
  <data key="d3">chunk-d057797ec16ef2fc62ed848e229f9d3f</data>
