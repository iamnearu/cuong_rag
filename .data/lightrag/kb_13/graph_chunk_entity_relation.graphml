</edge>
<edge source="Năng Suất Tổng Hợp" target="Cải Tiến Điều Kiện Làm Việc">
  <data key="d7">1.0</data>
  <data key="d8">Cải tiến điều kiện và môi trường làm việc tăng năng suất tổng hợp thông qua việc tạo môi trường làm việc hiệu quả.</data>
  <data key="d9">môi trường,điều kiện</data>
  <data key="d10">chunk-aac7b813b6a619b2d5d31ded9867563f</data>
