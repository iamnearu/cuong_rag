</node>
<node id="Rủi ro thị trường">
  <data key="d0">Rủi ro thị trường</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rủi ro thị trường là loại rủi ro liên quan đến biến động lãi suất và giá hàng hóa, nguyên liệu.&lt;SEP&gt;Rủi ro thị trường là rủi ro liên quan đến biến động lãi suất và giá hàng hóa, nguyên liệu.</data>
  <data key="d3">chunk-e3ddf9830fd5c237184e63f186ed4bf0&lt;SEP&gt;chunk-8e1f8fab8d954224f2193035cbf1dffc</data>
  <data key="d4">unknown_source</data>
