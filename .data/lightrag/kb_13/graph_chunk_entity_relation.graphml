  <data key="d0">Các điều kiện tự nhiên</data>
  <data key="d1">concept</data>
  <data key="d2">Các điều kiện tự nhiên là nhân tố ảnh hưởng đến chọn vùng, được trình bày từ trang 44.</data>
  <data key="d3">chunk-bfb09dc2f0322ea84f0381a3d2cccb49</data>
