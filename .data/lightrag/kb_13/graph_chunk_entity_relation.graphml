  <data key="d0">MBO</data>
  <data key="d1">technology</data>
  <data key="d2">MBO là phương pháp quản trị mục tiêu, được đề cập trong xu hướng phát triển.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
