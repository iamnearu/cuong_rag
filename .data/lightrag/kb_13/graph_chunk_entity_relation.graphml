<node id="Nmax">
  <data key="d0">Nmax</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Nmax là số công nhân tập trung cao nhất trong quá trình thi công công trình.&lt;SEP&gt;Nmax là số công nhân tập trung cao nhất trong quá trình thi công, được sử dụng để tính toán biểu đồ nhân lực.</data>
  <data key="d3">chunk-b29022fe8b5f5d506ad3c3a30a6b4bcd&lt;SEP&gt;chunk-ab7434271b1707c34ba0d8a269e732dd</data>
