  <data key="d6"></data>
</node>
<node id="Rủi ro lãi suất">
  <data key="d0">Rủi ro lãi suất</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Rủi ro lãi suất là loại rủi ro được quản lý trong hoạt động kinh doanh của Công ty.&lt;SEP&gt;Rủi ro lãi suất là rủi ro từ sự thay đổi của lãi suất ảnh hưởng đến hoạt động kinh doanh.</data>
  <data key="d3">chunk-e3ddf9830fd5c237184e63f186ed4bf0&lt;SEP&gt;chunk-8e1f8fab8d954224f2193035cbf1dffc</data>
