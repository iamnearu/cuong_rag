<node id="Giám đốc dự án">
  <data key="d0">Giám đốc dự án</data>
  <data key="d1">person</data>
  <data key="d2">Giám đốc dự án tham gia phê duyệt hồ sơ thanh toán trong quy trình thanh toán khối lượng cho thầu phụ.</data>
  <data key="d3">chunk-c164371a2505dc88c4539f83f89ae713</data>
