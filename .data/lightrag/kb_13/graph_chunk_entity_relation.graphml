  <data key="d1">financial_metric</data>
  <data key="d2">Rủi ro hỏng hóc là tích số giữa chỉ số xuất hiện và chỉ số mức độ nghiêm trọng, dùng để đánh giá mức độ chấp nhận rủi ro.</data>
  <data key="d3">chunk-3edab69dc20e549a181dcd4774d908a1</data>
