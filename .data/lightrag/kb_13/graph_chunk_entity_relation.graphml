  <data key="d0">Nguyen vat lieu</data>
  <data key="d1">product</data>
  <data key="d2">Nguyen vat lieu là nguồn nguyên liệu cần thiết cho quá trình sản xuất hoặc xây dựng công trình.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976597</data>
