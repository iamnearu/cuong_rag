  <data key="d6"></data>
</node>
<node id="Luật các khoản phải trả">
  <data key="d0">Luật các khoản phải trả</data>
  <data key="d1">regulation</data>
  <data key="d2">Luật các khoản phải trả là quy định pháp lý điều chỉnh việc phân loại, theo dõi và thanh toán các khoản nợ ngắn hạn và dài hạn.</data>
  <data key="d3">chunk-00fe331f136c5a09db18cac7106d146e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952832</data>
