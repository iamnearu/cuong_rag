<node id="Sản Xuất Xây Dựng">
  <data key="d0">Sản Xuất Xây Dựng</data>
  <data key="d1">product</data>
  <data key="d2">Sản xuất xây dựng là quá trình tạo ra các công trình, kết hợp nhiều ngành và tổ chức kinh tế.</data>
  <data key="d3">chunk-e39fcaaef27cd718993c01ad2659763f</data>
