<node id="Điểm hòa vốn">
  <data key="d0">Điểm hòa vốn</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Điểm hòa vốn là mức công suất mà tại đó tổng chi phí bằng tổng doanh thu.&lt;SEP&gt;Điểm hòa vốn là chỉ số tài chính biểu thị mức doanh thu cần đạt được để bù đắp toàn bộ chi phí, được đề cập trong văn bản nhưng chưa có dữ liệu cụ thể.</data>
  <data key="d3">chunk-0cd5bbf148baa71362aafce470dd89e6&lt;SEP&gt;chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972719</data>
  <data key="d6"></data>
</node>
<node id="Phân xưởng A">
  <data key="d0">Phân xưởng A</data>
  <data key="d1">organization</data>
  <data key="d2">Phân xưởng A là đơn vị sản xuất được sử dụng trong ví dụ minh họa về đường cong kinh nghiệm.</data>
  <data key="d3">chunk-0cd5bbf148baa71362aafce470dd89e6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972719</data>
  <data key="d6"></data>
</node>
<node id="Adam Smith">
  <data key="d0">Adam Smith</data>
  <data key="d1">person</data>
  <data key="d2">Adam Smith là nhà kinh tế học người Scotland, người đầu tiên đề cập đến thuật ngữ năng suất trong bài viết năm 1723-1790.&lt;SEP&gt;Adam Smith là nhà kinh tế học người Scotland, người đầu tiên đề cập đến thuật ngữ năng suất trong một bài báo năm 1776.</data>
  <data key="d3">chunk-0cd5bbf148baa71362aafce470dd89e6&lt;SEP&gt;chunk-1181419295960e1c6db358ff384b2cc3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972719</data>
  <data key="d6"></data>
</node>
<node id="1723-1790">
  <data key="d0">1723-1790</data>
  <data key="d1">date</data>
  <data key="d2">1723-1790 là khoảng thời gian sống của Adam Smith, liên quan đến việc ông đề cập khái niệm năng suất.</data>
  <data key="d3">chunk-0cd5bbf148baa71362aafce470dd89e6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972719</data>
  <data key="d6"></data>
</node>
