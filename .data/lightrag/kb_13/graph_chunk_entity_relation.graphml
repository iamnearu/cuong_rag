  <data key="d0">144 điện thoại</data>
  <data key="d1">financial_metric</data>
  <data key="d2">144 điện thoại là số lượng điện thoại trong một đơn đặt hàng được Giám đốc điều hành nêu rõ.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972718</data>
  <data key="d6"></data>
</node>
