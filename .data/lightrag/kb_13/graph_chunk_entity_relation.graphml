</node>
<node id="Đơn đặt hàng điện thoại">
  <data key="d0">Đơn đặt hàng điện thoại</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Đơn đặt hàng điện thoại là dữ liệu phản ánh số lượng đơn hàng công ty đã nhận được trong 36 tháng trước đây.</data>
  <data key="d3">chunk-19c5463815d465ec16fc51a35010a8da</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972718</data>
  <data key="d6"></data>
</node>
