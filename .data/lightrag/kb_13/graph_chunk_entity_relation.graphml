  <data key="d12">1777972774</data>
  <data key="d13"></data>
</edge>
<edge source="Sản xuất tinh gọn" target="Giảm thời gian chuẩn bị hoặc chuyển đổi sản xuất">
  <data key="d7">2.0</data>
  <data key="d8">Giảm thời gian chuẩn bị là phương pháp tối ưu hóa trong sản xuất tinh gọn.&lt;SEP&gt;Sản xuất tinh gọn nhấn mạnh việc giảm thời gian chuẩn bị/chuyển đổi sản xuất để loại bỏ thời gian dừng dây chuyền không cần thiết.</data>
  <data key="d9">công cụ,giảm lãng phí,nguyên tắc,tối ưu hóa quy trình</data>
  <data key="d10">chunk-86b5b2cb403cf9c9db03446c6dabeed6&lt;SEP&gt;chunk-c57d1c84a11334f8a8c3a2e31f9dfb9b</data>
