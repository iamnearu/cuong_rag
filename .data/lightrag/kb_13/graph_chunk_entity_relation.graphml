<node id="Bệnh viện">
  <data key="d0">Bệnh viện</data>
  <data key="d1">organization</data>
  <data key="d2">Bệnh viện là doanh nghiệp sử dụng công suất dưới dạng giường bệnh sẵn sàng trong một tháng.&lt;SEP&gt;Bệnh viện là tổ chức sử dụng giường bệnh sẵn sàng để đo công suất.</data>
  <data key="d3">chunk-6f848db21a559c528f5171683bdc025b&lt;SEP&gt;chunk-cbdc32c821d6f4e3f570b5fdc5c55a32</data>
