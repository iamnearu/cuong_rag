<node id="Dự Án Khả Thi">
  <data key="d0">Dự Án Khả Thi</data>
  <data key="d1">product</data>
  <data key="d2">Dự án khả thi là báo cáo cung cấp cơ sở cho thiết kế kỹ thuật và thiết kế thi công.</data>
  <data key="d3">chunk-d451d2038a98e4929b77d5130519747e</data>
