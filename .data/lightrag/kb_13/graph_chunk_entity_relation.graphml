</node>
<node id="Chính Phủ">
  <data key="d0">Chính Phủ</data>
  <data key="d1">organization</data>
  <data key="d2">Chính Phủ là cơ quan ban hành nghị định quy định thời hạn pháp lệnh cho thi công xây dựng.</data>
  <data key="d3">chunk-7dfc32c6d93e918924c330bd1756b4bb</data>
