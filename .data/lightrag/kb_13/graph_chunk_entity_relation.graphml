  <data key="d0">Finacial Times Global 500</data>
  <data key="d1">organization</data>
  <data key="d2">Finacial Times Global 500 là danh sách xếp hạng 500 hãng có tiềm lực tài chính hàng đầu thế giới, trong đó Walt Disney đứng thứ 79 vào năm 2007.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972644</data>
