  <data key="d1">technology</data>
  <data key="d2">Mã kết cấu công trình là hệ thống ký hiệu kỹ thuật mô tả cấu trúc xây dựng.</data>
  <data key="d3">chunk-7843884acf20ab6d52ebe622e4488572</data>
