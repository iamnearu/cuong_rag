  <data key="d0">Truc Tiep Phi</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Truc Tiep Phi là chi phí trực tiếp liên quan đến các công việc thi công, thay đổi theo thời gian thi công.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
