<edge source="Công suất" target="Phương án công suất">
  <data key="d7">1.0</data>
  <data key="d8">Phương án công suất là cơ sở để hoạch định công suất, đảm bảo tính linh hoạt và hiệu quả sản xuất.</data>
  <data key="d9">kế hoạch,linh hoạt</data>
  <data key="d10">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d11">unknown_source</data>
  <data key="d12">1777972895</data>
  <data key="d13"></data>
</edge>
<edge source="Công suất" target="Tính linh hoạt của doanh nghiệp">
  <data key="d7">1.0</data>
  <data key="d8">Tính linh hoạt của doanh nghiệp ảnh hưởng trực tiếp đến việc lựa chọn và điều chỉnh công suất phù hợp với nhu cầu thị trường.</data>
  <data key="d9">hoạch định,linh hoạt</data>
