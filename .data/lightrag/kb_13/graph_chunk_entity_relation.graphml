<node id="Day chuyen cong trinh nhip cham">
  <data key="d0">Day chuyen cong trinh nhip cham</data>
  <data key="d1">technology</data>
  <data key="d2">Day chuyen cong trinh nhip cham là phương pháp tổ chức sản xuất theo dây chuyền với nhịp điệu chậm, được tính toán dựa trên công thức (3.92) và (3.94).</data>
  <data key="d3">chunk-f5c66bff14c0e74e04d408bc34b38129</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976458</data>
  <data key="d6"></data>
</node>
<node id="Hinh 3.48">
  <data key="d0">Hinh 3.48</data>
  <data key="d1">other</data>
  <data key="d2">Hinh 3.48 là hình ảnh biểu đồ đặc trưng của dây chuyền công trình không đồng nhịp.</data>
  <data key="d3">chunk-f5c66bff14c0e74e04d408bc34b38129</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976459</data>
  <data key="d6"></data>
</node>
<node id="Cong thuc (3.92)">
  <data key="d0">Cong thuc (3.92)</data>
  <data key="d1">other</data>
  <data key="d2">Cong thuc (3.92) được sử dụng để tính toán dây chuyền công trình nhịp chậm.</data>
  <data key="d3">chunk-f5c66bff14c0e74e04d408bc34b38129</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976459</data>
  <data key="d6"></data>
</node>
<node id="Cong thuc (3.94)">
  <data key="d0">Cong thuc (3.94)</data>
  <data key="d1">other</data>
  <data key="d2">Cong thuc (3.94) xác định thời gian hoạt động của công việc cuối cùng trong dây chuyền nhịp chậm.</data>
  <data key="d3">chunk-f5c66bff14c0e74e04d408bc34b38129</data>
  <data key="d4">unknown_source</data>
