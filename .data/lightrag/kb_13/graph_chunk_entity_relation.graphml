<node id="Hãng hàng không">
  <data key="d0">Hãng hàng không</data>
  <data key="d1">organization</data>
  <data key="d2">Hãng hàng không là doanh nghiệp sử dụng công suất dưới dạng chỗ ghế còn trống trong một tháng.&lt;SEP&gt;Hãng hàng không là tổ chức sử dụng chỗ ghế còn trống để đo công suất.</data>
  <data key="d3">chunk-6f848db21a559c528f5171683bdc025b&lt;SEP&gt;chunk-cbdc32c821d6f4e3f570b5fdc5c55a32</data>
