  <data key="d0">Xây Dựng Chính</data>
  <data key="d1">other</data>
  <data key="d2">Xây Dựng Chính là giai đoạn thi công chính thức bao gồm xây dựng công trình và đưa công trình vào hoạt động.</data>
  <data key="d3">chunk-7dfc32c6d93e918924c330bd1756b4bb</data>
