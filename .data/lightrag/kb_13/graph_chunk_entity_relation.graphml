  <data key="d0">Công Nghiệp Hóa Ngành Xây Dựng</data>
  <data key="d1">event</data>
  <data key="d2">Công Nghiệp Hóa Ngành Xây Dựng là xu hướng phát triển nhằm hiện đại hóa và tăng hiệu quả sản xuất trong lĩnh vực xây dựng.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976373</data>
  <data key="d6"></data>
</node>
<node id="Điều Kiện Thi Công">
  <data key="d0">Điều Kiện Thi Công</data>
  <data key="d1">other</data>
  <data key="d2">Điều Kiện Thi Công là yếu tố quyết định tính khả thi của phương án xây dựng.&lt;SEP&gt;Điều Kiện Thi Công là các yếu tố như năng lực đơn vị xây lắp, vị trí công trình và các ràng buộc khác (hợp đồng, quy ước...) ảnh hưởng đến quá trình thi công.</data>
  <data key="d3">chunk-3926b9f30420533f221607a28009bb54&lt;SEP&gt;chunk-e39fcaaef27cd718993c01ad2659763f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976373</data>
  <data key="d6"></data>
</node>
