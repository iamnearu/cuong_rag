  <data key="d0">Trieu chung kha thi</data>
  <data key="d1">event</data>
  <data key="d2">Trieu chung kha thi là giai đoạn quan trọng xác định tính hiện thực của dự án thông qua đánh giá kinh tế - kỹ thuật.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
