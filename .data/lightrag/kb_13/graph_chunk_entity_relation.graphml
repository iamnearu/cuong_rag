<node id="Máy Tính Điện Tử">
  <data key="d0">Máy Tính Điện Tử</data>
  <data key="d1">technology</data>
  <data key="d2">Máy tính điện tử được ứng dụng trong quản lý và điều hành xây dựng để nâng cao hiệu quả kinh tế và tự động hóa quy trình.</data>
  <data key="d3">chunk-5b849f30ebbea48035f3488b40b43009</data>
