  <data key="d0">Bước I: Phân Tích Công Nghệ Xây Dựng</data>
  <data key="d1">event</data>
  <data key="d2">Bước I là giai đoạn phân tích công nghệ xây dựng dựa trên quyết định thiết kế thi công.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
