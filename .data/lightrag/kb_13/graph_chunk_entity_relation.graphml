  <data key="d0">Hoành độ đầu mút trái</data>
  <data key="d1">technology</data>
  <data key="d2">Hoành độ đầu mút trái là tọa độ xác định thời điểm bắt đầu của một công việc trên trục thời gian trong sơ đồ ngang.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976532</data>
  <data key="d6"></data>
</node>
<node id="Hoành độ đầu mút phải">
  <data key="d0">Hoành độ đầu mút phải</data>
  <data key="d1">technology</data>
  <data key="d2">Hoành độ đầu mút phải là tọa độ xác định thời điểm kết thúc của một công việc trên trục thời gian trong sơ đồ ngang.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976532</data>
  <data key="d6"></data>
</node>
<node id="Công việc găng cuối cùng">
  <data key="d0">Công việc găng cuối cùng</data>
  <data key="d1">technology</data>
  <data key="d2">Công việc găng cuối cùng là công việc trong đường găng có chỉ số sự kiện bắt đầu trùng với chỉ số sự kiện kết thúc của công việc găng trước đó.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976533</data>
  <data key="d6"></data>
</node>
<node id="Công việc găng khởi công">
  <data key="d0">Công việc găng khởi công</data>
  <data key="d1">technology</data>
  <data key="d2">Công việc găng khởi công là công việc đầu tiên trong đường găng, xác định mốc bắt đầu của chuỗi công việc quan trọng.</data>
  <data key="d3">chunk-67c7d25efa4daa2024ee8254a90c035a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976533</data>
  <data key="d6"></data>
</node>
<node id="Day Chuyen Nhip Boi">
  <data key="d0">Day Chuyen Nhip Boi</data>
  <data key="d1">event</data>
  <data key="d2">Day chuyen nhip boi là quy trình sản xuất với các tổ làm việc song song để rút ngắn thời gian hoàn thành.</data>
  <data key="d3">chunk-5cc08129c0475f04820792382b55d9ec</data>
