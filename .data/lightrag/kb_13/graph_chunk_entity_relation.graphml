  <data key="d0">Thời Hạn Pháp Lệnh</data>
  <data key="d1">regulation</data>
  <data key="d2">Thời Hạn Pháp Lệnh là khung thời gian bắt buộc được quy định bởi nghị định của Chính Phủ.</data>
  <data key="d3">chunk-7dfc32c6d93e918924c330bd1756b4bb</data>
