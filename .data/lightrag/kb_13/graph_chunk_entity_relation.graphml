<edge source="Công suất" target="Trình độ liên kết của doanh nghiệp">
  <data key="d7">1.0</data>
  <data key="d8">Trình độ liên kết (tự sản xuất hay thuê gia công) ảnh hưởng đến công suất và chiến lược sản xuất của doanh nghiệp.</data>
  <data key="d9">liên kết,sản xuất</data>
