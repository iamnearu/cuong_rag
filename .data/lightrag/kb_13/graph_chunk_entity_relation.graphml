  <data key="d0">Doanh nghiệp Hồng Kỳ</data>
  <data key="d1">organization</data>
  <data key="d2">Doanh nghiệp Hồng Kỳ là một tổ chức được đề cập trong văn bản liên quan đến việc quản lý chi phí và xử lý nợ.</data>
  <data key="d3">chunk-e68472a22f187668ba3f112861908093</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777952838</data>
  <data key="d6"></data>
</node>
<node id="Điều lệ Công ty">
  <data key="d0">Điều lệ Công ty</data>
  <data key="d1">regulation</data>
  <data key="d2">Điều lệ Công ty là văn bản quy định các điều khoản liên quan đến xử lý nợ và khả năng thanh toán của doanh nghiệp.</data>
  <data key="d3">chunk-e68472a22f187668ba3f112861908093</data>
