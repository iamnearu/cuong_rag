</node>
<node id="Các nhân tố kinh tế">
  <data key="d0">Các nhân tố kinh tế</data>
  <data key="d1">concept</data>
  <data key="d2">Các nhân tố kinh tế là yếu tố ảnh hưởng đến chọn vùng, được giới thiệu từ trang 45.</data>
  <data key="d3">chunk-bfb09dc2f0322ea84f0381a3d2cccb49</data>
