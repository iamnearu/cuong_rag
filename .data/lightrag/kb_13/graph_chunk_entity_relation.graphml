  <data key="d0">Thoi Gian Thi Cong</data>
  <data key="d1">other</data>
  <data key="d2">Thời gian thi công là khoảng thời gian cần thiết để hoàn thành công việc trên một phân đoạn.</data>
  <data key="d3">chunk-a2d3087324a924964d5e36cb3685fac2&lt;SEP&gt;chunk-36b285de1a52a52f3878c20eb0faefe9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976397</data>
  <data key="d6"></data>
</node>
<node id="SDM nut">
  <data key="d0">SDM nut</data>
  <data key="d1">technology</data>
  <data key="d2">SDM nut là phương pháp biểu diễn mạng lưới công việc với các mối quan hệ thuận và ngược.&lt;SEP&gt;SDM nut là sơ đồ mạng dùng để biểu diễn các công việc và mối liên hệ trong quản lý dự án.</data>
  <data key="d3">chunk-98db152b3cb6786ab239ab8929132f60&lt;SEP&gt;chunk-ac97e294a16844569462f4793dd90953</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976397</data>
  <data key="d6"></data>
</node>
<node id="PERT">
  <data key="d0">PERT</data>
  <data key="d1">technology</data>
  <data key="d2">PERT là một phương pháp thành phần của sơ đồ mạng, thường áp dụng cho các dự án phức tạp.&lt;SEP&gt;PERT là kỹ thuật sơ đồ mạng phân tích các công việc trong dự án, tập trung vào ước tính thời gian.&lt;SEP&gt;PERT (Program Evaluation and Review Technique) là một công nghệ quản lý dự án sử dụng phân bố xác suất để ước lượng thời gian và độ không xác định.&lt;SEP&gt;PERT là phương pháp xác định thời gian thực hiện dự án với độ lệch chuẩn và phương sai.</data>
  <data key="d3">chunk-98db152b3cb6786ab239ab8929132f60&lt;SEP&gt;chunk-9dc67b026b12736b71554be633ad8aa0&lt;SEP&gt;chunk-41aa67409eec056abddf79c9a9587c71&lt;SEP&gt;chunk-7d992ec49472ba6a7d5bdd58991bcf26</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976398</data>
  <data key="d6"></data>
</node>
<node id="vietcons.org">
  <data key="d0">vietcons.org</data>
  <data key="d1">organization</data>
  <data key="d2">vietcons.org là một trang web được đề cập trong văn bản, có thể liên quan đến việc thể hiện kết quả trên biểu đồ Gantt.</data>
  <data key="d3">chunk-98db152b3cb6786ab239ab8929132f60</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976399</data>
  <data key="d6"></data>
</node>
<node id="Thời hạn hoàn thành các công việc (t;)">
  <data key="d0">Thời hạn hoàn thành các công việc (t;)</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời hạn hoàn thành các công việc (t;) là thông số quan trọng trong SDM, xác định thời gian dự kiến để thực hiện từng công việc.</data>
  <data key="d3">chunk-98db152b3cb6786ab239ab8929132f60</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976399</data>
  <data key="d6"></data>
</node>
<node id="Dự trữ công việc">
  <data key="d0">Dự trữ công việc</data>
  <data key="d1">other</data>
  <data key="d2">Dự trữ công việc là khái niệm đề cập đến sự linh hoạt trong lịch trình dự án, thường liên quan đến các công việc không có ràng buộc (z = 0).</data>
  <data key="d3">chunk-98db152b3cb6786ab239ab8929132f60</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976399</data>
  <data key="d6"></data>
</node>
<node id="Mối liên hệ S.S">
  <data key="d0">Mối liên hệ S.S</data>
  <data key="d1">other</data>
  <data key="d2">Mối liên hệ S.S (Start-to-Start) là loại mối quan hệ giữa các công việc, yêu cầu công việc sau chỉ bắt đầu sau khi công việc trước bắt đầu.</data>
  <data key="d3">chunk-98db152b3cb6786ab239ab8929132f60</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976400</data>
  <data key="d6"></data>
</node>
<node id="VIETCONS">
  <data key="d0">VIETCONS</data>
  <data key="d1">organization</data>
  <data key="d2">VIETCONS là một trung tâm đào tạo xây dựng chuyên cung cấp kiến thức, phương pháp tổ chức thi công hiệu quả, cũng như thông tin về thiết kế kỹ thuật và thiết kế thi công. Tổ chức này tập trung vào việc đào tạo chuyên sâu trong lĩnh vực xây dựng cơ bản, bao gồm các khóa học và tài liệu liên quan đến lập tiến độ thi công. Một đặc điểm nổi bật của VIETCONS là thường sử dụng sơ đồ ngang (bar chart) để thể hiện tiến độ công trình, giúp người học dễ dàng hình dung và quản lý các giai đoạn thi công.  

Ngoài ra, VIETCONS được biết đến qua địa chỉ website chính thức http://www.vietcons.org, nơi cung cấp thêm nguồn thông tin và tài nguyên liên quan đến công nghệ xây dựng. Tổ chức này cũng đề cập đến các khái niệm như "khoảng cách kỹ thuật trong công nghệ", có thể liên quan đến các yếu tố kỹ thuật cần cân nhắc trong quy trình thiết kế và thi công. Với vai trò là một đơn vị đào tạo uy tín, VIETCONS đóng góp vào việc nâng cao năng lực chuyên môn cho ngành xây dựng thông qua các chương trình đào tạo đa dạng và ứng dụng công nghệ hiện đại.</data>
  <data key="d3">chunk-ecbdfa3c1772644d76b9e36672a7a5e6&lt;SEP&gt;chunk-e39fcaaef27cd718993c01ad2659763f&lt;SEP&gt;chunk-4b5e6bf7973851b5d8c78511f0d34f91&lt;SEP&gt;chunk-a256103ab2bd3aa8d7a59ad45d3b068c&lt;SEP&gt;chunk-381e682244bab77297ff628995d90b7d&lt;SEP&gt;chunk-d451d2038a98e4929b77d5130519747e&lt;SEP&gt;chunk-1ad2dd9e488bcaf61423e3ed4e6f9afe&lt;SEP&gt;chunk-5b849f30ebbea48035f3488b40b43009&lt;SEP&gt;chunk-e74b4b8c9283efc0c96875ba9dfbfa5d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976400</data>
  <data key="d6"></data>
</node>
<node id="KTCTC">
  <data key="d0">KTCTC</data>
  <data key="d1">organization</data>
  <data key="d2">KTCTC là tổ chức giải quyết các vấn đề kỹ thuật, tổ chức và kinh tế phục vụ xây dựng công trình.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976400</data>
  <data key="d6"></data>
</node>
<node id="Tổ chức xây lắp">
  <data key="d0">Tổ chức xây lắp</data>
  <data key="d1">organization</data>
  <data key="d2">Tổ chức xây lắp là đơn vị thực hiện các công việc thi công và quản lý dự án xây dựng.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976400</data>
  <data key="d6"></data>
</node>
<node id="Công trình xây dựng">
  <data key="d0">Công trình xây dựng</data>
  <data key="d1">product</data>
  <data key="d2">Công trình xây dựng là sản phẩm được hình thành thông qua quá trình thi công và quản lý tiến độ.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976401</data>
  <data key="d6"></data>
</node>
<node id="Tiến độ thi công">
  <data key="d0">Tiến độ thi công</data>
  <data key="d1">event</data>
  <data key="d2">Tiến độ thi công là kế hoạch sản xuất được biểu diễn bằng biểu đồ, bao gồm các chỉ tiêu kỹ thuật và kinh tế.&lt;SEP&gt;Tiến độ thi công là chỉ tiêu đánh giá thời gian thực hiện công trình, cần được điều chỉnh để phù hợp với thời hạn pháp lệnh.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37&lt;SEP&gt;chunk-ab7434271b1707c34ba0d8a269e732dd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976401</data>
  <data key="d6"></data>
</node>
<node id="Máy móc thiết bị">
  <data key="d0">Máy móc thiết bị</data>
  <data key="d1">product</data>
  <data key="d2">Máy móc thiết bị là tài nguyên vật chất kỹ thuật được sử dụng trong thi công công trình.&lt;SEP&gt;Máy móc thiết bị là tài nguyên thuộc nhóm tài nguyên thu hồi được, được sử dụng trong sản xuất và thi công.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37&lt;SEP&gt;chunk-989708467defda0402473215b791ff35&lt;SEP&gt;chunk-f84d7c1bcd4c33020b90f92ca0e20cfd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976401</data>
  <data key="d6"></data>
</node>
<node id="Biểu đồ tiến độ">
  <data key="d0">Biểu đồ tiến độ</data>
  <data key="d1">product</data>
  <data key="d2">Biểu đồ tiến độ là công cụ trực quan thể hiện kế hoạch thi công dưới dạng đường ngang, mạng hoặc biểu đồ khác.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976402</data>
  <data key="d6"></data>
</node>
<node id="Đơn vị xây lắp">
  <data key="d0">Đơn vị xây lắp</data>
  <data key="d1">organization</data>
  <data key="d2">Đơn vị xây lắp là tổ chức chịu trách nhiệm thi công và quản lý tiến độ công trình.&lt;SEP&gt;Đơn vị xây lắp là tổ chức chịu trách nhiệm tổ chức và thực hiện các dây chuyền sản xuất trong công trình xây dựng.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37&lt;SEP&gt;chunk-fa597bd7f5bbfa1d5b1aa9a226e8f21e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976402</data>
  <data key="d6"></data>
</node>
<node id="Nhà thầu">
  <data key="d0">Nhà thầu</data>
  <data key="d1">organization</data>
  <data key="d2">Nhà thầu là tổ chức tham gia thực hiện các hợp đồng thi công công trình.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976402</data>
  <data key="d6"></data>
</node>
<node id="Doanh nghiệp cung ứng máy móc thiết bị">
  <data key="d0">Doanh nghiệp cung ứng máy móc thiết bị</data>
  <data key="d1">organization</data>
  <data key="d2">Doanh nghiệp cung ứng máy móc thiết bị là tổ chức cung cấp thiết bị cần thiết cho thi công.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976402</data>
  <data key="d6"></data>
</node>
<node id="Chỉ tiêu kinh tế kỹ thuật">
  <data key="d0">Chỉ tiêu kinh tế kỹ thuật</data>
  <data key="d1">regulation</data>
  <data key="d2">Chỉ tiêu kinh tế kỹ thuật là các quy định về mục tiêu chi phí, thời gian và chất lượng trong xây dựng.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976402</data>
  <data key="d6"></data>
</node>
<node id="Giảm giá thành">
  <data key="d0">Giảm giá thành</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Giảm giá thành là mục tiêu kinh tế nhằm tối ưu hóa chi phí trong quá trình thi công.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976403</data>
  <data key="d6"></data>
</node>
<node id="Tiết kiệm thời gian">
  <data key="d0">Tiết kiệm thời gian</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tiết kiệm thời gian là chỉ tiêu hiệu quả nhằm rút ngắn tiến độ thi công công trình.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976403</data>
  <data key="d6"></data>
</node>
<node id="Hợp đồng cung cấp máy móc, thiết bị">
  <data key="d0">Hợp đồng cung cấp máy móc, thiết bị</data>
  <data key="d1">event</data>
  <data key="d2">Hợp đồng cung cấp máy móc, thiết bị là một phần của kế hoạch tiến độ thi công, bao gồm việc chuẩn bị và thực hiện các hợp đồng liên quan đến thiết bị.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976403</data>
  <data key="d6"></data>
</node>
<node id="Người thiết kế">
  <data key="d0">Người thiết kế</data>
  <data key="d1">person</data>
  <data key="d2">Người thiết kế là cá nhân tham gia vào quá trình lập kế hoạch và thiết kế công trình xây dựng.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976403</data>
  <data key="d6"></data>
</node>
<node id="Hồ sơ tài liệu phục vụ thi công">
  <data key="d0">Hồ sơ tài liệu phục vụ thi công</data>
  <data key="d1">product</data>
  <data key="d2">Hồ sơ tài liệu phục vụ thi công là tập hợp các tài liệu kỹ thuật và hồ sơ cần thiết để triển khai thi công công trình.</data>
  <data key="d3">chunk-c81aa41748d23e4edb2ff86c411d4d37</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976403</data>
  <data key="d6"></data>
</node>
<node id="Tuyến Công Tác">
  <data key="d0">Tuyến Công Tác</data>
  <data key="d1">concept</data>
  <data key="d2">Tuyến công tác là khái niệm liên quan đến lộ trình hoặc phương pháp triển khai công việc trong xây dựng.&lt;SEP&gt;Tuyến công tác là lộ trình hoặc khu vực cụ thể được phân bổ cho công việc thi công.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78&lt;SEP&gt;chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976403</data>
  <data key="d6"></data>
</node>
<node id="Công Việc">
  <data key="d0">Công Việc</data>
  <data key="d1">concept</data>
  <data key="d2">Công việc là nhiệm vụ cụ thể cần thực hiện, có khối lượng lao động và thời gian thi công.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976404</data>
  <data key="d6"></data>
</node>
<node id="Máy Biến Chế">
  <data key="d0">Máy Biến Chế</data>
  <data key="d1">product</data>
  <data key="d2">Máy biến chế là thiết bị hoặc nhóm thiết bị được sử dụng để hoàn thành công việc trong điều kiện tối ưu.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976404</data>
  <data key="d6"></data>
</node>
<node id="Thời Gian Thi Công">
  <data key="d0">Thời Gian Thi Công</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời gian thi công là chỉ tiêu đo lường khoảng thời gian cần thiết để hoàn thành một công việc.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976404</data>
  <data key="d6"></data>
</node>
<node id="Khối Lượng Lao Động">
  <data key="d0">Khối Lượng Lao Động</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Khối lượng lao động là tổng số ngày công cần thiết để hoàn thành công việc.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976404</data>
  <data key="d6"></data>
</node>
<node id="Số Ca Làm Việc">
  <data key="d0">Số Ca Làm Việc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Số ca làm việc là số lượng ca (1, 2, 3) được áp dụng trong ngày để điều chỉnh tiến độ thi công.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976404</data>
  <data key="d6"></data>
</node>
<node id="Chế Độ Làm Việc">
  <data key="d0">Chế Độ Làm Việc</data>
  <data key="d1">concept</data>
  <data key="d2">Chế độ làm việc là mô hình phân bổ ca làm việc (1, 2, 3 ca/ngày) ảnh hưởng đến thời gian thi công.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976405</data>
  <data key="d6"></data>
</node>
<node id="Định Mức Kỹ Thuật">
  <data key="d0">Định Mức Kỹ Thuật</data>
  <data key="d1">regulation</data>
  <data key="d2">Định mức kỹ thuật là tiêu chuẩn quy định số lượng công nhân tối thiểu trong tổ sản xuất cơ bản.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976405</data>
  <data key="d6"></data>
</node>
<node id="Tổ Sản Xuất Cơ Bản">
  <data key="d0">Tổ Sản Xuất Cơ Bản</data>
  <data key="d1">organization</data>
  <data key="d2">Tổ sản xuất cơ bản là đơn vị sản xuất tối ưu với số lượng công nhân ít nhất đảm bảo năng suất và chất lượng.&lt;SEP&gt;Tổ sản xuất cơ bản là đơn vị thực hiện công việc xây dựng với biên chế tối thiểu.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78&lt;SEP&gt;chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976405</data>
  <data key="d6"></data>
</node>
<node id="Bảng 2.1">
  <data key="d0">Bảng 2.1</data>
  <data key="d1">product</data>
  <data key="d2">Bảng 2.1 là bảng dữ liệu thể hiện mối quan hệ giữa số công nhân (N) và thời gian thi công (t) theo các mức sản xuất cơ bản (b).</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976405</data>
  <data key="d6"></data>
</node>
<node id="Tmin">
  <data key="d0">Tmin</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tmin là thời gian thi công ngắn nhất, đạt 3 ngày khi sử dụng tối đa khả năng triển khai công việc.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976405</data>
  <data key="d6"></data>
</node>
<node id="Tmax">
  <data key="d0">Tmax</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tmax là thời gian thi công dài nhất, đạt 24 ngày khi bố trí lực lượng thi công tối thiểu.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976406</data>
  <data key="d6"></data>
</node>
<node id="Ví Dụ Công Việc 120 Ngày Công">
  <data key="d0">Ví Dụ Công Việc 120 Ngày Công</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Ví dụ công việc có khối lượng lao động 120 ngày công và tổ sản xuất cơ bản 5 người.</data>
  <data key="d3">chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976406</data>
  <data key="d6"></data>
</node>
<node id="Bảng 5.2">
  <data key="d0">Bảng 5.2</data>
  <data key="d1">product</data>
  <data key="d2">Bảng 5.2 là bảng ghi kết quả tính toán thời gian trung bình mong muốn và độ lệch chuẩn của các công việc.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976406</data>
  <data key="d6"></data>
</node>
<node id="Độ lệch chuẩn">
  <data key="d0">Độ lệch chuẩn</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Độ lệch chuẩn là chỉ số đo mức độ không xác định của giá trị ước lượng.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976407</data>
  <data key="d6"></data>
</node>
<node id="Thời gian trung bình mong muốn">
  <data key="d0">Thời gian trung bình mong muốn</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời gian trung bình mong muốn là giá trị kỳ vọng của thời gian hoàn thành dự án.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976407</data>
  <data key="d6"></data>
</node>
<node id="Công trình">
  <data key="d0">Công trình</data>
  <data key="d1">event</data>
  <data key="d2">Công trình là ví dụ về dự án xây dựng được sử dụng để minh họa phương pháp PERT.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976407</data>
  <data key="d6"></data>
</node>
<node id="Công thức 5.16">
  <data key="d0">Công thức 5.16</data>
  <data key="d1">product</data>
  <data key="d2">Công thức 5.16 là phương pháp tính thời gian trung bình mong muốn của các công việc trong dự án.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976408</data>
  <data key="d6"></data>
</node>
<node id="Công thức 5.17">
  <data key="d0">Công thức 5.17</data>
  <data key="d1">product</data>
  <data key="d2">Công thức 5.17 là phương pháp tính độ lệch chuẩn của thời gian thực hiện dự án.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976408</data>
  <data key="d6"></data>
</node>
<node id="Công thức 5.18">
  <data key="d0">Công thức 5.18</data>
  <data key="d1">product</data>
  <data key="d2">Công thức 5.18 là phương pháp tính phương sai của thời gian thực hiện dự án.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976408</data>
  <data key="d6"></data>
</node>
<node id="Phương sai">
  <data key="d0">Phương sai</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Phương sai là chỉ số đo mức độ phân tán của thời gian thực hiện dự án trong phương pháp PERT.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976408</data>
  <data key="d6"></data>
</node>
<node id="Xác suất phân phối chuẩn tiêu chuẩn">
  <data key="d0">Xác suất phân phối chuẩn tiêu chuẩn</data>
  <data key="d1">concept</data>
  <data key="d2">Xác suất phân phối chuẩn tiêu chuẩn là khái niệm mô tả xác suất tích lũy trong bảng phân phối chuẩn tiêu chuẩn.</data>
  <data key="d3">chunk-9dc67b026b12736b71554be633ad8aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976408</data>
  <data key="d6"></data>
</node>
<node id="Thiết Kế Công Nghệ">
  <data key="d0">Thiết Kế Công Nghệ</data>
  <data key="d1">technology</data>
  <data key="d2">Thiết kế công nghệ là quá trình phân tích và lựa chọn công nghệ phù hợp để thực hiện các quy trình xây lắp.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976409</data>
  <data key="d6"></data>
</node>
<node id="Kiến Trúc">
  <data key="d0">Kiến Trúc</data>
  <data key="d1">technology</data>
  <data key="d2">Kiến trúc là yếu tố cấu thành trong thiết kế công trình, ảnh hưởng đến khả năng thi công.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976409</data>
  <data key="d6"></data>
</node>
<node id="Kết Cấu">
  <data key="d0">Kết Cấu</data>
  <data key="d1">technology</data>
  <data key="d2">Kết cấu là hệ thống chịu lực và phân bố tải trọng trong công trình xây dựng.&lt;SEP&gt;Kết cấu là phần cấu trúc chịu lực của công trình, được phân tích trong thiết kế công nghệ.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d&lt;SEP&gt;chunk-7843884acf20ab6d52ebe622e4488572</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976409</data>
  <data key="d6"></data>
</node>
<node id="Vật Liệu">
  <data key="d0">Vật Liệu</data>
  <data key="d1">product</data>
  <data key="d2">Vật liệu là nguyên vật liệu được sử dụng trong quá trình xây dựng.&lt;SEP&gt;Vật liệu là tài nguyên không thu hồi, khối lượng biến đổi theo khối lượng công việc hoàn thành.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d&lt;SEP&gt;chunk-e952aa25871b0d856d24966fd31c7cc4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976409</data>
  <data key="d6"></data>
</node>
<node id="Danh Mục Công Việc Xây Lắp">
  <data key="d0">Danh Mục Công Việc Xây Lắp</data>
  <data key="d1">event</data>
  <data key="d2">Danh mục công việc xây lắp là tập hợp các công việc được phân chia để lập tiến độ thi công.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976409</data>
  <data key="d6"></data>
</node>
<node id="Khối Lượng Công Việc">
  <data key="d0">Khối Lượng Công Việc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Khối lượng công việc là số liệu đo lường lượng công việc cần thực hiện, tính theo đơn vị đo lường hoặc tiền tệ.&lt;SEP&gt;Khối lượng công việc là chỉ tiêu đo lường quy mô công tác cần hoàn thành.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d&lt;SEP&gt;chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976409</data>
  <data key="d6"></data>
</node>
<node id="Biện Pháp Kỹ Thuật Thi Công">
  <data key="d0">Biện Pháp Kỹ Thuật Thi Công</data>
  <data key="d1">technology</data>
  <data key="d2">Biện pháp kỹ thuật thi công là phương án lựa chọn để thực hiện công việc xây lắp hiệu quả.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976410</data>
  <data key="d6"></data>
</node>
<node id="Đơn Vị Đo Lường">
  <data key="d0">Đơn Vị Đo Lường</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Đơn vị đo lường là các đơn vị như mét, tấn, cái... dùng để xác định khối lượng công việc.&lt;SEP&gt;Đơn vị đo lường là tiêu chí xác định khối lượng công việc.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d&lt;SEP&gt;chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976410</data>
  <data key="d6"></data>
</node>
<node id="Người Cấp Vốn">
  <data key="d0">Người Cấp Vốn</data>
  <data key="d1">organization</data>
  <data key="d2">Người cấp vốn là bên cung cấp nguồn tài chính cho dự án xây dựng.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976410</data>
  <data key="d6"></data>
</node>
<node id="Đơn Vị Thực Hiện">
  <data key="d0">Đơn Vị Thực Hiện</data>
  <data key="d1">organization</data>
  <data key="d2">Đơn vị thực hiện là tổ chức phụ trách thi công công trình.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976410</data>
  <data key="d6"></data>
</node>
<node id="Aex">
  <data key="d0">Aex</data>
  <data key="d1">person</data>
  <data key="d2">Aex là cá nhân liên quan đến thiết kế công trình và ý kiến về vật liệu địa phương/nhập khẩu.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976410</data>
  <data key="d6"></data>
</node>
<node id="Giải Pháp Móng">
  <data key="d0">Giải Pháp Móng</data>
  <data key="d1">technology</data>
  <data key="d2">Giải pháp móng là phương án kỹ thuật để xây dựng nền móng công trình.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976411</data>
  <data key="d6"></data>
</node>
<node id="Kết Cấu Chịu Lực">
  <data key="d0">Kết Cấu Chịu Lực</data>
  <data key="d1">technology</data>
  <data key="d2">Kết cấu chịu lực là hệ thống cấu trúc đảm bảo độ bền và an toàn cho công trình.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976411</data>
  <data key="d6"></data>
</node>
<node id="Trang Bị Nội Thất">
  <data key="d0">Trang Bị Nội Thất</data>
  <data key="d1">product</data>
  <data key="d2">Trang bị nội thất là các thiết bị bên trong công trình được đưa vào danh mục công việc.</data>
  <data key="d3">chunk-831c4ffba8446d20c4f121430328e14d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976411</data>
  <data key="d6"></data>
</node>
<node id="Công Nghệ Thi Công">
  <data key="d0">Công Nghệ Thi Công</data>
  <data key="d1">technology</data>
  <data key="d2">Công nghệ thi công là yếu tố cơ bản ảnh hưởng đến tiến độ và hiệu quả của dự án xây dựng.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976411</data>
  <data key="d6"></data>
</node>
<node id="Năng Suất Máy Móc">
  <data key="d0">Năng Suất Máy Móc</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Năng suất máy móc là hiệu quả hoạt động của thiết bị kỹ thuật trong một ca làm việc.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976412</data>
  <data key="d6"></data>
</node>
<node id="Biến Chế Tối Ưu">
  <data key="d0">Biến Chế Tối Ưu</data>
  <data key="d1">other</data>
  <data key="d2">Biến chế tối ưu là phương pháp phân bổ nhân lực và máy móc hợp lý để đạt hiệu quả cao nhất.</data>
  <data key="d3">chunk-dd557c9a50d4cf78e816b5b2063e76b7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976412</data>
