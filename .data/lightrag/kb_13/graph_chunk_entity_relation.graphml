  <data key="d0">Tang Ca Lam Viec</data>
  <data key="d1">technology</data>
  <data key="d2">Tang Ca Lam Viec là phương pháp rút ngắn Duong Gang bằng cách tăng ca làm việc, đảm bảo điều kiện lao động bình thường.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976435</data>
