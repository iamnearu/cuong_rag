  <data key="d6"></data>
</node>
<node id="Phó tổng Giám đốc kinh doanh">
  <data key="d0">Phó tổng Giám đốc kinh doanh</data>
  <data key="d1">person</data>
  <data key="d2">Phó tổng Giám đốc kinh doanh tham gia vào việc đàm phán và ký kết hợp đồng mua hàng.</data>
  <data key="d3">chunk-bb90a9b9b789fd958eadc14360927bae</data>
