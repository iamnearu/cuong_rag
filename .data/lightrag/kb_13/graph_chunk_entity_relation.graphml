  <data key="d1">event</data>
  <data key="d2">Dieu Chinh SDM Ve Thoi Gian Nhan Luc là quá trình điều chỉnh sơ đồ mạng để đáp ứng tiêu chuẩn thời gian và tối ưu phân bổ nhân lực.</data>
  <data key="d3">chunk-36b285de1a52a52f3878c20eb0faefe9</data>
