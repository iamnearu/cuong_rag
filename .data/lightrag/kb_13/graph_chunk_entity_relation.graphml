  <data key="d0">Bước 1: Xác định các công việc cần thực hiện</data>
  <data key="d1">technology</data>
  <data key="d2">Bước 1 trong phương pháp cân bằng dây chuyền yêu cầu liệt kê đầy đủ các công việc cần thiết để sản xuất sản phẩm.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972747</data>
  <data key="d6"></data>
</node>
