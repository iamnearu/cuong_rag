  <data key="d6"></data>
</node>
<node id="Lap bieu nhu cau tai nguyen">
  <data key="d0">Lap bieu nhu cau tai nguyen</data>
  <data key="d1">event</data>
  <data key="d2">Lập biểu nhu cầu tài nguyên là bước thứ mười hai, xác định nhu cầu tài nguyên cho từng giai đoạn.</data>
  <data key="d3">chunk-ecbdfa3c1772644d76b9e36672a7a5e6</data>
