  <data key="d0">Su kien kh?i cong</data>
  <data key="d1">event</data>
  <data key="d2">Su kien kh?i cong là sự kiện đánh dấu thời điểm bắt đầu của các công việc trong lịch trình dự án.</data>
  <data key="d3">chunk-759b382482eecf9fe3d181ae21a2fd6a</data>
