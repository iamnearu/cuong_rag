</node>
<node id="Foture 500">
  <data key="d0">Foture 500</data>
  <data key="d1">organization</data>
  <data key="d2">Foture 500 là tạp chí xếp hạng 500 hãng hàng đầu thế giới, trong đó Walt Disney đứng thứ 54 vào năm 2007.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
