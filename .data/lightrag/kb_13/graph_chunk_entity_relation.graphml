  <data key="d13"></data>
</edge>
<edge source="Công suất" target="Dự báo dài hạn và ngắn hạn">
  <data key="d7">1.0</data>
  <data key="d8">Dự báo dài hạn và ngắn hạn là công cụ hỗ trợ hoạch định công suất, kết hợp để tối ưu hóa mục tiêu sản xuất.</data>
  <data key="d9">chiến lược,dự báo</data>
