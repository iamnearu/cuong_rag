</node>
<node id="Phương pháp trực quan thử đúng sai">
  <data key="d0">Phương pháp trực quan thử đúng sai</data>
  <data key="d1">technology</data>
  <data key="d2">Phương pháp trực quan thử đúng sai là kỹ thuật được áp dụng phổ biến trong cân bằng dây chuyền nhờ tính đơn giản, dù không đảm bảo giải pháp tối ưu.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972746</data>
  <data key="d6"></data>
</node>
<node id="Thời gian chu kỳ (TCK)">
  <data key="d0">Thời gian chu kỳ (TCK)</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Thời gian chu kỳ (TCK) là tổng thời gian tối đa để thực hiện các công việc tại mỗi nơi làm việc, được xác định dựa trên nhu cầu sản xuất và thời gian làm việc theo quy định.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972746</data>
  <data key="d6"></data>
</node>
<node id="Số nơi làm việc tối thiểu">
  <data key="d0">Số nơi làm việc tối thiểu</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Số nơi làm việc tối thiểu là giá trị lý thuyết nhỏ nhất cần thiết để thực hiện các công việc, được tính toán từ tổng thời gian công việc và thời gian chu kỳ.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972746</data>
  <data key="d6"></data>
</node>
