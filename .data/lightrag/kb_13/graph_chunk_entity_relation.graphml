  <data key="d1">person</data>
  <data key="d2">J.Heizer là tác giả cuốn sách Operation Management được sử dụng làm tài liệu tham khảo.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
