<node id="Chi phí thuê địa điểm">
  <data key="d0">Chi phí thuê địa điểm</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí thuê địa điểm là một nhân tố có trọng số 0,5 trong phương pháp đánh giá.&lt;SEP&gt;Chi phí thuê địa điểm là yếu tố có trọng số cao nhất (0,5) trong bảng so sánh, ảnh hưởng trực tiếp đến tổng điểm của các phương án.</data>
  <data key="d3">chunk-c99c82111b9bb59df3faac9155755ddb&lt;SEP&gt;chunk-d6c84ccaf4130d9e1851b6b797caf45e</data>
