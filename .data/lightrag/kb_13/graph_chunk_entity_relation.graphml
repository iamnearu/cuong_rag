  <data key="d5">1777972605</data>
  <data key="d6"></data>
</node>
<node id="Deming">
  <data key="d0">Deming</data>
  <data key="d1">person</data>
  <data key="d2">Deming là chuyên gia về chất lượng đã phát triển mô hình JIT ở Bắc Mỹ.</data>
