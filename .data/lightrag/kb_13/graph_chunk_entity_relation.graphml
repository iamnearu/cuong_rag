  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí khấu hao TSCĐ là khoản phân bổ giá trị tài sản cố định, ổn định ở mức 26,160,546 trong cả hai giai đoạn.</data>
  <data key="d3">chunk-59409cbba6bae8aaca8d90d40c24b561</data>
