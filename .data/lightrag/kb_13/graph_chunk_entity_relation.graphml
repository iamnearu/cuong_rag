</node>
<node id="Nơi làm việc 2">
  <data key="d0">Nơi làm việc 2</data>
  <data key="d1">location</data>
  <data key="d2">Nơi làm việc 2 là vị trí thứ hai trong dây chuyền lắp ráp, thực hiện Công việc C.</data>
  <data key="d3">chunk-2c3fcdeeba2d61d9e99ccec68bf9cc33</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972686</data>
  <data key="d6"></data>
</node>
<node id="Nơi làm việc 3">
  <data key="d0">Nơi làm việc 3</data>
  <data key="d1">location</data>
  <data key="d2">Nơi làm việc 3 là vị trí cuối cùng trong dây chuyền lắp ráp, thực hiện Công việc D.</data>
  <data key="d3">chunk-2c3fcdeeba2d61d9e99ccec68bf9cc33</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972686</data>
