<node id="Sơ đồ ngang">
  <data key="d0">Sơ đồ ngang</data>
  <data key="d1">product</data>
  <data key="d2">Sơ đồ ngang là biểu đồ dùng để thể hiện các thông số của SDM dưới dạng hình ảnh.&lt;SEP&gt;Sơ đồ ngang là dạng biểu diễn dự án bằng cách chuyển đổi từ SDM, sử dụng trục tọa độ để minh họa thời gian và thứ tự công việc.</data>
  <data key="d3">chunk-fd7552ebff5e023dce24f2886dd9c6af&lt;SEP&gt;chunk-67c7d25efa4daa2024ee8254a90c035a</data>
