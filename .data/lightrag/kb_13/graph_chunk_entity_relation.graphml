  <data key="d0">Bước 4</data>
  <data key="d1">event</data>
  <data key="d2">Bước 4 là xác định khối lượng công việc theo danh mục đã lập.&lt;SEP&gt;Bước 4 là bước xác định khối lượng công việc theo danh mục đã lập trong quá trình xây dựng SDM.</data>
  <data key="d3">chunk-ff1f9fcb44676bbf9b364d1f1182d15a&lt;SEP&gt;chunk-cdbc11a42bd74c5694abdf39012f6c10</data>
