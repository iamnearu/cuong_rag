</node>
<node id="Bao cao kinh te ky thuat">
  <data key="d0">Bao cao kinh te ky thuat</data>
  <data key="d1">product</data>
  <data key="d2">Bao cao kinh te ky thuat là tài liệu tổng hợp kết quả khảo sát kinh tế và kỹ thuật, đưa ra kết luận cuối cùng về dự án.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976596</data>
  <data key="d6"></data>
</node>
<node id="Dia ban xay dung">
  <data key="d0">Dia ban xay dung</data>
  <data key="d1">location</data>
  <data key="d2">Dia ban xay dung là khu vực địa lý được lựa chọn để triển khai công trình, bao gồm đặc điểm địa hình, khí hậu, dân cư.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976596</data>
  <data key="d6"></data>
</node>
<node id="Co so ha tang">
  <data key="d0">Co so ha tang</data>
  <data key="d1">product</data>
  <data key="d2">Co so ha tang là hệ thống hạ tầng sẵn có (giao thông, năng lượng, nước) tại khu vực xây dựng.</data>
  <data key="d3">chunk-c341818df1d2b92077343545b379ec71</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976596</data>
