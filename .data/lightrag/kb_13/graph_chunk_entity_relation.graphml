  <data key="d6"></data>
</node>
<node id="Công Nhân">
  <data key="d0">Công Nhân</data>
  <data key="d1">person</data>
  <data key="d2">Công nhân là những người trực tiếp thực hiện các công đoạn sản xuất và tuân thủ quy trình tiêu chuẩn.&lt;SEP&gt;Công nhân là lực lượng lao động trực tiếp thực hiện các công việc xây dựng và có nhu cầu về sinh hoạt, nhà ở.&lt;SEP&gt;Công nhân là người lao động trực tiếp tham gia thi công công việc.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740&lt;SEP&gt;chunk-e8ea7e2aedd5a155028975efcb4ae5cc&lt;SEP&gt;chunk-ad16701344a88f06dfca315f9bf24f78</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976379</data>
  <data key="d6"></data>
</node>
