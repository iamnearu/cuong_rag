  <data key="d5">1777976514</data>
  <data key="d6"></data>
</node>
<node id="Du trit doc lap Zg">
  <data key="d0">Du trit doc lap Zg</data>
  <data key="d1">other</data>
  <data key="d2">Du trit doc lap Zg là khoảng thời gian dự trữ độc lập của công việc ij, không liên quan đến các công việc phía sau.</data>
  <data key="d3">chunk-759b382482eecf9fe3d181ae21a2fd6a</data>
  <data key="d4">unknown_source</data>
