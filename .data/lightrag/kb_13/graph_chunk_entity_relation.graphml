  <data key="d11">unknown_source</data>
  <data key="d12">1777972896</data>
  <data key="d13"></data>
</edge>
<edge source="Công suất" target="Khâu nút cổ chai">
  <data key="d7">1.0</data>
  <data key="d8">Khâu nút cổ chai là yếu tố cần xem xét để tránh cản trở công suất và đảm bảo cân đối trong sản xuất.</data>
  <data key="d9">cân đối,cản trở</data>
