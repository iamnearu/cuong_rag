</node>
<node id="Moi lien he SS">
  <data key="d0">Moi lien he SS</data>
  <data key="d1">other</data>
  <data key="d2">Mối liên hệ SS (Start-Start) là mối quan hệ giữa thời điểm bắt đầu của hai công việc trong sơ đồ mạng.</data>
  <data key="d3">chunk-7f0dec4672a908afd3ec21ee07bb407b</data>
