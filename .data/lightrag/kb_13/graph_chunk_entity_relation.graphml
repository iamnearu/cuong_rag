</node>
<node id="Tien do chap nhan">
  <data key="d0">Tien do chap nhan</data>
  <data key="d1">event</data>
  <data key="d2">Tiến độ chấp nhận là bước thứ mười một, xác nhận tiến độ sau khi tối ưu.</data>
  <data key="d3">chunk-ecbdfa3c1772644d76b9e36672a7a5e6</data>
