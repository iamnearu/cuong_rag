<edge source="Công suất" target="Điểm hòa vốn">
  <data key="d7">1.0</data>
  <data key="d8">Công suất tối thiểu được xác định dựa trên điểm hòa vốn.</data>
  <data key="d9">ngưỡng,xác định</data>
