</node>
<node id="Phân Khu Hợp Lý">
  <data key="d0">Phân Khu Hợp Lý</data>
  <data key="d1">event</data>
  <data key="d2">Phân Khu Hợp Lý là việc chia mặt bằng sản xuất thành các khu vực phù hợp về kỹ thuật và tổ chức thi công.</data>
  <data key="d3">chunk-19a0700e360ded88a9c8cd3ad2ad6179</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976362</data>
