</node>
<node id="2007">
  <data key="d0">2007</data>
  <data key="d1">date</data>
  <data key="d2">2007 là năm Walt Disney đạt lợi nhuận 32 tỷ đô la và được xếp hạng trong các danh sách 500 hãng hàng đầu.</data>
  <data key="d3">chunk-77740a8a08812b2b6834fee6bff1c83d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972644</data>
  <data key="d6"></data>
</node>
<node id="Thẻ Kanban">
  <data key="d0">Thẻ Kanban</data>
  <data key="d1">product</data>
  <data key="d2">Thẻ Kanban là công cụ vật lý được dán vào thùng đựng chi tiết, dùng để truyền lệnh sản xuất hoặc chuyển nguyên vật liệu.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972645</data>
  <data key="d6"></data>
</node>
<node id="Toyota Production System (TPS)">
  <data key="d0">Toyota Production System (TPS)</data>
  <data key="d1">technology</data>
  <data key="d2">TPS là hệ thống sản xuất của Toyota, được triển khai từ những năm 1950 và nổi tiếng với hiệu quả của JustIn-Time (JIT).</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972645</data>
  <data key="d6"></data>
</node>
<node id="JustIn-Time (JIT)">
  <data key="d0">JustIn-Time (JIT)</data>
  <data key="d1">technology</data>
  <data key="d2">JIT là nguyên tắc sản xuất theo yêu cầu, chỉ sản xuất khi có nhu cầu thực tế, được áp dụng trong hệ thống Toyota.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972645</data>
  <data key="d6"></data>
</node>
<node id="James Womack">
  <data key="d0">James Womack</data>
  <data key="d1">person</data>
  <data key="d2">James Womack là tác giả sách "The Machine that Changed the World", góp phần phổ biến khái niệm sản xuất tinh gọn.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972645</data>
  <data key="d6"></data>
</node>
<node id="Mekong Capital">
  <data key="d0">Mekong Capital</data>
  <data key="d1">organization</data>
  <data key="d2">Mekong Capital là tổ chức đã công bố báo cáo năm 2004 về tỷ lệ doanh nghiệp Mỹ triển khai sản xuất tinh gọn.</data>
  <data key="d3">chunk-10b49ad58cc0927525c42710aff72228</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972645</data>
  <data key="d6"></data>
</node>
