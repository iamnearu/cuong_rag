  <data key="d0">Mặt hàng D</data>
  <data key="d1">product</data>
  <data key="d2">Mặt hàng D có giá bán 1 triệu đồng, chi phí biến đổi 0,6 triệu đồng và doanh thu tháng trước là 10 triệu đồng.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972723</data>
  <data key="d6"></data>
</node>
<node id="Mặt hàng E">
  <data key="d0">Mặt hàng E</data>
  <data key="d1">product</data>
  <data key="d2">Mặt hàng E có giá bán 2 triệu đồng, chi phí biến đổi 1,6 triệu đồng và doanh thu tháng trước là 20 triệu đồng.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972723</data>
  <data key="d6"></data>
</node>
<node id="Chi phí cố định hàng năm">
  <data key="d0">Chi phí cố định hàng năm</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí cố định hàng năm là 1000$ (trong ví dụ 3) hoặc 20 triệu đồng hàng tháng (trong ví dụ 4) của doanh nghiệp.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972724</data>
  <data key="d6"></data>
</node>
<node id="Chi phí biến đổi">
  <data key="d0">Chi phí biến đổi</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chi phí biến đổi là khoản chi phí thay đổi theo mức công suất sản xuất, ví dụ 2$ cho sản phẩm A hoặc 1,6 triệu đồng cho mặt hàng B.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972724</data>
  <data key="d6"></data>
</node>
<node id="Tổng chi phí">
  <data key="d0">Tổng chi phí</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tổng chi phí (TC) là tổng của chi phí cố định và chi phí biến đổi.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972724</data>
  <data key="d6"></data>
</node>
<node id="Tổng doanh thu">
  <data key="d0">Tổng doanh thu</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Tổng doanh thu (TR) là doanh thu từ việc bán sản phẩm, được tính bằng khối lượng sản xuất nhân với giá bán.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972724</data>
  <data key="d6"></data>
</node>
<node id="Phân tích hòa vốn">
  <data key="d0">Phân tích hòa vốn</data>
  <data key="d1">method</data>
  <data key="d2">Phân tích hòa vốn là phương pháp xác định điểm hòa vốn để hỗ trợ quyết định công suất sản xuất.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972724</data>
  <data key="d6"></data>
</node>
<node id="Sản phẩm A">
  <data key="d0">Sản phẩm A</data>
  <data key="d1">product</data>
  <data key="d2">Sản phẩm A có chi phí cố định 1000$/năm, chi phí biến đổi 2$/đơn vị và giá bán 4$.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972725</data>
  <data key="d6"></data>
</node>
<node id="Khối lượng sản xuất">
  <data key="d0">Khối lượng sản xuất</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Khối lượng sản xuất (Q) là số lượng sản phẩm được sản xuất, ảnh hưởng đến tổng chi phí và doanh thu.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972725</data>
  <data key="d6"></data>
</node>
<node id="Giá bán">
  <data key="d0">Giá bán</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Giá bán (P) là giá của mỗi đơn vị sản phẩm, ảnh hưởng trực tiếp đến tổng doanh thu.</data>
  <data key="d3">chunk-2078e1538c4497ce67ec3d90b608a961</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972725</data>
  <data key="d6"></data>
</node>
<node id="Lực lượng lao động">
  <data key="d0">Lực lượng lao động</data>
  <data key="d1">other</data>
  <data key="d2">Lực lượng lao động có trình độ tay nghề, tổ chức và ý thức kỷ luật ảnh hưởng lớn đến công suất và hiệu quả sử dụng nguồn lực sản xuất.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972725</data>
  <data key="d6"></data>
</node>
<node id="Nhà xưởng">
  <data key="d0">Nhà xưởng</data>
  <data key="d1">location</data>
  <data key="d2">Nhà xưởng với diện tích mặt bằng và bố trí hạ tầng là yếu tố giới hạn hoặc hỗ trợ công suất sản xuất của doanh nghiệp.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972725</data>
  <data key="d6"></data>
</node>
<node id="Trình độ liên kết của doanh nghiệp">
  <data key="d0">Trình độ liên kết của doanh nghiệp</data>
  <data key="d1">other</data>
  <data key="d2">Trình độ liên kết của doanh nghiệp (tự sản xuất hay thuê gia công) ảnh hưởng đến công suất và chiến lược sản xuất.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972726</data>
  <data key="d6"></data>
</node>
<node id="Hệ số sử dụng máy móc, thiết bị">
  <data key="d0">Hệ số sử dụng máy móc, thiết bị</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Hệ số sử dụng máy móc, thiết bị là nhân tố trực tiếp ảnh hưởng đến công suất lý thuyết của hệ thống sản xuất.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972726</data>
  <data key="d6"></data>
</node>
<node id="Tiêu chuẩn, quy định về sản phẩm">
  <data key="d0">Tiêu chuẩn, quy định về sản phẩm</data>
  <data key="d1">regulation</data>
  <data key="d2">Tiêu chuẩn và quy định về sản phẩm là yếu tố bên ngoài ảnh hưởng đến công suất và quy trình sản xuất.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972726</data>
  <data key="d6"></data>
</node>
<node id="Quy định của chính phủ về thời gian lao động">
  <data key="d0">Quy định của chính phủ về thời gian lao động</data>
  <data key="d1">regulation</data>
  <data key="d2">Quy định của chính phủ về thời gian lao động là yếu tố bên ngoài ảnh hưởng đến công suất và tổ chức sản xuất.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972726</data>
  <data key="d6"></data>
</node>
<node id="Tình hình thị trường và mức độ cạnh tranh">
  <data key="d0">Tình hình thị trường và mức độ cạnh tranh</data>
  <data key="d1">other</data>
  <data key="d2">Tình hình thị trường và mức độ cạnh tranh là yếu tố bên ngoài cần xem xét khi lựa chọn công suất.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972726</data>
  <data key="d6"></data>
</node>
<node id="Nguyên tắc an toàn lao động">
  <data key="d0">Nguyên tắc an toàn lao động</data>
  <data key="d1">regulation</data>
  <data key="d2">Nguyên tắc an toàn lao động là yếu tố bên ngoài ảnh hưởng đến công suất và tổ chức sản xuất của doanh nghiệp.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972727</data>
  <data key="d6"></data>
</node>
<node id="Phương án công suất">
  <data key="d0">Phương án công suất</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Phương án công suất là kế hoạch hoặc chiến lược xây dựng công suất, cần đảm bảo tính linh hoạt và tổng hợp để phù hợp với nhu cầu thị trường.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972727</data>
  <data key="d6"></data>
</node>
<node id="Tính linh hoạt của doanh nghiệp">
  <data key="d0">Tính linh hoạt của doanh nghiệp</data>
  <data key="d1">other</data>
  <data key="d2">Tính linh hoạt của doanh nghiệp là yêu cầu quan trọng khi hoạch định công suất, giúp đáp ứng nhu cầu trước mắt và tận dụng cơ hội kinh doanh.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972727</data>
  <data key="d6"></data>
</node>
<node id="Khâu nút cổ chai">
  <data key="d0">Khâu nút cổ chai</data>
  <data key="d1">other</data>
  <data key="d2">Khâu nút cổ chai là yếu tố cần tránh trong hoạch định công suất để đảm bảo sự cân đối giữa các khâu sản xuất.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972727</data>
  <data key="d6"></data>
</node>
<node id="Dự báo dài hạn và ngắn hạn">
  <data key="d0">Dự báo dài hạn và ngắn hạn</data>
  <data key="d1">other</data>
  <data key="d2">Dự báo dài hạn và ngắn hạn là phương pháp hỗ trợ lựa chọn công suất, kết hợp để cân bằng mục tiêu dài hạn và ngắn hạn.</data>
  <data key="d3">chunk-d5fd5135cc187da7bb85f42e5b08f64e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972727</data>
  <data key="d6"></data>
</node>
<node id="Bộ Kế Hoạch Và Đầu Tư Cục Phát Triển Doanh Nghiệp">
  <data key="d0">Bộ Kế Hoạch Và Đầu Tư Cục Phát Triển Doanh Nghiệp</data>
  <data key="d1">organization</data>
  <data key="d2">Bộ Kế Hoạch Và Đầu Tư Cục Phát Triển Doanh Nghiệp là cơ quan trực thuộc Bộ Kế Hoạch và Đầu Tư, chịu trách nhiệm về phát triển doanh nghiệp.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972728</data>
  <data key="d6"></data>
</node>
<node id="TS. Nguyễn Đình Trung">
  <data key="d0">TS. Nguyễn Đình Trung</data>
  <data key="d1">person</data>
  <data key="d2">TS. Nguyễn Đình Trung là tác giả biên soạn tài liệu đào tạo chuyên đề Quản Trị Sản Xuất cho các doanh nghiệp nhỏ và vừa.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972728</data>
  <data key="d6"></data>
</node>
<node id="Chuyên Đề Quản Trị Sản Xuất">
  <data key="d0">Chuyên Đề Quản Trị Sản Xuất</data>
  <data key="d1">product</data>
  <data key="d2">Chuyên Đề Quản Trị Sản Xuất là tài liệu đào tạo, bồi dưỡng nguồn nhân lực về quản trị sản xuất và tác nghiệp cho doanh nghiệp nhỏ và vừa.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972728</data>
  <data key="d6"></data>
</node>
<node id="Phân Tích Delphi">
  <data key="d0">Phân Tích Delphi</data>
  <data key="d1">technology</data>
  <data key="d2">Phân Tích Delphi là một phương pháp dự báo định tính được đề cập trong tài liệu.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972728</data>
  <data key="d6"></data>
</node>
<node id="Hoạch Định Xu Hướng">
  <data key="d0">Hoạch Định Xu Hướng</data>
  <data key="d1">technology</data>
  <data key="d2">Hoạch Định Xu Hướng là phương pháp dự báo định lượng dựa trên phân tích xu hướng.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972728</data>
  <data key="d6"></data>
</node>
<node id="Chỉ Số Mùa Vụ">
  <data key="d0">Chỉ Số Mùa Vụ</data>
  <data key="d1">technology</data>
  <data key="d2">Chỉ Số Mùa Vụ là công cụ dự báo nhu cầu sản xuất theo mùa vụ.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972729</data>
  <data key="d6"></data>
</node>
<node id="ChƣƠNG I. GIỚI THIỆU CHUNG VỀ QUẢN TRỊ SẢN XUẤT VÀ TÁC NGHIỆP">
  <data key="d0">ChƣƠNG I. GIỚI THIỆU CHUNG VỀ QUẢN TRỊ SẢN XUẤT VÀ TÁC NGHIỆP</data>
  <data key="d1">event</data>
  <data key="d2">ChƣƠNG I là chương đầu tiên của tài liệu, giới thiệu tổng quan về quản trị sản xuất và tác nghiệp.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972729</data>
  <data key="d6"></data>
</node>
<node id="THỰCCHẤTQUẢNTRỊSẢNXUẤTVÀTÁCNGHIỆP">
  <data key="d0">THỰCCHẤTQUẢNTRỊSẢNXUẤTVÀTÁCNGHIỆP</data>
  <data key="d1">event</data>
  <data key="d2">THỰCCHẤTQUẢNTRỊSẢNXUẤTVÀTÁCNGHIỆP là phần nội dung trong Chương I, trình bày bản chất của quản trị sản xuất và tác nghiệp.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972729</data>
  <data key="d6"></data>
</node>
<node id="XU HƢỚNG PHÁT TRIỂN CỦA QUẢN TRỊ SẢN XUẤT VÀ TÁC NGHIỆP">
  <data key="d0">XU HƢỚNG PHÁT TRIỂN CỦA QUẢN TRỊ SẢN XUẤT VÀ TÁC NGHIỆP</data>
  <data key="d1">event</data>
  <data key="d2">XU HƢỚNG PHÁT TRIỂN CỦA QUẢN TRỊ SẢN XUẤT VÀ TÁC NGHIỆP là phần nội dung trong Chương I, thảo luận về xu hướng phát triển của lĩnh vực này.</data>
  <data key="d3">chunk-2360ffd586bc66bc96a12e8d13064433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972729</data>
  <data key="d6"></data>
</node>
