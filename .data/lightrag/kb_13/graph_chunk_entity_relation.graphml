  <data key="d1">other</data>
  <data key="d2">Bộ phận tài chính là chức năng trong doanh nghiệp, đôi khi không cung cấp kịp thời đầu tư đổi mới công nghệ.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
