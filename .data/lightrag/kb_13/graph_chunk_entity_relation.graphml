  <data key="d0">Bảng Hiển Thị Trực Quan</data>
  <data key="d1">product</data>
  <data key="d2">Bảng hiển thị trực quan là công cụ dùng để truyền đạt thông tin về tiến độ và quy trình sản xuất.</data>
  <data key="d3">chunk-1c8bd5e150bf416461f710ccc4a81740</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972750</data>
