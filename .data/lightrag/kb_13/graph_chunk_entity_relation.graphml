<node id="Chức năng sản xuất">
  <data key="d0">Chức năng sản xuất</data>
  <data key="d1">other</data>
  <data key="d2">Chức năng sản xuất là một phần trong doanh nghiệp, có mâu thuẫn với chức năng marketing về mục tiêu thời gian, chất lượng và đa dạng sản phẩm.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972636</data>
  <data key="d6"></data>
</node>
<node id="Chỉ tiêu tài chính">
  <data key="d0">Chỉ tiêu tài chính</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Chỉ tiêu tài chính là mục tiêu doanh nghiệp đặt ra, đôi khi không được sản xuất đảm bảo do giới hạn công nghệ và chi phí.</data>
  <data key="d3">chunk-69a4d1ae2c0505ad7dcb67e3b5eaa439</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972636</data>
  <data key="d6"></data>
</node>
