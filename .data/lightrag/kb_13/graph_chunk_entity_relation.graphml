  <data key="d1">product</data>
  <data key="d2">Phương án doanh nghiệp công suất vừa, có giá trị mong đợi trung bình cao nhất (10,33 triệu đồng) theo tiêu chí May rủi ngang nhau.</data>
  <data key="d3">chunk-2edf35ad624ca51dfcca5e087d86aebe</data>
