  <data key="d0">12 tháng</data>
  <data key="d1">date</data>
  <data key="d2">12 tháng là khoảng thời gian được quy định cho việc thanh toán các khoản chi phí ngắn hạn.&lt;SEP&gt;12 tháng là khoảng thời gian được quy định để phân loại các khoản phải thu thành dài hạn.&lt;SEP&gt;12 tháng là thời hạn phân bổ cho các khoản chi phí dài hạn hoặc theo chu kỳ kinh doanh.</data>
  <data key="d3">chunk-00fe331f136c5a09db18cac7106d146e&lt;SEP&gt;chunk-05605dbdcd26b3a979579b62d63a05e1&lt;SEP&gt;chunk-cf3b4c2aa5a06956d2c171f7374a80e8</data>
