<node id="Fruit Snack">
  <data key="d0">Fruit Snack</data>
  <data key="d1">product</data>
  <data key="d2">Fruit Snack là sản phẩm hỗn hợp gồm nước, phẩm màu thực vật, thuốc bảo quản và đường glucose.</data>
  <data key="d3">chunk-6bea99e9885412b4fa119fbeecb686bb</data>
