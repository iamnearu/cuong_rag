<node id="K">
  <data key="d0">K</data>
  <data key="d1">financial_metric</data>
  <data key="d2">K là hệ số ổn định phản ánh mức độ biến động của biểu đồ nhân lực và ảnh hưởng đến giá trị vốn đầu tư.&lt;SEP&gt;K là nhịp của các dây chuyền sản xuất, được sử dụng trong công thức tính toán.</data>
  <data key="d3">chunk-b29022fe8b5f5d506ad3c3a30a6b4bcd&lt;SEP&gt;chunk-314045f67c39e6861fc5155d8bc7d622</data>
