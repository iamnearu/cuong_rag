  <data key="d0">Đơn Giá Áp Dụng</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Đơn giá áp dụng là mức giá được xác định để tính toán chi phí trong dự toán thiết kế.</data>
  <data key="d3">chunk-d451d2038a98e4929b77d5130519747e</data>
