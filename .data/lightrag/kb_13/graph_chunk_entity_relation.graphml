<node id="Tăng năng suất lao động">
  <data key="d0">Tăng năng suất lao động</data>
  <data key="d1">financial_metric</data>
  <data key="d2">Mục tiêu của sản xuất tinh gọn là cải thiện năng suất lao động của công nhân.</data>
