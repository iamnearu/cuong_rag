  <data key="d1">product</data>
  <data key="d2">Ma trận thể hiện dòng di chuyển là công cụ phân tích lưu lượng di chuyển giữa các bộ phận sản xuất.</data>
  <data key="d3">chunk-81bd6b8e40e365baf1ff2d069ba76edb</data>
