<node id="Dây chuyền phân tầng">
  <data key="d0">Dây chuyền phân tầng</data>
  <data key="d1">product</data>
  <data key="d2">Dây chuyền phân tầng là quy trình thi công chuyên môn hóa trong xây dựng nhà nhiều tầng, thường được tổ chức theo hướng ngang dưới lên.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976577</data>
  <data key="d6"></data>
</node>
<node id="Dây chuyền hoàn thiện">
  <data key="d0">Dây chuyền hoàn thiện</data>
  <data key="d1">product</data>
  <data key="d2">Dây chuyền hoàn thiện là quy trình thi công chuyên môn hóa tập trung vào các công đoạn hoàn thiện công trình, có hướng phát triển khác nhau tùy theo thiết kế.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976578</data>
  <data key="d6"></data>
</node>
<node id="Hình 3.41">
  <data key="d0">Hình 3.41</data>
  <data key="d1">product</data>
  <data key="d2">Hình 3.41 là sơ đồ minh họa hướng phát triển của dây chuyền phân tầng và hoàn thiện trong xây dựng.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976578</data>
  <data key="d6"></data>
</node>
<node id="Hình 3.42">
  <data key="d0">Hình 3.42</data>
  <data key="d1">product</data>
  <data key="d2">Hình 3.42 là sơ đồ thể hiện ảnh hưởng của hướng phát triển dây chuyền chuyên môn hóa đến thời hạn thi công.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976578</data>
  <data key="d6"></data>
</node>
<node id="Công thức 3.75">
  <data key="d0">Công thức 3.75</data>
  <data key="d1">technology</data>
  <data key="d2">Công thức 3.75 là phương pháp tính toán thời hạn thi công dựa trên số lượng dây chuyền thành phần và nhịp độ thi công.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976578</data>
  <data key="d6"></data>
</node>
<node id="Thiết kế dây chuyền công trình">
  <data key="d0">Thiết kế dây chuyền công trình</data>
  <data key="d1">event</data>
  <data key="d2">Thiết kế dây chuyền công trình là quá trình xác định số lượng dây chuyền chuyên môn hóa và hướng phát triển của chúng trong xây dựng.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976578</data>
  <data key="d6"></data>
</node>
<node id="Hướng phát triển dọc từ trên xuống">
  <data key="d0">Hướng phát triển dọc từ trên xuống</data>
  <data key="d1">technology</data>
  <data key="d2">Hướng phát triển dọc từ trên xuống là phương pháp thi công ưu tiên bảo vệ các khu vực đã hoàn thiện bằng mái che.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976579</data>
  <data key="d6"></data>
</node>
<node id="Hướng phát triển dọc từ dưới lên">
  <data key="d0">Hướng phát triển dọc từ dưới lên</data>
  <data key="d1">technology</data>
  <data key="d2">Hướng phát triển dọc từ dưới lên là phương pháp rút ngắn thời gian thi công nhưng không đảm bảo sạch sẽ cho khu vực đã hoàn thiện trước.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976579</data>
  <data key="d6"></data>
</node>
<node id="Hình 3.43a">
  <data key="d0">Hình 3.43a</data>
  <data key="d1">other</data>
  <data key="d2">Hình 3.43a là sơ đồ minh họa nguyên tắc thể hiện quy luật của dây chuyền công trình nhà nhiều tầng theo cách tổ chức thứ nhất.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777976579</data>
  <data key="d6"></data>
</node>
<node id="Hình 3.43b">
  <data key="d0">Hình 3.43b</data>
  <data key="d1">other</data>
  <data key="d2">Hình 3.43b là sơ đồ minh họa nguyên tắc thể hiện quy luật của dây chuyền công trình nhà nhiều tầng theo cách tổ chức thứ hai.</data>
  <data key="d3">chunk-c7e8bad252bbf58ce46990cabd5616e3</data>
