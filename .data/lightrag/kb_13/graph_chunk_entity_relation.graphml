</node>
<node id="Bên liên quan">
  <data key="d0">Bên liên quan</data>
  <data key="d1">organization</data>
  <data key="d2">Bên liên quan là các tổ chức hoặc cá nhân có khả năng ảnh hưởng hoặc bị ảnh hưởng bởi các quyết định tài chính của doanh nghiệp.</data>
