  <data key="d0">Lãng phí do chuyển sản phẩm</data>
  <data key="d1">other</data>
  <data key="d2">Lãng phí do chuyển sản phẩm xảy ra khi phải vệ sinh, thay khuôn, chuẩn bị nguyên vật liệu khác.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972607</data>
  <data key="d6"></data>
</node>
<node id="Thao tác thừa">
  <data key="d0">Thao tác thừa</data>
  <data key="d1">other</data>
  <data key="d2">Thao tác thừa là lãng phí do công nhân thực hiện các hoạt động không liên quan đến sản xuất.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1777972607</data>
  <data key="d6"></data>
</node>
<node id="Sửa sai">
  <data key="d0">Sửa sai</data>
  <data key="d1">other</data>
  <data key="d2">Sửa sai là lãng phí khi phải gia công lại sản phẩm do lỗi ban đầu.</data>
  <data key="d3">chunk-463f03b25fc49c95a4abf4400126a5e3</data>
